<!-- ==========================================
     PAGE LOADER
========================================== -->

<link rel="stylesheet" href="/css/loader.css" />
<script src="/js/loader.js" defer></script>

<div id="vm-page-loader" role="status" aria-label="Loading VisaMaster">
  <div class="vm-loader-simple">
    <div class="vm-spinner"></div>
    <p class="vm-loader-text">Visa<span>Master</span></p>
    <span class="vm-loader-subtext">Please wait...</span>
  </div>
</div>

<!-- ==========================================
     NAVBAR
========================================== -->

<header class="site-header">
  <div class="container navbar">
    <!-- LOGO -->
    <a href="/" class="logo">
      <img
        src="/images/logo/visamaster-logo.png"
        alt="VisaMaster Logo"
        class="logo-image"
      />

      <div class="logo-text">
        <div class="logo-name">Visa<span>Master</span></div>
        <div class="logo-tagline">Your Trusted Visa Partner</div>
      </div>
    </a>

    <!-- ======================================
         NAVIGATION LINKS
    ======================================= -->

    <nav class="nav-links" id="mainNavigation">
      <!-- HOME -->
      <a href="/" class="<%= currentPage === 'home' ? 'active' : '' %>">
        Home
      </a>

      <!-- ==================================
           VISA INFO DROPDOWN
      =================================== -->

      <div
        class="nav-dropdown <%= ['visas', 'e-visa', 'sticker-visa', 'visa-on-arrival', 'schengen'].includes(currentPage) ? 'active' : '' %>"
        id="visaInfoDropdown"
      >
        <button
          class="nav-dropdown-main"
          id="visaInfoDropdownToggle"
          type="button"
          aria-expanded="false"
          aria-controls="visaInfoSubmenu"
        >
          <span class="nav-dropdown-label">Visa-info</span>

          <svg
            class="nav-dropdown-arrow"
            xmlns="http://www.w3.org/2000/svg"
            width="14"
            height="14"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2.5"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <path d="m6 9 6 6 6-6"></path>
          </svg>
        </button>

        <!-- VISA INFO SUBMENU -->
        <div class="nav-dropdown-menu" id="visaInfoSubmenu" hidden>
          <!-- ALL VISAS -->
          <a
            href="/visas"
            class="nav-dropdown-item <%= currentPage === 'visas' ? 'active' : '' %>"
          >
            <span class="nav-dropdown-item-icon">▤</span>

            <span class="nav-dropdown-item-text">
              <strong>All Visa Information</strong>
              <small>Explore all visa categories</small>
            </span>

            <span class="nav-dropdown-item-arrow">→</span>
          </a>

          <!-- E-VISA -->
          <a
            href="/visas/e-visa"
            class="nav-dropdown-item <%= currentPage === 'e-visa' ? 'active' : '' %>"
          >
            <span class="nav-dropdown-item-icon">✈</span>

            <span class="nav-dropdown-item-text">
              <strong>E-Visa</strong>
              <small>Explore electronic visas</small>
            </span>

            <span class="nav-dropdown-item-arrow">→</span>
          </a>

          <!-- STICKER VISA -->
          <a
            href="/visas/sticker-visa"
            class="nav-dropdown-item <%= currentPage === 'sticker-visa' ? 'active' : '' %>"
          >
            <span class="nav-dropdown-item-icon">📘</span>

            <span class="nav-dropdown-item-text">
              <strong>Sticker Visa</strong>
              <small>Explore embassy-issued visas</small>
            </span>

            <span class="nav-dropdown-item-arrow">→</span>
          </a>

          <!-- VISA ON ARRIVAL -->
          <a
            href="/visas/visa-on-arrival"
            class="nav-dropdown-item <%= currentPage === 'visa-on-arrival' ? 'active' : '' %>"
          >
            <span class="nav-dropdown-item-icon">🛬</span>

            <span class="nav-dropdown-item-text">
              <strong>Visa on Arrival</strong>
              <small>Explore visas available on arrival</small>
            </span>

            <span class="nav-dropdown-item-arrow">→</span>
          </a>

          <!-- SCHENGEN VISA -->
          <a
            href="/visas/schengen"
            class="nav-dropdown-item <%= currentPage === 'schengen' ? 'active' : '' %>"
          >
            <span class="nav-dropdown-item-icon">🌍</span>

            <span class="nav-dropdown-item-text">
              <strong>Schengen-Visa</strong>
              <small>Explore European travel visas</small>
            </span>

            <span class="nav-dropdown-item-arrow">→</span>
          </a>
        </div>
      </div>

      <!-- SERVICES -->
      <a
        href="/services"
        class="<%= currentPage === 'services' ? 'active' : '' %>"
      >
        Our-Services
      </a>

      <!-- DESTINATIONS -->
      <a
        href="/destinations"
        class="<%= currentPage === 'destinations' ? 'active' : '' %>"
      >
        Countries
      </a>

      <!-- NEWS -->
      <a href="/news" class="<%= currentPage === 'news' ? 'active' : '' %>">
        Latest News
      </a>

      <!-- CONTACT -->
      <a
        href="/contact"
        class="<%= currentPage === 'contact' ? 'active' : '' %>"
      >
        Contact
      </a>

      <!-- ==================================
           MOBILE GET STARTED DROPDOWN
      =================================== -->

      <div class="mobile-get-started-dropdown">
        <button
          type="button"
          class="mobile-nav-button"
          id="mobileGetStartedToggle"
          aria-expanded="false"
          aria-controls="mobileGetStartedMenu"
        >
          Get Started

          <span>→</span>
        </button>

        <!-- MOBILE DROPDOWN MENU -->
        <div class="mobile-get-started-menu" id="mobileGetStartedMenu" hidden>
          <!-- LOGIN / SIGNUP -->
          <a href="/auth/login" class="get-started-menu-item">
            <span class="get-started-menu-icon">
              <svg
                xmlns="http://www.w3.org/2000/svg"
                width="19"
                height="19"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
              >
                <path d="M16 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path>
                <circle cx="10" cy="7" r="4"></circle>
                <path d="M20 8v6"></path>
                <path d="M23 11h-6"></path>
              </svg>
            </span>

            <span>Login / Signup</span>
          </a>

          <!-- ADMIN -->
          <a href="/admin/login" class="get-started-menu-item">
            <span class="get-started-menu-icon">
              <svg
                xmlns="http://www.w3.org/2000/svg"
                width="19"
                height="19"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
              >
                <path d="M12 22s8-4 8-11V5l-8-3-8 3v6c0 7 8 11 8 11z"></path>
                <path d="m9 12 2 2 4-4"></path>
              </svg>
            </span>

            <span>Admin</span>
          </a>
        </div>
      </div>
    </nav>

    <!-- ======================================
         DESKTOP GET STARTED DROPDOWN
    ======================================= -->

    <div class="get-started-dropdown" id="getStartedDropdown">
      <button
        class="nav-button"
        id="getStartedToggle"
        type="button"
        aria-expanded="false"
        aria-controls="getStartedMenu"
      >
        Get Started

        <span>→</span>
      </button>

      <!-- DESKTOP DROPDOWN MENU -->
      <div class="get-started-menu" id="getStartedMenu" hidden>
        <!-- LOGIN / SIGNUP -->
        <a href="/auth/login" class="get-started-menu-item">
          <span class="get-started-menu-icon">
            <svg
              xmlns="http://www.w3.org/2000/svg"
              width="19"
              height="19"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
            >
              <path d="M16 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path>
              <circle cx="10" cy="7" r="4"></circle>
              <path d="M20 8v6"></path>
              <path d="M23 11h-6"></path>
            </svg>
          </span>

          <span>Login / Signup</span>
        </a>

        <!-- ADMIN -->
        <a href="/admin/login" class="get-started-menu-item">
          <span class="get-started-menu-icon">
            <svg
              xmlns="http://www.w3.org/2000/svg"
              width="19"
              height="19"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
            >
              <path d="M12 22s8-4 8-11V5l-8-3-8 3v6c0 7 8 11 8 11z"></path>
              <path d="m9 12 2 2 4-4"></path>
            </svg>
          </span>

          <span>Admin</span>
        </a>
      </div>
    </div>

    <!-- ======================================
         MOBILE HAMBURGER BUTTON
    ======================================= -->

    <button
      class="mobile-menu-button"
      id="mobileMenuButton"
      type="button"
      aria-label="Open navigation menu"
      aria-expanded="false"
      aria-controls="mainNavigation"
    >
      ☰
    </button>
  </div>
</header>

<!-- ==========================================
     NAVBAR JAVASCRIPT
========================================== -->

<script src="/js/navbar.js" defer></script>
