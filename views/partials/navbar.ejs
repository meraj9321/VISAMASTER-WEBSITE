<header class="site-header">
  <div class="container navbar">
    <link rel="icon" href="/favicon.ico" type="image/x-icon" />
    <!-- LOGO -->
    <a href="/" class="logo">
      <img
        src="/images/logo/visamaster-logo.png"
        alt="VisaMaster Logo"
        class="logo-image"
      />

      <div class="logo-text">
        <div class="logo-name">Visa<span>Master</span></div>
        <div class="logo-tagline">Your Trusted Visa Partner</div>
      </div>
    </a>

    <!-- NAVIGATION -->
    <nav class="nav-links" id="mainNavigation">
      <!-- HOME -->
      <a href="/" class="<%= currentPage === 'home' ? 'active' : '' %>">
        Home
      </a>

      <!-- VISA INFO DROPDOWN -->
      <div
        class="nav-dropdown <%= ['visas', 'e-visa', 'schengen'].includes(currentPage) ? 'active' : '' %>"
        id="visaInfoDropdown"
      >
        <!-- CLICK ANYWHERE HERE TO TOGGLE DROPDOWN -->
        <button
          class="nav-dropdown-main"
          id="visaInfoDropdownToggle"
          type="button"
          aria-expanded="false"
          aria-controls="visaInfoSubmenu"
        >
          <span class="nav-dropdown-label">Visa-info</span>

          <svg
            class="nav-dropdown-arrow"
            xmlns="http://www.w3.org/2000/svg"
            width="14"
            height="14"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2.5"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <path d="m6 9 6 6 6-6"></path>
          </svg>
        </button>

        <!-- DROPDOWN ITEMS -->
        <div class="nav-dropdown-menu" id="visaInfoSubmenu" hidden>
          <!-- MAIN VISA INFORMATION PAGE -->
          <a
            href="/visas"
            class="nav-dropdown-item <%= currentPage === 'visas' ? 'active' : '' %>"
          >
            <span class="nav-dropdown-item-icon">▤</span>

            <span class="nav-dropdown-item-text">
              <strong>All Visa Information</strong>
              <small>Explore all visa categories</small>
            </span>

            <span class="nav-dropdown-item-arrow">→</span>
          </a>

          <!-- E-VISA -->
          <a
            href="/visas/e-visa"
            class="nav-dropdown-item <%= currentPage === 'e-visa' ? 'active' : '' %>"
          >
            <span class="nav-dropdown-item-icon">✈</span>

            <span class="nav-dropdown-item-text">
              <strong>E-Visa</strong>
              <small>Explore electronic visas</small>
            </span>

            <span class="nav-dropdown-item-arrow">→</span>
          </a>

          <!-- SCHENGEN VISA -->
          <a
            href="/visas/schengen"
            class="nav-dropdown-item <%= currentPage === 'schengen' ? 'active' : '' %>"
          >
            <span class="nav-dropdown-item-icon">🌍</span>

            <span class="nav-dropdown-item-text">
              <strong>Schengen-Visa</strong>
              <small>Explore European travel visas</small>
            </span>

            <span class="nav-dropdown-item-arrow">→</span>
          </a>
        </div>
      </div>

      <!-- SERVICES -->
      <a
        href="/services"
        class="<%= currentPage === 'services' ? 'active' : '' %>"
      >
        Our-Services
      </a>

      <!-- DESTINATIONS -->
      <a
        href="/destinations"
        class="<%= currentPage === 'destinations' ? 'active' : '' %>"
      >
        See-Requirements
      </a>

      <!-- NEWS -->
      <a href="/news" class="<%= currentPage === 'news' ? 'active' : '' %>">
        Latest News
      </a>

      <!-- CONTACT -->
      <a
        href="/contact"
        class="<%= currentPage === 'contact' ? 'active' : '' %>"
      >
        Contact
      </a>

      <!-- MOBILE GET STARTED -->
      <a href="/contact" class="mobile-nav-button">
        Get Started
        <span>→</span>
      </a>
    </nav>

    <!-- DESKTOP GET STARTED -->
    <a href="/contact" class="nav-button">
      Get Started
      <span>→</span>
    </a>

    <!-- MOBILE MENU BUTTON -->
    <button
      class="mobile-menu-button"
      id="mobileMenuButton"
      type="button"
      aria-label="Open navigation menu"
      aria-expanded="false"
      aria-controls="mainNavigation"
    >
      ☰
    </button>
  </div>
</header>

<!-- NAVBAR JAVASCRIPT -->
<script>
  document.addEventListener("DOMContentLoaded", function () {
    const dropdown = document.getElementById("visaInfoDropdown");
    const dropdownToggle = document.getElementById("visaInfoDropdownToggle");
    const submenu = document.getElementById("visaInfoSubmenu");

    const mobileMenuButton = document.getElementById("mobileMenuButton");
    const mainNavigation = document.getElementById("mainNavigation");

    // VISA INFO DROPDOWN
    if (dropdown && dropdownToggle && submenu) {
      function closeVisaDropdown() {
        submenu.hidden = true;

        dropdownToggle.setAttribute("aria-expanded", "false");

        dropdown.classList.remove("is-open");
      }

      function toggleVisaDropdown() {
        const isCurrentlyOpen = !submenu.hidden;

        submenu.hidden = isCurrentlyOpen;

        dropdownToggle.setAttribute("aria-expanded", String(!isCurrentlyOpen));

        dropdown.classList.toggle("is-open", !isCurrentlyOpen);
      }

      // Clicking anywhere on Visa-info opens/closes the dropdown.
      dropdownToggle.addEventListener("click", function (event) {
        event.preventDefault();
        event.stopPropagation();

        toggleVisaDropdown();
      });

      // Close when clicking outside.
      document.addEventListener("click", function (event) {
        if (!dropdown.contains(event.target)) {
          closeVisaDropdown();
        }
      });

      // Close with Escape.
      document.addEventListener("keydown", function (event) {
        if (event.key === "Escape") {
          closeVisaDropdown();
          dropdownToggle.focus();
        }
      });
    }

    // MOBILE NAVIGATION
    if (mobileMenuButton && mainNavigation) {
      mobileMenuButton.addEventListener("click", function () {
        const isOpen = mainNavigation.classList.toggle("is-active");

        mobileMenuButton.setAttribute("aria-expanded", String(isOpen));

        mobileMenuButton.setAttribute(
          "aria-label",
          isOpen ? "Close navigation menu" : "Open navigation menu",
        );
      });

      // Close mobile menu after selecting a navigation link.
      mainNavigation.querySelectorAll("a").forEach(function (link) {
        link.addEventListener("click", function () {
          mainNavigation.classList.remove("is-active");

          mobileMenuButton.setAttribute("aria-expanded", "false");

          mobileMenuButton.setAttribute("aria-label", "Open navigation menu");
        });
      });
    }
  });
</script>
