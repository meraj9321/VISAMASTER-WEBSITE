<link rel="stylesheet" href="/css/loader.css" />
<script src="/js/loader.js" defer></script>

<!-- MINIMAL VISAMASTER LOADER -->
<div id="vm-page-loader" role="status" aria-label="Loading VisaMaster">
  <div class="vm-loader-simple">
    <div class="vm-spinner"></div>
    <p class="vm-loader-text">Visa<span>Master</span></p>
    <span class="vm-loader-subtext">Please wait...</span>
  </div>
</div>

<header class="site-header">
  <div class="container navbar">
    <link rel="icon" href="/favicon.ico" type="image/x-icon" />
    <!-- LOGO -->
    <a href="/" class="logo">
      <img
        src="/images/logo/visamaster-logo.png"
        alt="VisaMaster Logo"
        class="logo-image"
      />

      <div class="logo-text">
        <div class="logo-name">Visa<span>Master</span></div>
        <div class="logo-tagline">Your Trusted Visa Partner</div>
      </div>
    </a>

    <!-- NAVIGATION -->
    <nav class="nav-links" id="mainNavigation">
      <!-- HOME -->
      <a href="/" class="<%= currentPage === 'home' ? 'active' : '' %>">
        Home
      </a>

      <!-- VISA INFO DROPDOWN -->
      <div
        class="nav-dropdown <%= ['visas', 'e-visa', 'schengen'].includes(currentPage) ? 'active' : '' %>"
        id="visaInfoDropdown"
      >
        <!-- CLICK ANYWHERE HERE TO TOGGLE DROPDOWN -->
        <button
          class="nav-dropdown-main"
          id="visaInfoDropdownToggle"
          type="button"
          aria-expanded="false"
          aria-controls="visaInfoSubmenu"
        >
          <span class="nav-dropdown-label">Visa-info</span>

          <svg
            class="nav-dropdown-arrow"
            xmlns="http://www.w3.org/2000/svg"
            width="14"
            height="14"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2.5"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <path d="m6 9 6 6 6-6"></path>
          </svg>
        </button>

        <!-- DROPDOWN ITEMS -->
        <div class="nav-dropdown-menu" id="visaInfoSubmenu" hidden>
          <!-- MAIN VISA INFORMATION PAGE -->
          <a
            href="/visas"
            class="nav-dropdown-item <%= currentPage === 'visas' ? 'active' : '' %>"
          >
            <span class="nav-dropdown-item-icon">▤</span>

            <span class="nav-dropdown-item-text">
              <strong>All Visa Information</strong>
              <small>Explore all visa categories</small>
            </span>

            <span class="nav-dropdown-item-arrow">→</span>
          </a>

          <!-- E-VISA -->
          <a
            href="/visas/e-visa"
            class="nav-dropdown-item <%= currentPage === 'e-visa' ? 'active' : '' %>"
          >
            <span class="nav-dropdown-item-icon">✈</span>

            <span class="nav-dropdown-item-text">
              <strong>E-Visa</strong>
              <small>Explore electronic visas</small>
            </span>

            <span class="nav-dropdown-item-arrow">→</span>
          </a>

          <!-- STICKER VISA -->
          <a
            href="/visas/sticker-visa"
            class="nav-dropdown-item <%= currentPage === 'sticker-visa' ? 'active' : '' %>"
          >
            <span class="nav-dropdown-item-icon">📘</span>

            <span class="nav-dropdown-item-text">
              <strong>Sticker Visa</strong>
              <small>Explore embassy-issued visas</small>
            </span>

            <span class="nav-dropdown-item-arrow">→</span>
          </a>

          <!-- VISA ON ARRIVAL -->
          <a
            href="/visas/visa-on-arrival"
            class="nav-dropdown-item <%= currentPage === 'visa-on-arrival' ? 'active' : '' %>"
          >
            <span class="nav-dropdown-item-icon">🛬</span>

            <span class="nav-dropdown-item-text">
              <strong>Visa on Arrival</strong>
              <small>Explore visas available on arrival</small>
            </span>

            <span class="nav-dropdown-item-arrow">→</span>
          </a>

          <!-- SCHENGEN VISA -->
          <a
            href="/visas/schengen"
            class="nav-dropdown-item <%= currentPage === 'schengen' ? 'active' : '' %>"
          >
            <span class="nav-dropdown-item-icon">🌍</span>

            <span class="nav-dropdown-item-text">
              <strong>Schengen-Visa</strong>
              <small>Explore European travel visas</small>
            </span>

            <span class="nav-dropdown-item-arrow">→</span>
          </a>
        </div>
      </div>

      <!-- SERVICES -->
      <a
        href="/services"
        class="<%= currentPage === 'services' ? 'active' : '' %>"
      >
        Our-Services
      </a>

      <!-- DESTINATIONS -->
      <a
        href="/destinations"
        class="<%= currentPage === 'destinations' ? 'active' : '' %>"
      >
        Countries
      </a>

      <!-- NEWS -->
      <a href="/news" class="<%= currentPage === 'news' ? 'active' : '' %>">
        Latest News
      </a>

      <!-- CONTACT -->
      <a
        href="/contact"
        class="<%= currentPage === 'contact' ? 'active' : '' %>"
      >
        Contact
      </a>

      <!-- MOBILE GET STARTED -->
      <a href="/contact" class="mobile-nav-button">
        Get Started
        <span>→</span>
      </a>
    </nav>

    <!-- DESKTOP GET STARTED -->
    <a href="/contact" class="nav-button">
      Get Started
      <span>→</span>
    </a>

    <!-- MOBILE MENU BUTTON -->
    <button
      class="mobile-menu-button"
      id="mobileMenuButton"
      type="button"
      aria-label="Open navigation menu"
      aria-expanded="false"
      aria-controls="mainNavigation"
    >
      ☰
    </button>
  </div>
</header>

<!-- NAVBAR JAVASCRIPT -->

<script src="/js/navbar.js" defer></script>
