<body>


  <!-- =========================
       NAVBAR
  ========================== -->

  <%- include("../partials/navbar") %>



  <!-- =========================
       MAIN CONTENT
  ========================== -->

  <main>


    <!-- =========================
         HERO SECTION
    ========================== -->

    <section class="hero">

      <div class="container hero-grid">


        <!-- =========================
             LEFT SIDE
        ========================== -->

        <div class="hero-content">


          <div class="hero-small-text">
            ✦ YOUR JOURNEY STARTS HERE
          </div>


          <h1>
            Go beyond<br>
            your <span>limits.</span>
          </h1>


          <div class="yellow-line"></div>


          <h2>
            Travel. Explore. Experience.
          </h2>


          <p>
            VisaMaster makes your dream destinations closer
            with simple, fast and reliable visa solutions.
          </p>


          <!-- =========================
               DESTINATION SEARCH
          ========================== -->

         <div class="country-search">
  <form class="country-search-form" action="/countries" method="GET">
    <div class="search-input-wrapper">
      <span class="search-icon">⌕</span>

      <input
        type="text"
        id="countrySearchInput"
        name="q"
        autocomplete="off"
        placeholder="Search your destination..."
        required
        minlength="2"
      />

      <button type="submit" class="search-button">
        Complete-detail
      </button>

      <div
        id="countrySuggestions"
        class="country-suggestions"
      ></div>
    </div>
  </form>
</div>

          <!-- =========================
               TRUST ITEMS
          ========================== -->

          <div class="trust-items">


            <div class="trust-item">

              <strong>✈</strong>

              <span>
                Global<br>
                Destinations
              </span>

            </div>


            <div class="trust-divider"></div>


            <div class="trust-item">

              <strong>♢</strong>

              <span>
                Trusted<br>
                &amp; Secure
              </span>

            </div>


            <div class="trust-divider"></div>


            <div class="trust-item">

              <strong>♡</strong>

              <span>
                Happy<br>
                Travelers
              </span>

            </div>


          </div>

        </div>



