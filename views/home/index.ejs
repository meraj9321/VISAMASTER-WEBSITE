      </div>

    </section>



    <!-- =========================
         WHY CHOOSE VISAMASTER
    ========================== -->

    <section class="why-us">

      <div class="container">


        <div class="section-title">

          <h2>
            Why Choose VisaMaster?
          </h2>

          <div class="heading-line"></div>

        </div>


        <div class="benefits">


          <div class="benefit">

            <div class="benefit-icon">
              ▣
            </div>

            <h3>
              Easy Process
            </h3>

            <p>
              Simple steps, less stress.<br>
              We make it easy for you.
            </p>

          </div>



          <div class="benefit">

            <div class="benefit-icon">
              ϟ
            </div>

            <h3>
              Fast Processing
            </h3>

            <p>
              Save time with our<br>
              streamlined process.
            </p>

          </div>



          <div class="benefit">

            <div class="benefit-icon">
              ♧
            </div>

            <h3>
              Expert Support
            </h3>

            <p>
              Our team is always here<br>
              to help you.
            </p>

          </div>



          <div class="benefit">

            <div class="benefit-icon">
              ▤
            </div>

            <h3>
              Simple Documentation
            </h3>

            <p>
              Minimal paperwork,<br>
              maximum convenience.
            </p>

          </div>


        </div>

      </div>

    </section>



    <!-- =========================
         B2B PARTNER BANNER
    ========================== -->

    <section class="container b2b-section">

      <div class="b2b-banner">


        <div class="b2b-handshake">
          🤝
        </div>


        <div class="b2b-content">

          <div class="b2b-label">
            FOR TRAVEL AGENTS &amp; BUSINESS PARTNERS
          </div>


          <h2>
            Grow Your Travel<br>
            Business With Us
          </h2>


          <p>
            Partner with VisaMaster and offer
            visa &amp; travel solutions to your clients.
          </p>


          <a
            href="/contact?type=partner"
            class="dark-button"
          >
            Become a Partner →
          </a>

        </div>


        <div class="b2b-visual">

          <div class="stronger">
            ✦ Stronger<br>
            <span>Together</span> ✦
          </div>


          <div class="b2b-globe">
            🌍
          </div>


          <div class="b2b-plane">
            ✈
          </div>


          <div class="b2b-suitcase">
            🧳
          </div>

        </div>


      </div>

    </section>



    <!-- =========================
         LATEST NEWS
    ========================== -->

    <section class="news-section">

      <div class="container">


        <div class="news-heading-row">


          <div class="section-title left">

            <h2>
              📣 Latest News
            </h2>

            <div class="heading-line"></div>

          </div>


          <div class="news-tabs">

            <button
              class="active"
              type="button"
              data-filter="all"
            >
              All
            </button>


            <button
              type="button"
              data-filter="Visa Updates"
            >
              Visa Updates
            </button>


            <button
              type="button"
              data-filter="Travel Updates"
            >
              Travel Updates
            </button>

          </div>

        </div>



        <div class="news-grid">


          <!-- =========================
               DEMO NEWS
          ========================== -->

          <% const demoNews = [

            {
              title: "UAE Announces New Visa Rules",
              category: "Visa Updates",
              date: "12 May 2025",
              image: "https://images.unsplash.com/photo-1512453979798-5ea266f8880c?auto=format&fit=crop&w=900&q=80",
              excerpt: "The UAE has introduced updated visa regulations, making travel easier for tourists..."
            },

            {
              title: "Top 10 Countries for Indian Travelers",
              category: "Travel Updates",
              date: "10 May 2025",
              image: "https://blogger.googleusercontent.com/img/b/R29vZ2xl/AVvXsEisb7aZPLipheF_j0RZG_2RxC8xzo2KFoIt36F3cMfHt3fisp8Ppqfh23kfKqA5PMmVblKxooJSLxQ6IkMaeI1N7yQAheBmMUwzNS8ynCU_AK871e4NhNxXNtMILWYf0VLX3Zj9ovl0uLeCFgI3GNMyj-dPCLch3IZNyVqnfbHRL0U4ld5Ar9I0rCSfuw/w1600/largest%20country%20top%2010%20.png",
              excerpt: "From stunning landscapes to rich cultures, these are popular destinations for Indian travelers..."
            },

            {
              title: "Schengen Visa Processing Time Reduced",
              category: "Visa Updates",
              date: "08 May 2025",
              image: "https://images.unsplash.com/photo-1548013146-72479768bada?auto=format&fit=crop&w=900&q=80",
              excerpt: "Good news for travelers! Processing time information has been updated for applicants..."
            }

          ]; %>


          <% const newsItems =
            (typeof news !== "undefined" && news.length)
              ? news.slice(0, 3)
              : demoNews;
          %>



          <% newsItems.forEach(item => { %>


            <article
              class="news-card"
              data-category="<%= item.category %>"
            >


              <div class="news-image">

                <img
                  src="<%= item.image %>"
                  alt="<%= item.title %>"
                >


                <span>
                  <%= item.category %>
                </span>

              </div>


              <div class="news-content">


                <h3>
                  <%= item.title %>
                </h3>


                <p>
                  <%= item.excerpt %>
                </p>


                <div class="news-meta">

                  <span>
                    ▣ <%= item.date %>
                  </span>


                  <a
                    href="/news/<%= item.slug || '#' %>"
                  >
                    Read More →
                  </a>

                </div>

              </div>

            </article>


          <% }) %>


        </div>


        <div class="view-news">

          <a
            href="/news"
            class="outline-button"
          >
            View All News →
          </a>

        </div>


      </div>

    </section>



    <!-- =========================
         FINAL CTA
    ========================== -->

    <section class="final-cta">


      <div class="mountain mountain-left">
        ⛰️
      </div>


      <div class="cta-content">

        <h2>
          Ready for your next journey?
        </h2>


        <p>
          Let’s make it happen.
          Get your visa today and explore the world.
        </p>


        <a
          href="/contact"
          class="yellow-button"
        >
          Get Started →
        </a>

      </div>


      <div class="mountain mountain-right">
        ⛰️
      </div>


    </section>


  </main>



  <!-- =========================
       FOOTER
  ========================== -->

