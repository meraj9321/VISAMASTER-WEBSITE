<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>About Us | VisaMaster</title>

    <!-- Global + Page CSS -->
    <link rel="stylesheet" href="/css/global.css" />
    <link rel="stylesheet" href="/css/navbar.css" />
    <link rel="stylesheet" href="/css/about.css" />
    <link rel="stylesheet" href="/css/footer.css" />
  </head>

  <body>
    <!-- =========================
       NAVBAR
  ========================== -->

    <%- include("../partials/navbar") %>

    <main>
      <!-- =========================
         ABOUT HERO
    ========================== -->

      <section class="about-hero">
        <div class="about-container">
          <div class="about-hero-grid">
            <!-- LEFT CONTENT -->

            <div class="about-hero-content">
              <div class="about-badge">✈️ Hey Traveler!</div>

              <h1>
                We Help You
                <span>Go Places.</span>
              </h1>

              <p>
                At VisaMaster, we make visa processing simple, transparent and
                stress-free — so you can focus on the journey waiting for you.
              </p>

              <div class="about-hero-buttons">
                <a href="/countries" class="about-primary-btn">
                  Explore Visas
                  <span>→</span>
                </a>

                <a href="/contact" class="about-secondary-btn">
                  Talk to Us
                  <span>💬</span>
                </a>
              </div>

              <div class="about-trust-points">
                <div>
                  <span>✓</span>
                  Easy Process
                </div>

                <div>
                  <span>✓</span>
                  Expert Guidance
                </div>

                <div>
                  <span>✓</span>
                  Friendly Support
                </div>
              </div>
            </div>

            <!-- RIGHT CARTOON -->

            <div class="about-hero-visual">
              <div class="sky-sun">☀️</div>

              <div class="sky-cloud cloud-one">☁️</div>
              <div class="sky-cloud cloud-two">☁️</div>

              <div class="travel-circle"></div>

              <div class="travel-globe">🌍</div>

              <div class="travel-plane">✈️</div>

              <div class="travel-suitcase">🧳</div>

              <div class="travel-passport">🛂</div>

              <div class="travel-star star-one">✦</div>
              <div class="travel-star star-two">✧</div>
              <div class="travel-star star-three">✦</div>

              <div class="travel-doodle">~ ~ ~</div>
            </div>
          </div>
        </div>
      </section>

      <!-- =========================
         WHO WE ARE
    ========================== -->

      <section class="about-story">
        <div class="about-container">
          <div class="about-story-grid">
            <!-- STORY VISUAL -->

            <div class="story-visual">
              <div class="story-card">
                <div class="story-card-top">
                  <span>VISA</span>
                  <span>✈️</span>
                </div>

                <div class="story-card-middle">🌍</div>

                <div class="story-card-bottom">
                  <span>READY TO GO</span>
                  <span>✓</span>
                </div>
              </div>

              <div class="story-plane">✈</div>

              <div class="story-dots">• • • •</div>
            </div>

            <!-- STORY CONTENT -->

            <div class="story-content">
              <div class="section-label">🌎 OUR STORY</div>

              <h2>
                Your Journey Starts
                <span>With Us.</span>
              </h2>

              <p>
                Travelling to another country is exciting, but visa paperwork
                can sometimes feel confusing. That's where VisaMaster comes in.
              </p>

              <p>
                We are building VisaMaster to make the visa journey easier for
                travellers by bringing information, guidance and support
                together in one simple place.
              </p>

              <p>
                Whether you're travelling for a holiday, business, study or a
                new opportunity, our goal is to help you move forward with
                confidence.
              </p>

              <a href="/services" class="story-link">
                Explore Our Services
                <span>→</span>
              </a>
            </div>
          </div>
        </div>
      </section>

      <!-- =========================
         WHY CHOOSE US
    ========================== -->

      <section class="about-why">
        <div class="about-container">
          <div class="about-section-heading">
            <div class="section-label">💙 WHY VISAMASTER</div>

            <h2>
              Travel Should Feel
              <span>Exciting.</span>
            </h2>

            <p>
              We believe the visa process should be simple, clear and easy to
              understand.
            </p>
          </div>

          <div class="why-grid">
            <!-- CARD 1 -->

            <div class="why-card why-card-one">
              <div class="why-icon">📝</div>

              <h3>Simple Process</h3>

              <p>
                We keep the process easy to understand, without unnecessary
                confusion.
              </p>

              <div class="card-number">01</div>
            </div>

            <!-- CARD 2 -->

            <div class="why-card why-card-two">
              <div class="why-icon">🧭</div>

              <h3>Expert Guidance</h3>

              <p>
                Get guidance throughout your visa journey so you know what comes
                next.
              </p>

              <div class="card-number">02</div>
            </div>

            <!-- CARD 3 -->

            <div class="why-card why-card-three">
              <div class="why-icon">🔎</div>

              <h3>Clear Information</h3>

              <p>
                We aim to keep important visa information clear, organised and
                accessible.
              </p>

              <div class="card-number">03</div>
            </div>

            <!-- CARD 4 -->

            <div class="why-card why-card-four">
              <div class="why-icon">💬</div>

              <h3>Friendly Support</h3>

              <p>
                Whenever you have questions, our team is here to help you move
                ahead.
              </p>

              <div class="card-number">04</div>
            </div>
          </div>
        </div>
      </section>

      <!-- =========================
         MISSION
    ========================== -->

      <section class="about-mission">
        <div class="about-container">
          <div class="mission-card">
            <div class="mission-decoration mission-left">✈️</div>

            <div class="mission-content">
              <div class="section-label">🎯 OUR MISSION</div>

              <h2>
                Making Visa Journeys
                <span>Less Complicated.</span>
              </h2>

              <p>
                Our mission is simple — make international travel easier by
                providing a smooth, transparent and traveller-friendly visa
                experience.
              </p>
            </div>

            <div class="mission-decoration mission-right">🌍</div>
          </div>
        </div>
      </section>

      <!-- =========================
         VISION
    ========================== -->

      <section class="about-vision">
        <div class="about-container">
          <div class="vision-grid">
            <div class="vision-content">
              <div class="section-label">🚀 OUR VISION</div>

              <h2>
                From Visa Confusion
                <span>To Travel Confidence.</span>
              </h2>

              <p>
                We want VisaMaster to become a trusted travel companion for
                people planning their next international journey.
              </p>

              <p>
                From discovering destinations to understanding visa
                requirements, we aim to make every step easier.
              </p>
            </div>

            <div class="vision-illustration">
              <div class="vision-sun">☀️</div>

              <div class="vision-cloud">☁️</div>

              <div class="vision-world">🌎</div>

              <div class="vision-road">─────────</div>

              <div class="vision-car">🚐</div>

              <div class="vision-flag">🚩</div>
            </div>
          </div>
        </div>
      </section>

      <!-- =========================
         CTA
    ========================== -->

      <section class="about-cta">
        <div class="about-container">
          <div class="about-cta-card">
            <div class="cta-doodle cta-doodle-one">✦</div>

            <div class="cta-doodle cta-doodle-two">✈</div>

            <div class="cta-content">
              <div class="section-label">✈️ READY FOR YOUR NEXT JOURNEY?</div>

              <h2>
                Your Next Destination
                <span>Is Waiting.</span>
              </h2>

              <p>Let's make the visa process one less thing to worry about.</p>

              <div class="cta-buttons">
                <a href="/countries" class="cta-primary">
                  Explore Visas
                  <span>→</span>
                </a>

                <a href="/contact" class="cta-secondary">
                  Get Started
                  <span>✈️</span>
                </a>
              </div>
            </div>
          </div>
        </div>
      </section>
    </main>

    <!-- =========================
       FOOTER
  ========================== -->

    <%- include("../partials/footer") %>

    <script src="/js/main.js"></script>
  </body>
</html>
