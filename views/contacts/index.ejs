            <div class="contact-info-item">

              <div class="contact-info-icon">
                🕐
              </div>


              <div>

                <small>
                  Working Hours
                </small>

                <strong>
                  Mon – Sat · 10 AM – 7 PM
                </strong>

              </div>

            </div>


          </div>

