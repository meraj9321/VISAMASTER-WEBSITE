                      <% } %>

                    </div>


                    <div class="team-contact-actions">


                      <% if (executive.phone) { %>

                        <a
                          href="tel:<%= executive.phone %>"
                          class="team-action-btn team-call-btn"
                          title="Call <%= executive.name %>"
                        >

                          <span>📞</span>
                          <span>Call</span>

                        </a>

                      <% } %>


                      <% if (
                        executive.whatsapp ||
                        executive.phone
                      ) { %>

                        <%
                          const executiveWhatsApp =
                            executive.whatsapp ||
                            executive.phone;
                        %>

                        <a
                          href="https://wa.me/<%= String(executiveWhatsApp).replace(/\D/g, '') %>"
                          target="_blank"
                          rel="noopener noreferrer"
                          class="team-action-btn team-whatsapp-btn"
                          title="WhatsApp <%= executive.name %>"
                        >

