                        >

                          <span class="team-contact-icon">
                            📞
                          </span>

                          <span>
                            <%= accountant.phone %>
                          </span>

                        </a>

                      <% } %>


                      <% if (accountant.email) { %>

                        <a
                          href="mailto:<%= accountant.email %>"
                          class="team-contact-link"
                          title="Email <%= accountant.name %>"
                        >

                          <span class="team-contact-icon">
                            ✉️
                          </span>

                          <span>
                            <%= accountant.email %>
                          </span>

                        </a>

                      <% } %>

                    </div>


                    <div class="team-contact-actions">


                      <% if (accountant.phone) { %>

                        <a
                          href="tel:<%= accountant.phone %>"
                          class="team-action-btn team-call-btn"
