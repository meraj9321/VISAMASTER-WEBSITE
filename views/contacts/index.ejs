  </main>


  <!-- =========================================================
       FOOTER
  ========================================================= -->

  <%- include("../partials/footer") %>


  <!-- =========================================================
       SUCCESS POPUP
  ========================================================= -->

  <% if (
    typeof success !== "undefined" &&
    success
  ) { %>

    <div
      class="enquiry-success-overlay"
      id="enquirySuccessPopup"
      role="dialog"
      aria-modal="true"
      aria-labelledby="enquirySuccessTitle"
    >

      <div class="enquiry-success-popup">


        <!-- CLOSE BUTTON -->

        <button
          type="button"
          class="enquiry-success-close"
          id="closeSuccessPopup"
          aria-label="Close success message"
        >
          &times;
        </button>


        <!-- SUCCESS ICON -->

        <div
          class="enquiry-success-icon"
          aria-hidden="true"
        >
          ✓
        </div>


        <!-- HEADING -->

        <h2 id="enquirySuccessTitle">
          Application Submitted Successfully!
        </h2>


        <!-- MESSAGE -->

        <p>
          Thank you for contacting VisaMaster.
          Our team will get back to you shortly.
        </p>


        <!-- OK BUTTON -->

        <button
          type="button"
          class="enquiry-success-button"
          id="successPopupOk"
        >
          OK
        </button>


      </div>

    </div>

  <% } %>


  <!-- =========================================================
       MAIN JAVASCRIPT
  ========================================================= -->

  <script src="/js/main.js"></script>


  <!-- =========================================================
       SUCCESS POPUP JAVASCRIPT
  ========================================================= -->

  <script>

    document.addEventListener(
      "DOMContentLoaded",
      function () {

        const popup =
          document.getElementById(
            "enquirySuccessPopup"
          );

        const closeButton =
          document.getElementById(
            "closeSuccessPopup"
          );

        const okButton =
          document.getElementById(
            "successPopupOk"
          );


        // -----------------------------------------------
        // CLOSE POPUP
        // -----------------------------------------------

        function closeSuccessPopup() {

          if (!popup) {
            return;
          }


          popup.style.opacity = "0";


          setTimeout(function () {

            popup.remove();


            // =================================================
            // IMPORTANT
            // Remove ?success=1 from the browser URL.
            //
            // This prevents the success popup from appearing
            // again when the user refreshes the page.
            // =================================================

            const url =
              new URL(window.location.href);


            url.searchParams.delete("success");


            window.history.replaceState(
              {},
              document.title,
              url.pathname +
              url.search +
              url.hash
            );

          }, 200);

        }


        // -----------------------------------------------
        // CLOSE BUTTON
        // -----------------------------------------------

        if (closeButton) {

          closeButton.addEventListener(
            "click",
            closeSuccessPopup
          );

        }


        // -----------------------------------------------
        // OK BUTTON
        // -----------------------------------------------

        if (okButton) {

          okButton.addEventListener(
            "click",
            closeSuccessPopup
          );

        }


        // -----------------------------------------------
        // CLICK OUTSIDE POPUP
        // -----------------------------------------------

        if (popup) {

          popup.addEventListener(
            "click",
            function (event) {

              if (
                event.target === popup
              ) {

                closeSuccessPopup();

              }

            }
          );

        }


        // -----------------------------------------------
        // ESC KEY
        // -----------------------------------------------

        document.addEventListener(
          "keydown",
          function (event) {

            if (
              event.key === "Escape" &&
              popup
            ) {

              closeSuccessPopup();

            }

          }
        );

      }
    );

  </script>


</body>

</html>