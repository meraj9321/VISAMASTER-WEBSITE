<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8" />

  <meta
    name="viewport"
    content="width=device-width, initial-scale=1.0"
  />

  <title>Contact Us | VisaMaster</title>

  <!-- GLOBAL CSS -->
  <link rel="stylesheet" href="/css/global.css" />

  <!-- NAVBAR CSS -->
  <link rel="stylesheet" href="/css/navbar.css" />

  <!-- CONTACT PAGE CSS -->
  <link rel="stylesheet" href="/css/contact.css" />

  <!-- FOOTER CSS -->
  <link rel="stylesheet" href="/css/footer.css" />
</head>


<body>

  <!-- =========================================================
       NAVBAR
  ========================================================= -->

  <%- include("../partials/navbar") %>


  <main>

    <!-- =========================================================
         TOP SECTION
         HERO + ENQUIRY FORM
    ========================================================= -->

    <section class="contact-top-section">


      <!-- =====================================================
           HERO
      ====================================================== -->

      <div class="contact-hero">

        <!-- Decorative doodles -->

        <div class="contact-doodle contact-doodle-plane">
          ✈
        </div>

        <div class="contact-doodle contact-doodle-globe">
          🌍
        </div>

        <div class="contact-doodle contact-doodle-passport">
          🛂
        </div>


        <div class="contact-hero-content">

          <span class="contact-eyebrow">
            ✈ Let's Plan Your Journey
          </span>


          <h1>
            Let's Talk About
            <span>Your Visa Journey</span>
          </h1>


          <p>
            Planning your next international journey?
            Whether it's a tourist visa, business trip,
            student visa or something completely different,
            our VisaMaster team is here to guide you.
          </p>


          <!-- Small trust points -->

          <div class="contact-hero-points">

            <div class="contact-hero-point">
              Expert Visa Guidance
            </div>

            <div class="contact-hero-point">
              Document Assistance
            </div>

            <div class="contact-hero-point">
              Personal Support
            </div>

          </div>


          <!-- CTA -->

          <a
            href="#contact-form"
            class="contact-hero-btn"
          >
            Start Your Enquiry →
          </a>

        </div>

      </div>


      <!-- =====================================================
           ENQUIRY FORM
      ====================================================== -->

      <div
        class="contact-form-card"
        id="contact-form"
      >

        <div class="contact-section-heading">

          <span class="contact-eyebrow">
            📝 Quick Enquiry
          </span>


          <h2>
            Tell Us What
            <span>You Need</span>
          </h2>


          <p>
            Share your requirement and our team
            will get in touch with you.
          </p>

        </div>


        <!-- =================================================
             SERVER VALIDATION ERROR
        ================================================== -->

        <% if (typeof error !== "undefined" && error) { %>

          <div class="enquiry-error-message">

            <span>⚠</span>

            <p>
              <%= error %>
            </p>

          </div>

        <% } %>


        <!-- =================================================
             FORM
        ================================================== -->

        <form
          action="/contact"
          method="POST"
          class="visa-contact-form"
        >

          <!-- NAME + PHONE -->

          <div class="contact-form-row">

            <div class="form-group">

              <label for="name">
                Full Name
              </label>


              <input
                type="text"
                id="name"
                name="name"
                placeholder="Your name"
                autocomplete="off"
                value="<%= typeof formData !== 'undefined' && formData.name ? formData.name : '' %>"
                required
                
              />

            </div>


            <div class="form-group">

              <label for="phone">
                Phone
              </label>


              <input
                    type="tel"
                    id="phone"
                    name="phone"
                    placeholder="Your phone number"
                   autocomplete="off"
                   value="<%= typeof formData !== 'undefined' && formData.phone ? formData.phone : '' %>"
                    required
                    inputmode="numeric"
                    maxlength="10"
                    minlength="10"
                    pattern="[0-9]{10}"
                    oninput="this.value = this.value.replace(/[^0-9]/g, '').slice(0, 10)"
          />

            </div>

          </div>


          <!-- EMAIL + DESTINATION -->

          <div class="contact-form-row">

            <div class="form-group">

              <label for="email">
                Email
              </label>


              <input
                type="email"
                id="email"
                name="email"
                placeholder="Your email"
                autocomplete="off"
                value="<%= typeof formData !== 'undefined' && formData.email ? formData.email : '' %>"
                required
              />

            </div>


            <div class="form-group">

              <label for="destination">
                Destination
              </label>


              <select
                id="destination"
                name="destination"
                required
              >

                <option value="">
                  Select destination
                </option>


                <!-- =================================================
                     MONGODB DESTINATIONS
                ================================================== -->

                <% if (
                  typeof destinations !== "undefined" &&
                  destinations.length > 0
                ) { %>

                  <% destinations.forEach(destination => { %>

                    <option
                      value="<%= destination.slug || destination.name %>"
                      <%= (
                        typeof formData !== "undefined" &&
                        formData.destination === (
                          destination.slug || destination.name
                        )
                      ) ? "selected" : "" %>
                    >
                      <%= destination.name %>
                    </option>

                  <% }) %>


                <% } else { %>


                  <option
                    value="dubai"
                    <%= typeof formData !== "undefined" && formData.destination === "dubai" ? "selected" : "" %>
                  >
                    Dubai
                  </option>


                  <option
                    value="usa"
                    <%= typeof formData !== "undefined" && formData.destination === "usa" ? "selected" : "" %>
                  >
                    USA
                  </option>


                  <option
                    value="canada"
                    <%= typeof formData !== "undefined" && formData.destination === "canada" ? "selected" : "" %>
                  >
                    Canada
                  </option>


                  <option
                    value="uk"
                    <%= typeof formData !== "undefined" && formData.destination === "uk" ? "selected" : "" %>
                  >
                    United Kingdom
                  </option>


                  <option
                    value="australia"
                    <%= typeof formData !== "undefined" && formData.destination === "australia" ? "selected" : "" %>
                  >
                    Australia
                  </option>


                <% } %>

              </select>

            </div>

          </div>


          <!-- VISA TYPE -->

          <div class="form-group">

            <label for="visaType">
              Visa Type
            </label>


            <select
              id="visaType"
              name="visaType"
              required
            >

              <option value="">
                Select visa type
              </option>


              <option
                value="tourist"
                <%= typeof formData !== "undefined" && formData.visaType === "tourist" ? "selected" : "" %>
              >
                Tourist Visa
              </option>


              <option
                value="business"
                <%= typeof formData !== "undefined" && formData.visaType === "business" ? "selected" : "" %>
              >
                Business Visa
              </option>


              <option
                value="student"
                <%= typeof formData !== "undefined" && formData.visaType === "student" ? "selected" : "" %>
              >
                Student Visa
              </option>


              <option
                value="transit"
                <%= typeof formData !== "undefined" && formData.visaType === "transit" ? "selected" : "" %>
              >
                Transit Visa
              </option>


              <option
                value="family"
                <%= typeof formData !== "undefined" && formData.visaType === "family" ? "selected" : "" %>
              >
                Family / Visit Visa
              </option>


              <option
                value="other"
                <%= typeof formData !== "undefined" && formData.visaType === "other" ? "selected" : "" %>
              >
                Other
              </option>

            </select>

          </div>


          <!-- MESSAGE -->

          <div class="form-group">

            <label for="message">
              Your Message
            </label>


            <textarea
              id="message"
              name="message"
              rows="4"
              placeholder="Tell us about your requirement..."
              required
            ><%= typeof formData !== "undefined" && formData.message ? formData.message : "" %></textarea>

          </div>


          <!-- SUBMIT -->

          <button
            type="submit"
            class="contact-submit-btn"
          >
            Send Enquiry →
          </button>


          <p class="contact-form-note">
            🔒 Your information is kept private
            and used only to assist with your enquiry.
          </p>

        </form>

      </div>

    </section>


    <!-- =========================================================
         VISAMASTER TEAM
    ========================================================= -->

    <section class="contact-team-section">

      <div class="contact-container">


        <!-- TEAM HEADER -->

        <div class="contact-team-heading">

          <span class="contact-eyebrow">
            👋 Meet Our Team
          </span>


          <h2>
            The People Behind
            <span>VisaMaster</span>
          </h2>


          <p>
            Our dedicated team works together to make
            your visa journey simpler, clearer and smoother.
          </p>

        </div>


        <!-- =====================================================
             PARTNERS / BOSSES
        ====================================================== -->

        <div class="team-group">

          <div class="team-group-heading">

            <span class="team-group-icon">
              👔
            </span>


            <div>

              <h3>
                Partners
              </h3>

              <p>
                Leadership &amp; Business Partners
              </p>

            </div>

          </div>


          <div class="team-grid team-partners">

            <% if (
              typeof partners !== "undefined" &&
              partners.length > 0
            ) { %>


              <% partners.forEach((partner, index) => { %>

                <div class="team-card">


                  <!-- CARD NUMBER -->

                  <div class="team-card-number">
                    <%= String(index + 1).padStart(2, "0") %>
                  </div>


                  <!-- IMAGE -->

                  <div class="team-image-wrapper">

                    <% if (partner.image) { %>

                      <img
                        src="<%= partner.image %>"
                        alt="<%= partner.name %>"
                        loading="lazy"
                      />

                    <% } else { %>

                      <div class="team-placeholder">
                        👤
                      </div>

                    <% } %>

                  </div>


                  <!-- CONTENT -->

                  <div class="team-card-content">

                    <span class="team-role">
                      Partner
                    </span>


                    <h4>
                      <%= partner.name %>
                    </h4>


                    <% if (partner.designation) { %>

                      <p>
                        <%= partner.designation %>
                      </p>

                    <% } %>


                    <!-- CONTACT DETAILS -->

                    <div class="team-contact-list">

                      <% if (partner.phone) { %>

                        <a
                          href="tel:<%= partner.phone %>"
                          class="team-contact-link"
                          title="Call <%= partner.name %>"
                        >

                          <span class="team-contact-icon">
                            📞
                          </span>

                          <span>
                            <%= partner.phone %>
                          </span>

                        </a>

                      <% } %>


                      <% if (partner.email) { %>

                        <a
                          href="mailto:<%= partner.email %>"
                          class="team-contact-link"
                          title="Email <%= partner.name %>"
                        >

                          <span class="team-contact-icon">
                            ✉️
                          </span>

                          <span>
                            <%= partner.email %>
                          </span>

                        </a>

                      <% } %>

                    </div>


                    <!-- ACTION BUTTONS -->

                    <div class="team-contact-actions">


                      <% if (partner.phone) { %>

                        <a
                          href="tel:<%= partner.phone %>"
                          class="team-action-btn team-call-btn"
                          title="Call <%= partner.name %>"
                        >

                          <span>📞</span>
                          <span>Call</span>

                        </a>

                      <% } %>


                      <% if (partner.whatsapp || partner.phone) { %>

                        <%
                          const partnerWhatsApp =
                            partner.whatsapp || partner.phone;
                        %>

                        <a
                          href="https://wa.me/<%= String(partnerWhatsApp).replace(/\D/g, '') %>"
                          target="_blank"
                          rel="noopener noreferrer"
                          class="team-action-btn team-whatsapp-btn"
                          title="WhatsApp <%= partner.name %>"
                        >

                          <span>💬</span>
                          <span>WhatsApp</span>

                        </a>

                      <% } %>


                      <% if (partner.email) { %>

                        <a
                          href="mailto:<%= partner.email %>"
                          class="team-action-btn team-email-btn"
                          title="Email <%= partner.name %>"
                        >

                          <span>✉️</span>
                          <span>Email</span>

                        </a>

                      <% } %>


                    </div>

                  </div>

                </div>

              <% }) %>


            <% } %>

          </div>

        </div>


        <!-- =====================================================
