<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">

    <meta
        name="viewport"
        content="width=device-width, initial-scale=1.0"
    >

    <title>Team Management | VisaMaster</title>

    <link rel="stylesheet" href="/css/admin.css">

    <link
        rel="stylesheet"
        href="/css/admin-team.css"
    >
</head>

<body>

<div class="admin-layout">

    <!-- =====================================================
         SIDEBAR
    ====================================================== -->

    <%- include('../../partials/admin-sidebar', { currentPage: 'countries' }) %>
    <!-- =====================================================
         MAIN
    ====================================================== -->

    <main class="admin-main">

        <!-- TOPBAR -->

        <header class="admin-topbar">

            <div>
                <h1>Team Management</h1>

                <p>
                    Manage VisaMaster team members
                </p>
            </div>

            <a
                href="/admin/team/add"
                class="team-add-button"
            >
                + Add Team Member
            </a>

        </header>


        <!-- CONTENT -->

        <section class="admin-content">

            <!-- SUMMARY -->

            <div class="team-summary">

                <div class="team-summary-box">

                    <span class="team-summary-label">
                        Total Members
                    </span>

                    <strong>
                        <%= teamMembers.length %>
                    </strong>

                </div>


                <div class="team-summary-box">

                    <span class="team-summary-label">
                        Active Members
                    </span>

                    <strong>
                        <%= teamMembers.filter(member => member.active).length %>
                    </strong>

                </div>


                <div class="team-summary-box">

                    <span class="team-summary-label">
                        Inactive Members
                    </span>

                    <strong>
                        <%= teamMembers.filter(member => !member.active).length %>
                    </strong>

                </div>

            </div>


            <!-- TEAM TABLE -->

            <div class="team-table-card">

                <div class="team-table-header">

                    <div>
                        <h2>All Team Members</h2>

                        <p>
                            View and manage your team members.
                        </p>
                    </div>

                </div>


                <% if (teamMembers.length === 0) { %>

                    <div class="team-empty">

                        <div class="team-empty-icon">
                            👥
                        </div>

                        <h3>No Team Members Found</h3>

                        <p>
                            Add your first team member to get started.
                        </p>

                        <a
                            href="/admin/team/add"
                            class="team-add-button"
                        >
                            + Add Team Member
                        </a>

                    </div>

                <% } else { %>

                    <div class="team-table-wrapper">

                        <table class="team-table">

                            <thead>

                                <tr>

                                    <th>Member</th>

                                    <th>Role</th>

                                    <th>Contact</th>

                                    <th>Order</th>

                                    <th>Status</th>

                                    <th>Actions</th>

                                </tr>

                            </thead>

                            <tbody>

                                <% teamMembers.forEach(member => { %>

                                    <tr>

                                        <!-- MEMBER -->

                                        <td>

                                            <div class="team-member-cell">

                                                <% if (member.image) { %>

                                                    <img
                                                        src="<%= member.image %>"
                                                        alt="<%= member.name %>"
                                                        class="team-member-image"
                                                        loading="lazy"
                                                        onerror="this.style.display='none'; this.nextElementSibling.style.display='flex';"
                                                    >

                                                    <div
                                                        class="team-member-placeholder"
                                                        style="display: none;"
                                                    >
                                                        👤
                                                    </div>

                                                <% } else { %>

                                                    <div class="team-member-placeholder">
                                                        👤
                                                    </div>

                                                <% } %>


                                                <div class="team-member-info">

                                                    <strong>
                                                        <%= member.name %>
                                                    </strong>

                                                    <span>
                                                        <%= member.designation %>
                                                    </span>

                                                </div>

                                            </div>

                                        </td>


                                        <!-- ROLE -->

                                        <td>

                                            <% if (member.role === "partner") { %>

                                                <span class="team-role partner">
                                                    Partner
                                                </span>

                                            <% } else if (member.role === "accountant") { %>

                                                <span class="team-role accountant">
                                                    Accountant
                                                </span>

                                            <% } else { %>

                                                <span class="team-role executive">
                                                    Executive
                                                </span>

                                            <% } %>

                                        </td>


                                        <!-- CONTACT -->

                                        <td>

                                            <div class="team-contact">

                                                <span>
                                                    <%= member.phone %>
                                                </span>

                                                <span>
                                                    <%= member.email %>
                                                </span>

                                            </div>

                                        </td>


                                        <!-- ORDER -->

                                        <td>

                                            <span class="team-order">
                                                <%= member.order %>
                                            </span>

                                        </td>


                                        <!-- STATUS -->

                                        <td>

                                            <% if (member.active) { %>

                                                <span class="team-status active">
                                                    Active
                                                </span>

                                            <% } else { %>

                                                <span class="team-status inactive">
                                                    Inactive
                                                </span>

                                            <% } %>

                                        </td>


                                        <!-- ACTIONS -->

                                        <td>

                                            <div class="team-actions">

                                                <a
                                                    href="/admin/team/<%= member._id %>/edit"
                                                    class="team-action edit"
                                                >
                                                    Edit
                                                </a>


                                                <form
                                                    action="/admin/team/<%= member._id %>/toggle"
                                                    method="POST"
                                                >

                                                    <button
                                                        type="submit"
                                                        class="team-action toggle"
                                                    >
                                                        <%= member.active ? "Deactivate" : "Activate" %>
                                                    </button>

                                                </form>


                                                <form
                                                    action="/admin/team/<%= member._id %>/delete"
                                                    method="POST"
                                                    onsubmit="return confirm('Are you sure you want to delete this team member?');"
                                                >

                                                    <button
                                                        type="submit"
                                                        class="team-action delete"
                                                    >
                                                        Delete
                                                    </button>

                                                </form>

                                            </div>

                                        </td>

                                    </tr>

                                <% }); %>

                            </tbody>

                        </table>

                    </div>

                <% } %>

            </div>

        </section>

    </main>

</div>

</body>
</html>