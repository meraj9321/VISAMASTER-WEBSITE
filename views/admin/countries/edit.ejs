            <div class="form-group">

              <label>Icon</label>

              <input
                type="text"
                name="applicationProcess[<%= index %>][icon]"
                value="<%= item.icon || '' %>"
                placeholder="📝"
              >

            </div>


            <div class="form-group full-width">

              <label>Title</label>

              <input
                type="text"
                name="applicationProcess[<%= index %>][title]"
                value="<%= item.title || '' %>"
              >

            </div>


            <div class="form-group full-width">

              <label>Description</label>

              <textarea
                name="applicationProcess[<%= index %>][description]"
                rows="4"
              ><%= item.description || '' %></textarea>

            </div>

          </div>

        </div>

      <% }) %>

    </div>

  </section>



  <!-- =========================================
       FEES
  ========================================== -->

  <section class="admin-card">

    <div class="section-heading">

