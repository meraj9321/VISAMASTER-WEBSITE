
<%
const updatedAt = (value) =>
  value
    ? new Date(value).toLocaleString("en-IN", {
        dateStyle: "medium",
        timeStyle: "short"
      })
    : "Not updated yet";

const categoryDefaults = [
  { name: "E-Visa", slug: "e-visa" },
  { name: "Sticker Visa", slug: "sticker-visa" },
  { name: "Visa on Arrival", slug: "visa-on-arrival" }
];

const categories = categoryDefaults.map((item) => {
  const found = (country.visaCategories || []).find(
    (category) => category.slug === item.slug
  );

  return found || {
    ...item,
    isActive: true,
    subCategories: []
  };
});

const travelInfo = country.travelInfo || {};
%>

<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">

  <title>Edit <%= country.name %> | VisaMaster Admin</title>

  <link rel="stylesheet" href="/css/global.css">
  <link rel="stylesheet" href="/css/navbar.css">
  <link rel="stylesheet" href="/css/admin-country.css">

  <style>
    :root {
      --edit-navy: #102d50;
      --edit-gold: #d6a84f;
      --edit-cream: #f7f5ef;
      --edit-line: #dce3eb;
      --edit-muted: #64748b;
    }

    .edit-page {
      max-width: 1250px;
      margin: 0 auto;
      padding: 24px 18px 60px;
      color: #172b43;
    }

    .edit-top {
      display: flex;
      justify-content: space-between;
      align-items: center;
      gap: 18px;
      margin-bottom: 22px;
      padding: 22px 24px;
      background: var(--edit-navy);
      color: #fff;
      border-radius: 16px;
    }

    .edit-top h1 {
      margin: 4px 0;
      font-size: 25px;
    }

    .edit-top p {
      margin: 5px 0 0;
      color: #dbe5ef;
    }

    .edit-kicker {
      font-size: 11px;
      letter-spacing: 1.5px;
      font-weight: 800;
      color: #f0c66f;
    }

    .edit-back {
      display: inline-flex;
      align-items: center;
      padding: 10px 14px;
      border: 1px solid #ffffff55;
      border-radius: 9px;
      color: #fff;
      text-decoration: none;
      white-space: nowrap;
    }

    .edit-alert {
      padding: 12px 15px;
      margin: 0 0 18px;
      border-radius: 9px;
      background: #e8f7ed;
      color: #17653a;
      border: 1px solid #b8e4c7;
    }

    .edit-section {
      margin: 0 0 16px;
      border: 1px solid var(--edit-line);
      border-radius: 13px;
      background: #fff;
      overflow: hidden;
    }

    .edit-section > summary {
      list-style: none;
      cursor: pointer;
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 12px;
      padding: 16px 19px;
      background: #fbfcfd;
      font-weight: 800;
      color: var(--edit-navy);
    }

    .edit-section > summary::-webkit-details-marker {
      display: none;
    }

    .edit-section > summary:after {
      content: '＋';
      font-size: 19px;
      color: #b18432;
    }

    .edit-section[open] > summary:after {
      content: '−';
    }

    .section-hint {
      display: block;
      font-size: 12px;
      font-weight: 400;
      color: var(--edit-muted);
      margin-top: 3px;
    }

    .section-body {
      padding: 18px 19px;
      border-top: 1px solid var(--edit-line);
    }

    .edit-grid {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 13px 16px;
    }

    .edit-field {
      min-width: 0;
    }

    .edit-field.full {
      grid-column: 1 / -1;
    }

    .edit-field label {
      display: block;
      margin: 0 0 6px;
      font-size: 12px;
      font-weight: 750;
      color: #334b65;
    }

    .edit-field input,
    .edit-field textarea,
    .edit-field select {
      width: 100%;
      box-sizing: border-box;
      padding: 10px 11px;
      border: 1px solid #cbd5e1;
      border-radius: 8px;
      background: #fff;
      color: #172b43;
      font: inherit;
      font-size: 13px;
      outline: none;
    }

    .edit-field textarea {
      min-height: 82px;
      resize: vertical;
      line-height: 1.5;
    }

    .edit-field input:focus,
    .edit-field textarea:focus,
    .edit-field select:focus {
      border-color: #c99a3c;
      box-shadow: 0 0 0 3px #d6a84f22;
    }

    .edit-help {
      display: block;
      margin-top: 5px;
      font-size: 11px;
      color: var(--edit-muted);
    }

    .edit-updated {
      display: block;
      margin-top: 4px;
      font-size: 10px;
      color: #8492a3;
    }

    .category-card,
    .sub-card,
    .repeat-card {
      border: 1px solid var(--edit-line);
      border-radius: 11px;
      margin: 0 0 13px;
      background: #fff;
      overflow: hidden;
    }

    .category-head,
    .sub-head,
    .repeat-head {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 10px;
      padding: 12px 14px;
      background: #f7f9fb;
    }

    .category-head h3,
    .sub-head h4,
    .repeat-head h4 {
      margin: 0;
      color: var(--edit-navy);
      font-size: 14px;
    }

    .category-content,
    .sub-content,
    .repeat-content {
      padding: 14px;
    }

    .sub-card {
      margin-top: 12px;
      border-left: 3px solid var(--edit-gold);
    }

    .sub-head {
      background: #fffaf0;
    }

    .edit-btn {
      border: 0;
      border-radius: 7px;
      padding: 8px 11px;
      font-size: 12px;
      font-weight: 750;
      cursor: pointer;
      background: var(--edit-navy);
      color: #fff;
    }

    .edit-btn.secondary {
      background: #eaf0f6;
      color: var(--edit-navy);
      border: 1px solid #d7e0e9;
    }

    .edit-btn.danger {
      background: #fff0f0;
      color: #a52b2b;
      border: 1px solid #f2caca;
    }

    .edit-actions {
      display: flex;
      justify-content: flex-end;
      gap: 10px;
      flex-wrap: wrap;
      margin-top: 20px;
    }

    .save-btn {
      padding: 12px 22px;
      background: #c99a3c;
      color: #152b43;
      border: 0;
      border-radius: 9px;
      font-weight: 850;
      cursor: pointer;
    }

    .save-btn:hover {
      background: #e0b75f;
    }

    .pdf-panel {
      padding: 13px;
      border: 1px dashed #cbd5e1;
      border-radius: 10px;
      background: #fafbfd;
    }

    .pdf-actions {
      display: flex;
      gap: 9px;
      flex-wrap: wrap;
      margin-top: 10px;
    }

    .pdf-actions a {
      font-size: 12px;
      color: #1e5a91;
      text-decoration: underline;
    }

    .status-row {
      display: grid;
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 12px;
    }

    .status-box {
      padding: 12px;
      border: 1px solid var(--edit-line);
      border-radius: 9px;
    }

    .status-box label {
      display: block;
      font-size: 12px;
      font-weight: 750;
      margin-bottom: 7px;
    }

    .status-box select {
      width: 100%;
      padding: 9px;
      border: 1px solid #cbd5e1;
      border-radius: 7px;
      background: #fff;
    }

    .empty-note {
      font-size: 12px;
      color: var(--edit-muted);
      padding: 10px 0;
    }

    .edit-footer-note {
      font-size: 11px;
      color: var(--edit-muted);
      margin-top: 10px;
    }

    @media(max-width: 700px) {
      .edit-page {
        padding: 14px 10px 40px;
      }

      .edit-top {
        align-items: flex-start;
        flex-direction: column;
        padding: 18px;
      }

      .edit-grid,
      .status-row {
        grid-template-columns: 1fr;
      }

      .edit-section > summary {
        padding: 14px;
      }

      .section-body {
        padding: 13px;
      }

      .category-head,
      .sub-head {
        align-items: flex-start;
      }

      .edit-actions .save-btn {
        width: 100%;
      }
    }
  </style>
</head>

<body>

  <main class="edit-page">

    <!-- PAGE HEADER -->

    <header class="edit-top">

      <div>
        <span class="edit-kicker">
          VISAMASTER ADMIN · COUNTRY MANAGEMENT
        </span>

        <h1>Edit <%= country.name %></h1>

        <p>
          Manage country details, visa categories and travel information.
        </p>
      </div>

      <a class="edit-back" href="/admin/countries">
        ← Back to Countries
      </a>

    </header>

    <% if (typeof updated !== 'undefined' && updated) { %>

      <div class="edit-alert">
        Country information updated successfully.
      </div>

    <% } else if (typeof query !== 'undefined' && query.updated === 'true') { %>

      <div class="edit-alert">
        Country information updated successfully.
      </div>

    <% } %>


    <form
      id="countryEditForm"
      action="/admin/countries/<%= encodeURIComponent(country.slug) %>/edit"
      method="POST"
      enctype="multipart/form-data"
    >

      <!-- =================================================
           01. BASIC INFORMATION
      ================================================== -->

      <details class="edit-section" open>

        <summary>
          <span>
            01 · Basic Information
            <span class="section-hint">
              Country identity, images and descriptions
            </span>
          </span>
        </summary>

        <div class="section-body">

          <div class="edit-grid">

            <div class="edit-field">

              <label for="name">Country Name *</label>

              <input
                id="name"
                name="name"
                value="<%= country.name || '' %>"
                required
              >

              <small class="edit-updated">
                Updated: <%= updatedAt(country.fieldUpdatedAt?.name) %>
              </small>

            </div>

            <div class="edit-field">

              <label for="slug">Slug *</label>

              <input
                id="slug"
                name="slug"
                value="<%= country.slug || '' %>"
                required
              >

              <small class="edit-help">
                Example: united-arab-emirates
              </small>

              <small class="edit-updated">
                Updated: <%= updatedAt(country.fieldUpdatedAt?.slug) %>
              </small>

            </div>

            <div class="edit-field">

              <label for="countryCode">Country Code</label>

              <input
                id="countryCode"
                name="countryCode"
                value="<%= country.countryCode || '' %>"
                placeholder="AE"
              >

            </div>

            <div class="edit-field">

              <label for="flag">Flag Image Path / Emoji</label>

              <input
                id="flag"
                name="flag"
                value="<%= country.flag || '' %>"
                placeholder="/images/flags/uae.png"
              >

              <small class="edit-help">
                Use the existing image path or a flag emoji.
              </small>

            </div>

            <div class="edit-field">

              <label for="image">Country Image Path</label>

              <input
                id="image"
                name="image"
                value="<%= country.image || '' %>"
                placeholder="/images/countries/uae.jpg"
              >

            </div>

            <div class="edit-field">

              <label for="heroBadge">Hero Badge</label>

              <input
                id="heroBadge"
                name="heroBadge"
                value="<%= country.heroBadge || '' %>"
                placeholder="Popular Destination"
              >

            </div>

            <div class="edit-field full">

              <label for="shortDescription">
                Short Description
              </label>

              <textarea
                id="shortDescription"
                name="shortDescription"
                rows="2"
              ><%= country.shortDescription || '' %></textarea>

            </div>

            <div class="edit-field full">

              <label for="description">
                Full Description
              </label>

              <textarea
                id="description"
                name="description"
                rows="5"
              ><%= country.description || '' %></textarea>

            </div>

          </div>

        </div>

      </details>


      <!-- =================================================
           02. VISA CATEGORIES AND SUBCATEGORIES
      ================================================== -->

      <details class="edit-section" open>

        <summary>
          <span>
            02 · Visa Categories & Subcategories
            <span class="section-hint">
              Three fixed main categories; manage subcategories inside each one
            </span>
          </span>
        </summary>

        <div class="section-body">

          <div id="visaCategoriesContainer">

            <% categories.forEach((category, categoryIndex) => { %>

              <section class="category-card" data-category>

                <div class="category-head">

                  <div>
                    <h3><%= category.name %></h3>

                    <small class="edit-help">
                      <%= category.slug %>
                    </small>
                  </div>

                  <div class="edit-field" style="min-width:130px">

                    <label>Category Status</label>

                    <select name="visaCategories[<%= categoryIndex %>][isActive]">

                      <option
                        value="true"
                        <%= category.isActive !== false ? 'selected' : '' %>
                      >
                        Active
                      </option>

                      <option
                        value="false"
                        <%= category.isActive === false ? 'selected' : '' %>
                      >
                        Inactive
                      </option>

                    </select>

                  </div>

                </div>

                <input
                  type="hidden"
                  name="visaCategories[<%= categoryIndex %>][name]"
                  value="<%= category.name %>"
                >

                <input
                  type="hidden"
                  name="visaCategories[<%= categoryIndex %>][slug]"
                  value="<%= category.slug %>"
                >

                <div class="category-content">

                  <div class="subcategories-container" data-subcategories>

                    <% (category.subCategories || []).forEach((sub, subIndex) => { %>

                      <article class="sub-card" data-subcategory>

                        <div class="sub-head">

                          <h4>
                            Subcategory: <%= sub.name %>
                          </h4>

                          <button
                            type="button"
                            class="edit-btn danger"
                            data-remove-subcategory
                          >
                            Delete
                          </button>

                        </div>

                        <div class="sub-content">

                          <div class="edit-grid">

                            <div class="edit-field">

                              <label>Subcategory Name *</label>

                              <input
                                data-field="name"
                                name="visaCategories[<%= categoryIndex %>][subCategories][<%= subIndex %>][name]"
                                value="<%= sub.name || '' %>"
                                required
                              >

                            </div>

                            <div class="edit-field">

                              <label>Slug *</label>

                              <input
                                data-field="slug"
                                name="visaCategories[<%= categoryIndex %>][subCategories][<%= subIndex %>][slug]"
                                value="<%= sub.slug || '' %>"
                                required
                              >

                            </div>

                            <div class="edit-field full">

                              <label>Purpose</label>

                              <input
                                data-field="purpose"
                                name="visaCategories[<%= categoryIndex %>][subCategories][<%= subIndex %>][purpose]"
                                value="<%= sub.purpose || '' %>"
                              >

                            </div>

                            <div class="edit-field full">

                              <label>Description</label>

                              <textarea
                                data-field="description"
                                name="visaCategories[<%= categoryIndex %>][subCategories][<%= subIndex %>][description]"
                                rows="2"
                              ><%= sub.description || '' %></textarea>

                            </div>

                            <div class="edit-field">

                              <label>Eligibility · One item per line</label>

                              <textarea
                                data-field="eligibility"
                                name="visaCategories[<%= categoryIndex %>][subCategories][<%= subIndex %>][eligibility]"
                                rows="4"
                              ><%= (sub.eligibility || []).join('\n') %></textarea>

                            </div>

                            <div class="edit-field">

                              <label>Requirements · One item per line</label>

                              <textarea
                                data-field="requirements"
                                name="visaCategories[<%= categoryIndex %>][subCategories][<%= subIndex %>][requirements]"
                                rows="4"
                              ><%= (sub.requirements || []).join('\n') %></textarea>

                            </div>

                            <div class="edit-field">

                              <label>Subcategory Status</label>

                              <select
                                data-field="isActive"
                                name="visaCategories[<%= categoryIndex %>][subCategories][<%= subIndex %>][isActive]"
                              >

                                <option
                                  value="true"
                                  <%= sub.isActive !== false ? 'selected' : '' %>
                                >
                                  Active
                                </option>

                                <option
                                  value="false"
                                  <%= sub.isActive === false ? 'selected' : '' %>
                                >
                                  Inactive
                                </option>

                              </select>

                            </div>


                            <!-- SUBCATEGORY PDF -->

                            <div class="edit-field full">

                              <label>Application Form PDF</label>

                              <div class="pdf-panel">

                                <% if (sub.applicationForm && sub.applicationForm.filename) { %>

                                  <strong>Current PDF:</strong>

                                  <%= sub.applicationForm.filename %>

                                  <div class="pdf-actions">

                                    <a
                                      href="/countries/<%= encodeURIComponent(country.slug) %>/application-form/<%= encodeURIComponent(category.slug) %>/<%= encodeURIComponent(sub.slug) %>"
                                      target="_blank"
                                      rel="noopener"
                                    >
                                      View PDF
                                    </a>

                                    <a
                                      href="/countries/<%= encodeURIComponent(country.slug) %>/application-form/<%= encodeURIComponent(category.slug) %>/<%= encodeURIComponent(sub.slug) %>/download"
                                    >
                                      Download PDF
                                    </a>

                                    <button
                                      type="button"
                                      class="edit-btn danger"
                                      onclick="deleteSubcategoryPdf(
                                        '<%= country.slug %>',
                                        '<%= category.slug %>',
                                        '<%= sub.slug %>'
                                      )"
                                    >
                                      Delete PDF
                                    </button>

                                  </div>

                                <% } else { %>

                                  <span class="edit-help">
                                    No application form uploaded for this subcategory.
                                  </span>

                                <% } %>

                                <div class="edit-field" style="margin-top:14px">

                                  <label>
                                    <%= sub.applicationForm?.filename
                                      ? 'Replace Application Form PDF'
                                      : 'Upload Application Form PDF' %>
                                  </label>

                                  <input
                                    type="file"
                                    data-subcategory-pdf
                                    name="subcategoryPdf[<%= category.slug %>][<%= sub.slug %>]"
                                    accept="application/pdf,.pdf"
                                  >

                                  <small class="edit-help">
                                    PDF only · Maximum 5 MB.
                                    Existing PDF is retained if no new file is selected.
                                  </small>

                                </div>

                              </div>

                            </div>

                          </div>

                        </div>

                      </article>

                    <% }) %>

                  </div>

                  <button
                    type="button"
                    class="edit-btn secondary"
                    data-add-subcategory
                  >
                    ＋ Add Subcategory
                  </button>

                </div>

              </section>

            <% }) %>

          </div>

          <p class="edit-footer-note">
            The three main categories are fixed by your Country schema.
            You can activate/deactivate them and add, edit or delete their subcategories.
            Each subcategory can have its own application form PDF.
          </p>

        </div>

      </details>


      <!-- =================================================
           03. TRAVEL INFORMATION
      ================================================== -->

      <details class="edit-section">

        <summary>
          <span>
            03 · Travel Information
            <span class="section-hint">
              Destination details shown on the country page
            </span>
          </span>
        </summary>

        <div class="section-body">

          <div class="edit-grid">

            <div class="edit-field">

              <label>Best Time to Visit</label>

              <input
                name="travelInfo[bestTimeToVisit]"
                value="<%= travelInfo.bestTimeToVisit || '' %>"
              >

            </div>

            <div class="edit-field">

              <label>Currency</label>

              <input
                name="travelInfo[currency]"
                value="<%= travelInfo.currency || '' %>"
              >

            </div>

            <div class="edit-field">

              <label>Language</label>

              <input
                name="travelInfo[language]"
                value="<%= travelInfo.language || '' %>"
              >

            </div>

            <div class="edit-field">

              <label>Timezone</label>

              <input
                name="travelInfo[timezone]"
                value="<%= travelInfo.timezone || '' %>"
              >

            </div>

            <div class="edit-field">

              <label>Capital</label>

              <input
                name="travelInfo[capital]"
                value="<%= travelInfo.capital || '' %>"
              >

            </div>

            <div class="edit-field">

              <label>Flight Duration</label>

              <input
                name="travelInfo[flightDuration]"
                value="<%= travelInfo.flightDuration || '' %>"
              >

            </div>

            <div class="edit-field">

              <label>Time Difference</label>

              <input
                name="travelInfo[timeDifference]"
                value="<%= travelInfo.timeDifference || '' %>"
              >

            </div>

            <div class="edit-field">

              <label>Major Cities · One per line</label>

              <textarea
                name="travelInfo[majorCities]"
                rows="3"
              ><%= (travelInfo.majorCities || []).join('\n') %></textarea>

            </div>

            <div class="edit-field full">

              <label>Airport Information</label>

              <textarea
                name="travelInfo[airportInformation]"
                rows="3"
              ><%= travelInfo.airportInformation || '' %></textarea>

            </div>

          </div>

        </div>

      </details>


      <!-- =================================================
           04. TRAVEL TIPS AND NOTES
      ================================================== -->

      <details class="edit-section">

        <summary>
          <span>
            04 · Travel Tips & Important Notes
            <span class="section-hint">
              One item per line; each line is saved separately
            </span>
          </span>
        </summary>

        <div class="section-body">

          <div class="edit-grid">

            <div class="edit-field">

              <label>Travel Tips · One per line</label>

              <textarea
                name="travelTips"
                rows="7"
              ><%= (country.travelTips || []).join('\n') %></textarea>

            </div>

            <div class="edit-field">

              <label>Important Notes · One per line</label>

              <textarea
                name="importantNotes"
                rows="7"
              ><%= (country.importantNotes || []).join('\n') %></textarea>

            </div>

          </div>

        </div>

      </details>


      <!-- =================================================
           05. FAQS
      ================================================== -->

      <details class="edit-section">

        <summary>
          <span>
            05 · Frequently Asked Questions
            <span class="section-hint">
              Add or remove country-specific FAQs
            </span>
          </span>
        </summary>

        <div class="section-body">

          <div id="faqContainer">

            <% (country.faqs || []).forEach((faq, index) => { %>

              <article class="repeat-card" data-faq>

                <div class="repeat-head">

                  <h4>FAQ <%= index + 1 %></h4>

                  <button
                    type="button"
                    class="edit-btn danger"
                    data-remove-card
                  >
                    Remove
                  </button>

                </div>

                <div class="repeat-content edit-grid">

                  <div class="edit-field full">

                    <label>Question</label>

                    <input
                      data-faq-field="question"
                      name="faqs[<%= index %>][question]"
                      value="<%= faq.question || '' %>"
                    >

                  </div>

                  <div class="edit-field full">

                    <label>Answer</label>

                    <textarea
                      data-faq-field="answer"
                      name="faqs[<%= index %>][answer]"
                      rows="3"
                    ><%= faq.answer || '' %></textarea>

                  </div>

                </div>

              </article>

            <% }) %>

          </div>

          <button
            type="button"
            class="edit-btn secondary"
            id="addFaqBtn"
          >
            ＋ Add FAQ
          </button>

        </div>

      </details>


      <!-- =================================================
           06. COUNTRY CLASSIFICATION
      ================================================== -->

      <details class="edit-section">

        <summary>
          <span>
            06 · Country Classification
            <span class="section-hint">
              Schengen membership and country visibility
            </span>
          </span>
        </summary>

        <div class="section-body">

          <div class="status-row">

            <div class="status-box">

              <label>Schengen Country</label>

              <select name="isSchengen">

                <option
                  value="false"
                  <%= country.isSchengen ? '' : 'selected' %>
                >
                  No
                </option>

                <option
                  value="true"
                  <%= country.isSchengen ? 'selected' : '' %>
                >
                  Yes
                </option>

              </select>

            </div>

            <div class="status-box">

              <label>Country Status</label>

              <select name="isActive">

                <option
                  value="true"
                  <%= country.isActive !== false ? 'selected' : '' %>
                >
                  Active
                </option>

                <option
                  value="false"
                  <%= country.isActive === false ? 'selected' : '' %>
                >
                  Inactive
                </option>

              </select>

            </div>

          </div>

        </div>

      </details>


      <!-- SAVE BUTTONS -->

      <div class="edit-actions">

        <a
          class="edit-btn secondary"
          href="/admin/countries"
        >
          Cancel
        </a>

        <button type="submit" class="save-btn">
          Save Country Changes
        </button>

      </div>

    </form>

  </main>


  <!-- =====================================================
       JAVASCRIPT
  ====================================================== -->

  <script>

    const form = document.getElementById('countryEditForm');

    const visaCategoriesContainer =
      document.getElementById('visaCategoriesContainer');


    /* =====================================================
       REINDEX SUBCATEGORIES AND PDF INPUTS
    ====================================================== */

    function reindexSubcategories() {

      document.querySelectorAll('[data-category]').forEach(
        (categoryCard, categoryIndex) => {

          const activeSelect =
            categoryCard.querySelector('.category-head select');

          const categoryName =
            categoryCard.querySelector('input[name$="[name]"]');

          const categorySlugInput =
            categoryCard.querySelector('input[name$="[slug]"]');

          if (activeSelect) {
            activeSelect.name =
              `visaCategories[${categoryIndex}][isActive]`;
          }

          if (categoryName) {
            categoryName.name =
              `visaCategories[${categoryIndex}][name]`;
          }

          if (categorySlugInput) {
            categorySlugInput.name =
              `visaCategories[${categoryIndex}][slug]`;
          }

          const categorySlug =
            categorySlugInput?.value.trim() || '';

          categoryCard.querySelectorAll('[data-subcategory]').forEach(
            (subCard, subIndex) => {

              subCard.querySelectorAll('[data-field]').forEach((field) => {

                field.name =
                  `visaCategories[${categoryIndex}][subCategories][${subIndex}][${field.dataset.field}]`;

              });

              const subSlug =
                subCard.querySelector('[data-field="slug"]')?.value.trim() || '';

              const pdfInput =
                subCard.querySelector('[data-subcategory-pdf]');

              if (pdfInput) {

                pdfInput.name =
                  `subcategoryPdf[${categorySlug}][${subSlug}]`;

              }

              const heading =
                subCard.querySelector('.sub-head h4');

              const nameInput =
                subCard.querySelector('[data-field="name"]');

              if (heading && nameInput) {

                heading.textContent =
                  `Subcategory: ${nameInput.value || 'New subcategory'}`;

              }

            }
          );

        }
      );

    }


    /* =====================================================
       REINDEX FAQS
    ====================================================== */

    function reindexFaqs() {

      document.querySelectorAll('[data-faq]').forEach(
        (card, index) => {

          card.querySelectorAll('[data-faq-field]').forEach((field) => {

            field.name =
              `faqs[${index}][${field.dataset.faqField}]`;

          });

          const heading =
            card.querySelector('.repeat-head h4');

          if (heading) {
            heading.textContent = `FAQ ${index + 1}`;
          }

        }
      );

    }


    /* =====================================================
       CREATE NEW SUBCATEGORY
    ====================================================== */

    function createSubcategoryCard() {

      const card = document.createElement('article');

      card.className = 'sub-card';

      card.setAttribute('data-subcategory', '');

      card.innerHTML = `

        <div class="sub-head">

          <h4>New subcategory</h4>

          <button
            type="button"
            class="edit-btn danger"
            data-remove-subcategory
          >
            Delete
          </button>

        </div>

        <div class="sub-content">

          <div class="edit-grid">

            <div class="edit-field">
              <label>Subcategory Name *</label>
              <input data-field="name" required>
            </div>

            <div class="edit-field">
              <label>Slug *</label>
              <input
                data-field="slug"
                required
                placeholder="tourist-visa"
              >
            </div>

            <div class="edit-field full">
              <label>Purpose</label>
              <input data-field="purpose">
            </div>

            <div class="edit-field full">
              <label>Description</label>
              <textarea data-field="description" rows="2"></textarea>
            </div>

            <div class="edit-field">
              <label>Eligibility · One item per line</label>
              <textarea data-field="eligibility" rows="4"></textarea>
            </div>

            <div class="edit-field">
              <label>Requirements · One item per line</label>
              <textarea data-field="requirements" rows="4"></textarea>
            </div>

            <div class="edit-field">
              <label>Subcategory Status</label>
              <select data-field="isActive">
                <option value="true" selected>Active</option>
                <option value="false">Inactive</option>
              </select>
            </div>

            <div class="edit-field full">

              <label>Application Form PDF</label>

              <div class="pdf-panel">

                <span class="edit-help">
                  No application form uploaded yet.
                </span>

                <div class="edit-field" style="margin-top:14px">

                  <label>Upload Application Form PDF</label>

                  <input
                    type="file"
                    data-subcategory-pdf
                    accept="application/pdf,.pdf"
                  >

                  <small class="edit-help">
                    PDF only · Maximum 5 MB.
                  </small>

                </div>

              </div>

            </div>

          </div>

        </div>

      `;

      return card;

    }


    /* =====================================================
       ADD / DELETE SUBCATEGORIES
    ====================================================== */

    visaCategoriesContainer.addEventListener('click', (event) => {

      const addButton =
        event.target.closest('[data-add-subcategory]');

      const removeButton =
        event.target.closest('[data-remove-subcategory]');


      if (addButton) {

        const category =
          addButton.closest('[data-category]');

        category
          .querySelector('[data-subcategories]')
          .appendChild(createSubcategoryCard());

        reindexSubcategories();

      }


      if (removeButton) {

        const card =
          removeButton.closest('[data-subcategory]');

        const name =
          card.querySelector('[data-field="name"]')?.value ||
          'this subcategory';

        if (
          window.confirm(
            `Delete ${name}? This will remove it when you save the country.`
          )
        ) {

          card.remove();

          reindexSubcategories();

        }

      }

    });


    /* =====================================================
       UPDATE SUBCATEGORY NAME AND SLUG
    ====================================================== */

    visaCategoriesContainer.addEventListener('input', (event) => {

      if (
        event.target.matches('[data-field="name"]') ||
        event.target.matches('[data-field="slug"]')
      ) {

        reindexSubcategories();

      }

    });


    /* =====================================================
       ADD / DELETE FAQS
    ====================================================== */

    document.getElementById('faqContainer').addEventListener(
      'click',
      (event) => {

        const removeButton =
          event.target.closest('[data-remove-card]');

        if (removeButton) {

          if (window.confirm('Remove this FAQ?')) {

            removeButton.closest('[data-faq]').remove();

            reindexFaqs();

          }

        }

      }
    );


    document.getElementById('addFaqBtn').addEventListener(
      'click',
      () => {

        const index =
          document.querySelectorAll('[data-faq]').length;

        const card =
          document.createElement('article');

        card.className = 'repeat-card';

        card.setAttribute('data-faq', '');

        card.innerHTML = `

          <div class="repeat-head">

            <h4>FAQ ${index + 1}</h4>

            <button
              type="button"
              class="edit-btn danger"
              data-remove-card
            >
              Remove
            </button>

          </div>

          <div class="repeat-content edit-grid">

            <div class="edit-field full">

              <label>Question</label>

              <input data-faq-field="question">

            </div>

            <div class="edit-field full">

              <label>Answer</label>

              <textarea
                data-faq-field="answer"
                rows="3"
              ></textarea>

            </div>

          </div>

        `;

        document.getElementById('faqContainer').appendChild(card);

        reindexFaqs();

      }
    );


    /* =====================================================
       DELETE INDIVIDUAL SUBCATEGORY PDF
    ====================================================== */

    async function deleteSubcategoryPdf(
      countrySlug,
      categorySlug,
      subCategorySlug
    ) {

      if (
        !window.confirm(
          'Delete this subcategory application form PDF? This cannot be undone.'
        )
      ) {
        return;
      }

      try {

        const url =
          `/admin/countries/${encodeURIComponent(countrySlug)}` +
          `/application-form/${encodeURIComponent(categorySlug)}` +
          `/${encodeURIComponent(subCategorySlug)}/delete`;

        const response = await fetch(url, {

          method: 'POST',

          headers: {
            Accept: 'application/json'
          },

          credentials: 'same-origin'

        });

        const result = await response.json();

        if (!response.ok) {

          throw new Error(
            result.message || 'Failed to delete PDF.'
          );

        }

        alert(result.message || 'PDF deleted successfully.');

        window.location.reload();

      } catch (error) {

        alert(
          error.message || 'Unable to delete PDF. Please try again.'
        );

      }

    }

    window.deleteSubcategoryPdf = deleteSubcategoryPdf;


    /* =====================================================
       FORM SUBMISSION VALIDATION
    ====================================================== */

    form.addEventListener('submit', (event) => {

      reindexSubcategories();

      reindexFaqs();

      const pdfInputs =
        document.querySelectorAll('[data-subcategory-pdf]');


      for (const input of pdfInputs) {

        if (!input.files || !input.files.length) {
          continue;
        }

        const file = input.files[0];

        const isPdfName = /\.pdf$/i.test(file.name || '');

        if (
          !isPdfName ||
          file.type !== 'application/pdf'
        ) {

          event.preventDefault();

          alert('Please select PDF files only.');

          input.focus();

          return;

        }


        if (file.size > 5 * 1024 * 1024) {

          event.preventDefault();

          alert('Each PDF file must be 5 MB or smaller.');

          input.focus();

          return;

        }

      }


      if (!window.confirm('Save all changes to this country?')) {

        event.preventDefault();

      }

    });


    /* =====================================================
       INITIAL REINDEX
    ====================================================== */

    reindexSubcategories();

    reindexFaqs();

  </script>

</body>
</html>
