</label>' + '<input type="text" name="visaTypes[' + index + '][purpose]">' + '</div>' + '<div class="form-group full-width visa-directory-categories">' + '<label>Visa Directory Categories</label>' + '<small>Select every category where this visa should appear on the public Visas page.</small>' + '<div class="visa-directory-category-options">' + '<label class="checkbox-label"><input type="checkbox" name="visaTypes[' + index + '][categories][]" value="e-visa"> E-Visa</label>' + '<label class="checkbox-label"><input type="checkbox" name="visaTypes[' + index + '][categories][]" value="tourist-visa"> Tourist Visa</label>' + '<label class="checkbox-label"><input type="checkbox" name="visaTypes[' + index + '][categories][]" value="visa-on-arrival"> Visa on Arrival</label>' + '<label class="checkbox-label"><input type="checkbox" name="visaTypes[' + index + '][categories][]" value="business-visa"> Business Visa</label>' + '<label class="checkbox-label"><input type="checkbox" name="visaTypes[' + index + '][categories][]" value="stamping-visa"> Stamping Visa</label>' + '<label class="checkbox-label"><input type="checkbox" name="visaTypes[' + index + '][categories][]" value="sticker-visa"> Sticker Visa</label>' + '</div>' + '</div>' + '<div class="form-group">' + '<label>Stay Duration</label>' + '<input type="text" name="visaTypes[' + index + '][stayDuration]">' + '</div>' + '<div class="form-group">' + '<label>Validity</label>' + '<input type="text" name="visaTypes[' + index + '][validity]">' + '</div>' + '<div class="form-group">' + '<label>Processing Time</label>' + '<input type="text" name="visaTypes[' + index + '][processingTime]">' + '</div>' + '<div class="form-group">' + '<label>Entry Type</label>' + '<input type="text" name="visaTypes[' + index + '][entryType]">' + '</div>' + '<div class="form-group">' + '<label>Government Fee</label>' + '<input type="text" name="visaTypes[' + index + '][governmentFee]">' + '</div>' + '<div class="form-group">' + '<label>Service Fee</label>' + '<input type="text" name="visaTypes[' + index + '][serviceFee]">' + '</div>' + '<div class="form-group">' + '<label>Total Fee</label>' + '<input type="text" name="visaTypes[' + index + '][totalFee]">' + '</div>' + '<div class="form-group full-width">' + '<label>Description</label>' + '<textarea name="visaTypes[' + index + '][description]" rows="3"></textarea>' +
