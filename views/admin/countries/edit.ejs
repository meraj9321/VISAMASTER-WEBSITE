<%
function formatUpdatedAt(value) {
if (!value) {
return "Not updated yet";
}

return new Date(value).toLocaleString("en-IN", {
  dateStyle: "medium",
  timeStyle: "short"
});

}
%>

<!DOCTYPE html> <html lang="en"> <head> <meta charset="UTF-8"> <meta name="viewport" content="width=device-width, initial-scale=1.0"> <title>Edit Country | VisaMaster Admin</title> <link rel="stylesheet" href="/css/global.css"> <link rel="stylesheet" href="/css/navbar.css"> <link rel="stylesheet" href="/css/admin-country.css"> 
<style>
 .vm-rich-editor{border:1px solid #cbd5e1;border-radius:10px;overflow:hidden;background:#fff}.vm-editor-toolbar{display:flex;align-items:center;flex-wrap:wrap;gap:6px;padding:9px;background:#f1f5f9;border-bottom:1px solid #cbd5e1}.vm-editor-toolbar button,.vm-editor-toolbar select,.vm-editor-toolbar input[type="color"]{border:1px solid #cbd5e1;border-radius:6px;background:#fff;min-height:32px;padding:5px 8px;cursor:pointer;color:#102d50}.vm-editor-toolbar button:hover{background:#e2e8f0}.vm-editor-toolbar .vm-tool-separator{width:1px;height:26px;background:#cbd5e1;margin:0 3px}.vm-editor-toolbar label{display:inline-flex;align-items:center;gap:4px;font-size:12px;color:#334155}.vm-editor-toolbar input[type="color"]{width:38px;padding:3px}.vm-editor-content{min-height:150px;padding:12px;outline:none;line-height:1.6;color:#1e293b;overflow-wrap:anywhere}.vm-editor-content:empty:before{content:attr(data-placeholder);color:#94a3b8}.vm-editor-content ul,.vm-editor-content ol{padding-left:26px}.vm-editor-content h1,.vm-editor-content h2,.vm-editor-content h3,.vm-editor-content h4{margin:8px 0;line-height:1.3}.vm-editor-content p{margin:0 0 8px}.vm-editor-content a{color:#2563eb;text-decoration:underline}
</style>
</head> <body> <div class="admin-page"> <header class="admin-header"> <div class="admin-header-inner">
  <div>
    <span class="admin-label">VISAMASTER ADMIN</span>

    <h1>Edit Country</h1>

    <p>
      Update country, visa and travel information.
    </p>
  </div>

  <a href="/admin/countries" class="back-button">
    ← Back to Countries
  </a>

</div>
</header> <main class="admin-container">
<form
  id="countryEditForm"
  action="/admin/countries/<%= country.slug %>/edit"
  method="POST" enctype="multipart/form-data"
>


  <!-- =========================================
       BASIC INFORMATION
  ========================================== -->

  <section class="admin-card">

    <div class="section-heading">

      <div>
        <span class="section-number">01</span>

        <h2>Basic Information</h2>

        <p>
          Main information about the country.
        </p>
      </div>

    </div>


    <div class="form-grid">


      <div class="form-group">

        <label for="name">
          Country Name
        </label>

        <input
          type="text"
          id="name"
          name="name"
          value="<%= country.name || '' %>"
          required
        >

        <small class="field-updated">
          Last updated:
          <%= formatUpdatedAt(country.fieldUpdatedAt?.name) %>
        </small>

      </div>


      <div class="form-group">

        <label for="slug">
          Slug
        </label>

        <input
          type="text"
          id="slug"
          name="slug"
          value="<%= country.slug || '' %>"
          required
        >

        <small>
          Example: united-arab-emirates
        </small>

        <small class="field-updated">
          Last updated:
          <%= formatUpdatedAt(country.fieldUpdatedAt?.slug) %>
        </small>

      </div>


      <div class="form-group">

        <label for="countryCode">
          Country Code
        </label>

        <input
          type="text"
          id="countryCode"
          name="countryCode"
          value="<%= country.countryCode || '' %>"
          placeholder="AE"
        >

        <small class="field-updated">
          Last updated:
          <%= formatUpdatedAt(country.fieldUpdatedAt?.countryCode) %>
        </small>

      </div>


      <div class="form-group">

        <label for="flag">
          Flag
        </label>

        <input
          type="text"
          id="flag"
          name="flag"
          value="<%= country.flag || '' %>"
          placeholder="🇦🇪"
        >

        <small class="field-updated">
          Last updated:
          <%= formatUpdatedAt(country.fieldUpdatedAt?.flag) %>
        </small>

      </div>


      <div class="form-group full-width">

        <label for="image">
          Country Image
        </label>

        <input
          type="text"
          id="image"
          name="image"
          value="<%= country.image || '' %>"
          placeholder="/images/countries/uae.jpg"
        >

        <small class="field-updated">
          Last updated:
          <%= formatUpdatedAt(country.fieldUpdatedAt?.image) %>
        </small>

      </div>


      <div class="form-group full-width">

        <label for="shortDescription">
          Short Description
        </label>

        <textarea
          id="shortDescription"
          name="shortDescription"
          rows="3"
        ><%= country.shortDescription || '' %></textarea>

        <small class="field-updated">
          Last updated:
          <%= formatUpdatedAt(country.fieldUpdatedAt?.shortDescription) %>
        </small>

      </div>


      <div class="form-group full-width">

        <label for="description">
          Full Description
        </label>

        <textarea
          id="description"
          name="description"
          rows="5"
        ><%= country.description || '' %></textarea>

        <small class="field-updated">
          Last updated:
          <%= formatUpdatedAt(country.fieldUpdatedAt?.description) %>
        </small>

      </div>


      <div class="form-group">

        <label for="startingFee">
          Starting Fee
        </label>

        <input
          type="text"
          id="startingFee"
          name="startingFee"
          value="<%= country.startingFee || '' %>"
          placeholder="₹7,500*"
        >

        <small class="field-updated">
          Last updated:
          <%= formatUpdatedAt(country.fieldUpdatedAt?.startingFee) %>
        </small>

      </div>


      <div class="form-group">

        <label for="startingProcessingTime">
          Starting Processing Time
        </label>

        <input
          type="text"
          id="startingProcessingTime"
          name="startingProcessingTime"
          value="<%= country.startingProcessingTime || '' %>"
          placeholder="3–5 Working Days*"
        >

        <small class="field-updated">
          Last updated:
          <%= formatUpdatedAt(country.fieldUpdatedAt?.startingProcessingTime) %>
        </small>

      </div>


      <div class="form-group full-width">

        <label for="heroBadge">
          Hero Badge
        </label>

        <input
          type="text"
          id="heroBadge"
          name="heroBadge"
          value="<%= country.heroBadge || '' %>"
          placeholder="Popular Travel Destination"
        >

        <small class="field-updated">
          Last updated:
          <%= formatUpdatedAt(country.fieldUpdatedAt?.heroBadge) %>
        </small>

      </div>

    </div>

  </section>



  <!-- =========================================
       VISA TYPES
  ========================================== -->

  <section class="admin-card">

    <div class="section-heading">

      <div>
        <span class="section-number">02</span>

        <h2>Visa Types</h2>

        <p>
          Add or edit visa categories for this country.
        </p>
      </div>

      <button
        type="button"
        class="add-button"
        onclick="addVisaType()"
      >
        + Add Visa
      </button>

    </div>


    <div id="visaTypesContainer">

      <% (country.visaTypes || []).forEach((visa, index) => { %>

        <div class="dynamic-card visa-card">

          <div class="dynamic-card-header">

            <h3>
              Visa Type
              <span class="visa-number">
                <%= index + 1 %>
              </span>
            </h3>

            <button
              type="button"
              class="remove-button"
              onclick="removeCard(this)"
            >
              Remove
            </button>

          </div>


          <div class="form-grid">


            <div class="form-group">

              <label>Visa Name</label>

              <input
                type="text"
                name="visaTypes[<%= index %>][name]"
                value="<%= visa.name || '' %>"
              >

              <small class="field-updated">
                Last updated:
                <%= formatUpdatedAt(country.fieldUpdatedAt?.visaTypes) %>
              </small>

            </div>


            <div class="form-group">

              <label>Visa Slug</label>

              <input
                type="text"
                name="visaTypes[<%= index %>][slug]"
                value="<%= visa.slug || '' %>"
              >

            </div>


            <div class="form-group">

              <label>Purpose</label>

              <input
                type="text"
                name="visaTypes[<%= index %>][purpose]"
                value="<%= visa.purpose || '' %>"
              >

            </div>


            <div class="form-group full-width visa-directory-categories">
              <label>Visa Directory Categories</label>
              <small>Select every category where this visa should appear on the public Visas page.</small>
              <div class="visa-directory-category-options">
                <% [
                  ["e-visa", "E-Visa"],
                  ["tourist-visa", "Tourist Visa"],
                  ["visa-on-arrival", "Visa on Arrival"],
                  ["business-visa", "Business Visa"],
                  ["stamping-visa", "Stamping Visa"],
                  ["sticker-visa", "Sticker Visa"],
                ].forEach(([value, label]) => { %>
                  <label class="checkbox-label">
                    <input
                      type="checkbox"
                      name="visaTypes[<%= index %>][categories][]"
                      value="<%= value %>"
                      <%= Array.isArray(visa.categories) && visa.categories.includes(value) ? "checked" : "" %>
                    >
                    <%= label %>
                  </label>
                <% }) %>
              </div>
            </div>

            <div class="form-group">

              <label>Stay Duration</label>

              <input
                type="text"
                name="visaTypes[<%= index %>][stayDuration]"
                value="<%= visa.stayDuration || '' %>"
              >

            </div>


            <div class="form-group">

              <label>Validity</label>

              <input
                type="text"
                name="visaTypes[<%= index %>][validity]"
                value="<%= visa.validity || '' %>"
              >

            </div>


            <div class="form-group">

              <label>Processing Time</label>

              <input
                type="text"
                name="visaTypes[<%= index %>][processingTime]"
                value="<%= visa.processingTime || '' %>"
              >

            </div>


            <div class="form-group">

              <label>Entry Type</label>

              <input
                type="text"
                name="visaTypes[<%= index %>][entryType]"
                value="<%= visa.entryType || '' %>"
              >

            </div>


            <div class="form-group">

              <label>Government Fee</label>

              <input
                type="text"
                name="visaTypes[<%= index %>][governmentFee]"
                value="<%= visa.governmentFee || '' %>"
              >

            </div>


            <div class="form-group">

              <label>Service Fee</label>

              <input
                type="text"
                name="visaTypes[<%= index %>][serviceFee]"
                value="<%= visa.serviceFee || '' %>"
              >

            </div>


            <div class="form-group">

              <label>Total Fee</label>

              <input
                type="text"
                name="visaTypes[<%= index %>][totalFee]"
                value="<%= visa.totalFee || '' %>"
              >

            </div>


            <div class="form-group full-width">

              <label>Description</label>

              <textarea
                name="visaTypes[<%= index %>][description]"
                rows="3"
              ><%= visa.description || '' %></textarea>

            </div>


            <div class="form-group full-width">

              <label>Eligibility</label>

              <input type="hidden" name="visaTypes[<%= index %>][eligibility]" value="">
              <div class="vm-rich-editor" data-field="visaTypes[<%= index %>][eligibility]">
                <div class="vm-editor-toolbar" role="toolbar" aria-label="Eligibility formatting">
                  <button type="button" data-command="bold" title="Bold"><b>B</b></button>
                  <button type="button" data-command="italic" title="Italic"><i>I</i></button>
                  <button type="button" data-command="underline" title="Underline"><u>U</u></button>
                  <button type="button" data-command="strikeThrough" title="Strikethrough"><s>S</s></button>
                  <span class="vm-tool-separator"></span>
                  <select data-command="fontName" aria-label="Font family" title="Font family">
                    <option value="Arial">Arial</option><option value="Georgia">Georgia</option><option value="Times New Roman">Times New Roman</option><option value="Verdana">Verdana</option><option value="Tahoma">Tahoma</option><option value="Courier New">Courier New</option>
                  </select>
                  <select data-command="fontSize" aria-label="Font size" title="Font size">
                    <option value="2">Small</option><option value="3" selected>Normal</option><option value="4">Large</option><option value="5">X-Large</option><option value="6">XX-Large</option><option value="7">Huge</option>
                  </select>
                  <label title="Text colour">Text <input type="color" data-command="foreColor" value="#1e293b" aria-label="Text colour"></label>
                  <label title="Highlight colour">Highlight <input type="color" data-command="hiliteColor" value="#fff176" aria-label="Highlight colour"></label>
                  <span class="vm-tool-separator"></span>
                  <button type="button" data-command="justifyLeft" title="Align left">⇤ Left</button>
                  <button type="button" data-command="justifyCenter" title="Align center">☰ Center</button>
                  <button type="button" data-command="justifyRight" title="Align right">⇥ Right</button>
                  <button type="button" data-command="justifyFull" title="Justify">☷ Justify</button>
                  <span class="vm-tool-separator"></span>
                  <select data-command="formatBlock" aria-label="Text style" title="Paragraph / heading">
                    <option value="p">Paragraph</option><option value="h1">Heading 1</option><option value="h2">Heading 2</option><option value="h3">Heading 3</option><option value="h4">Heading 4</option><option value="blockquote">Quote</option>
                  </select>
                  <button type="button" data-command="insertUnorderedList" title="Bulleted list">• Bullets</button>
                  <button type="button" data-command="insertOrderedList" title="Numbered list">1. Numbering</button>
                  <button type="button" data-command="outdent" title="Decrease indent">← Indent</button>
                  <button type="button" data-command="indent" title="Increase indent">Indent →</button>
                  <button type="button" data-command="superscript" title="Superscript">x²</button>
                  <button type="button" data-command="subscript" title="Subscript">x₂</button>
                  <button type="button" data-command="createLink" data-prompt="link" title="Insert link">Link</button>
                  <button type="button" data-command="unlink" title="Remove link">Unlink</button>
                  <button type="button" data-command="undo" title="Undo">↶</button>
                  <button type="button" data-command="redo" title="Redo">↷</button>
                  <button type="button" data-command="removeFormat" title="Clear inline formatting">Clear format</button>
                </div>
                <div class="vm-editor-content" contenteditable="true" data-placeholder="Write eligibility requirements..."><%- (Array.isArray(visa.eligibility) ? visa.eligibility : [visa.eligibility || '']).filter(Boolean).map(v => /<\/?(p|br|b|strong|i|em|u|ul|ol|li|h[1-6])\b/i.test(v) ? v : '<p>' + String(v).replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;') + '</p>').join('') %></div>
              </div>
              <small>Use the toolbar to format text. It will be saved with the visa.</small>

            </div>


            <div class="form-group full-width">

              <label>Documents</label>

              <input type="hidden" name="visaTypes[<%= index %>][documents]" value="">
              <div class="vm-rich-editor" data-field="visaTypes[<%= index %>][documents]">
                <div class="vm-editor-toolbar" role="toolbar" aria-label="Documents formatting">
                  <button type="button" data-command="bold" title="Bold"><b>B</b></button>
                  <button type="button" data-command="italic" title="Italic"><i>I</i></button>
                  <button type="button" data-command="underline" title="Underline"><u>U</u></button>
                  <button type="button" data-command="strikeThrough" title="Strikethrough"><s>S</s></button>
                  <span class="vm-tool-separator"></span>
                  <select data-command="fontName" aria-label="Font family" title="Font family">
                    <option value="Arial">Arial</option><option value="Georgia">Georgia</option><option value="Times New Roman">Times New Roman</option><option value="Verdana">Verdana</option><option value="Tahoma">Tahoma</option><option value="Courier New">Courier New</option>
                  </select>
                  <select data-command="fontSize" aria-label="Font size" title="Font size">
                    <option value="2">Small</option><option value="3" selected>Normal</option><option value="4">Large</option><option value="5">X-Large</option><option value="6">XX-Large</option><option value="7">Huge</option>
                  </select>
                  <label title="Text colour">Text <input type="color" data-command="foreColor" value="#1e293b" aria-label="Text colour"></label>
                  <label title="Highlight colour">Highlight <input type="color" data-command="hiliteColor" value="#fff176" aria-label="Highlight colour"></label>
                  <span class="vm-tool-separator"></span>
                  <button type="button" data-command="justifyLeft" title="Align left">⇤ Left</button>
                  <button type="button" data-command="justifyCenter" title="Align center">☰ Center</button>
                  <button type="button" data-command="justifyRight" title="Align right">⇥ Right</button>
                  <button type="button" data-command="justifyFull" title="Justify">☷ Justify</button>
                  <span class="vm-tool-separator"></span>
                  <select data-command="formatBlock" aria-label="Text style" title="Paragraph / heading">
                    <option value="p">Paragraph</option><option value="h1">Heading 1</option><option value="h2">Heading 2</option><option value="h3">Heading 3</option><option value="h4">Heading 4</option><option value="blockquote">Quote</option>
                  </select>
                  <button type="button" data-command="insertUnorderedList" title="Bulleted list">• Bullets</button>
                  <button type="button" data-command="insertOrderedList" title="Numbered list">1. Numbering</button>
                  <button type="button" data-command="outdent" title="Decrease indent">← Indent</button>
                  <button type="button" data-command="indent" title="Increase indent">Indent →</button>
                  <button type="button" data-command="superscript" title="Superscript">x²</button>
                  <button type="button" data-command="subscript" title="Subscript">x₂</button>
                  <button type="button" data-command="createLink" data-prompt="link" title="Insert link">Link</button>
                  <button type="button" data-command="unlink" title="Remove link">Unlink</button>
                  <button type="button" data-command="undo" title="Undo">↶</button>
                  <button type="button" data-command="redo" title="Redo">↷</button>
                  <button type="button" data-command="removeFormat" title="Clear inline formatting">Clear format</button>
                </div>
                <div class="vm-editor-content" contenteditable="true" data-placeholder="Write documents required..."><%- (Array.isArray(visa.documents) ? visa.documents : [visa.documents || '']).filter(Boolean).map(v => /<\/?(p|br|b|strong|i|em|u|ul|ol|li|h[1-6])\b/i.test(v) ? v : '<p>' + String(v).replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;') + '</p>').join('') %></div>
              </div>
              <small>Use the toolbar to format text. It will be saved with the visa.</small>

            </div>


            <div class="form-group">

              <label class="checkbox-label">

                <input
                  type="checkbox"
                  name="visaTypes[<%= index %>][isActive]"
                  value="true"
                  <%= visa.isActive !== false ? "checked" : "" %>
                >

                Visa is Active

              </label>

            </div>

          </div>

        </div>

      <% }) %>

    </div>

  </section>



  <!-- =========================================
       REQUIREMENTS
  ========================================== -->

  <section class="admin-card">

    <div class="section-heading">

      <div>
        <span class="section-number">03</span>

        <h2>Requirements</h2>

        <p>
          Documents and requirements for this country.
        </p>
      </div>

      <button
        type="button"
        class="add-button"
        onclick="addRequirement()"
      >
        + Add Requirement
      </button>

    </div>


    <div id="requirementsContainer">

      <% (country.requirements || []).forEach((item, index) => { %>

        <div class="dynamic-card">

          <div class="dynamic-card-header">

            <h3>
              Requirement <%= index + 1 %>
            </h3>

            <button
              type="button"
              class="remove-button"
              onclick="removeCard(this)"
            >
              Remove
            </button>

          </div>


          <div class="form-grid">


            <div class="form-group">

              <label>Title</label>

              <input
                type="text"
                name="requirements[<%= index %>][title]"
                value="<%= item.title || '' %>"
              >

            </div>


            <div class="form-group">

              <label>Icon</label>

              <input
                type="text"
                name="requirements[<%= index %>][icon]"
                value="<%= item.icon || '' %>"
                placeholder="📄"
              >

            </div>


            <div class="form-group full-width">

              <label>Description</label>

              <textarea
                name="requirements[<%= index %>][description]"
                rows="3"
              ><%= item.description || '' %></textarea>

            </div>


            <div class="form-group full-width">

              <label>Items</label>

              <textarea
                name="requirements[<%= index %>][items]"
                rows="5"
                placeholder="One item per line"
              ><%= Array.isArray(item.items) ? item.items.join("\n") : "" %></textarea>

            </div>

          </div>

        </div>

      <% }) %>

    </div>

  </section>



  <!-- =========================================
       ELIGIBILITY
  ========================================== -->

  <section class="admin-card">

    <div class="section-heading">

      <div>
        <span class="section-number">04</span>

        <h2>Eligibility</h2>

        <p>
          Eligibility information for applicants.
        </p>
      </div>

      <button
        type="button"
        class="add-button"
        onclick="addEligibility()"
      >
        + Add Eligibility
      </button>

    </div>


    <div id="eligibilityContainer">

      <% (country.eligibility || []).forEach((item, index) => { %>

        <div class="dynamic-card">

          <div class="dynamic-card-header">

            <h3>
              Eligibility <%= index + 1 %>
            </h3>

            <button
              type="button"
              class="remove-button"
              onclick="removeCard(this)"
            >
              Remove
            </button>

          </div>


          <div class="form-grid">


            <div class="form-group">

              <label>Title</label>

              <input
                type="text"
                name="eligibility[<%= index %>][title]"
                value="<%= item.title || '' %>"
              >

            </div>


            <div class="form-group">

              <label>Icon</label>

              <input
                type="text"
                name="eligibility[<%= index %>][icon]"
                value="<%= item.icon || '' %>"
                placeholder="✓"
              >

            </div>


            <div class="form-group full-width">

              <label>Description</label>

              <textarea
                name="eligibility[<%= index %>][description]"
                rows="3"
              ><%= item.description || '' %></textarea>

            </div>


            <div class="form-group full-width">

              <label>Items</label>

              <textarea
                name="eligibility[<%= index %>][items]"
                rows="5"
                placeholder="One item per line"
              ><%= Array.isArray(item.items) ? item.items.join("\n") : "" %></textarea>

            </div>

          </div>

        </div>

      <% }) %>

    </div>

  </section>



  <!-- =========================================
       APPLICATION PROCESS
  ========================================== -->

  <section class="admin-card">

    <div class="section-heading">

      <div>
        <span class="section-number">05</span>

        <h2>Application Process</h2>

        <p>
          Steps applicants need to follow.
        </p>
      </div>

      <button
        type="button"
        class="add-button"
        onclick="addProcessStep()"
      >
        + Add Step
      </button>

    </div>


    <div id="processContainer">

      <% (country.applicationProcess || []).forEach((item, index) => { %>

        <div class="dynamic-card">

          <div class="dynamic-card-header">

            <h3>
              Step <%= index + 1 %>
            </h3>

            <button
              type="button"
              class="remove-button"
              onclick="removeCard(this)"
            >
              Remove
            </button>

          </div>


          <div class="form-grid">


            <div class="form-group">

              <label>Step Number</label>

              <input
                type="number"
                name="applicationProcess[<%= index %>][step]"
