/* Rich-text editors: copy the editor HTML into the existing form field before submit. */
document.querySelectorAll('.vm-rich-editor').forEach(function(editor){
  const fieldName = editor.dataset.field;
  const hidden = document.querySelector('input[type="hidden"][name="' + fieldName + '"]');
  const content = editor.querySelector('.vm-editor-content');
  let savedRange = null;
  function saveSelection() {
    const selection = window.getSelection();
    if (selection && selection.rangeCount && content.contains(selection.anchorNode)) {
      savedRange = selection.getRangeAt(0).cloneRange();
    }
  }
  content.addEventListener('keyup', saveSelection);
  content.addEventListener('mouseup', saveSelection);
  content.addEventListener('input', saveSelection);
  editor.querySelectorAll('[data-command]').forEach(function(control){
    const runCommand = function() {
      const command = control.dataset.command;
      if (control.dataset.prompt === 'link') {
        const url = window.prompt('Enter link URL (https://...)');
        if (!url) return;
        const safeUrl = /^(https?:|mailto:)/i.test(url) ? url : 'https://' + url;
        content.focus();
        if (savedRange) { const sel = window.getSelection(); sel.removeAllRanges(); sel.addRange(savedRange); }
        document.execCommand('createLink', false, safeUrl);
        saveSelection();
        return;
      }
      content.focus();
      if (savedRange) { const sel = window.getSelection(); sel.removeAllRanges(); sel.addRange(savedRange); }
      let value = control.dataset.value || null;
      if (control.tagName === 'SELECT' || control.type === 'color') value = control.value;
      if (command === 'formatBlock' && value) value = '<' + value + '>';
      document.execCommand(command, false, value);
      saveSelection();
    };
    if (control.tagName === 'SELECT') {
      control.addEventListener('change', runCommand);
    } else if (control.type === 'color') {
      control.addEventListener('input', runCommand);
    } else {
      control.addEventListener('mousedown', saveSelection);
      control.addEventListener('click', runCommand);
    }
  });
  const form = editor.closest('form');
  if(form) form.addEventListener('submit', function(){ if(hidden) hidden.value = content.innerHTML.trim(); });
});

/* =========================================
   DELETE APPLICATION FORM PDF
========================================= */

async function deleteApplicationFormPdf(slug) {
  const confirmed = window.confirm(
    "Are you sure you want to delete this application form PDF? This action cannot be undone."
  );

  if (!confirmed) {
    return;
  }

  const button = document.querySelector(
    ".application-form-delete-btn"
  );

  if (button) {
    button.disabled = true;
    button.textContent = "Deleting...";
  }

  try {
    const response = await fetch(
      `/admin/countries/${encodeURIComponent(slug)}/application-form/delete`,
      {
        method: "POST",
        headers: {
          "Accept": "application/json"
        },
        credentials: "same-origin"
      }
    );

    const result = await response.json();

    if (!response.ok) {
      throw new Error(result.message || "Failed to delete PDF.");
    }

    alert("Application form PDF deleted successfully.");

    // Refresh the page to display the updated PDF section.
    window.location.reload();

  } catch (error) {
    console.error("PDF deletion error:", error);

    alert(error.message || "Unable to delete the PDF. Please try again.");

    if (button) {
      button.disabled = false;
      button.textContent = "Delete PDF";
    }
  }
}
</script>