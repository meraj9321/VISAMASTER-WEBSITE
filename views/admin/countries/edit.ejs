
<%
const updatedAt = (value) =>
  value
    ? new Date(value).toLocaleString("en-IN", {
        dateStyle: "medium",
        timeStyle: "short"
      })
    : "Not updated yet";

const categoryDefaults = [
  { name: "E-Visa", slug: "e-visa" },
  { name: "Sticker Visa", slug: "sticker-visa" },
  { name: "Visa on Arrival", slug: "visa-on-arrival" }
];

const categories = categoryDefaults.map((item) => {
  const found = (country.visaCategories || []).find(
    (category) => category.slug === item.slug
  );

  return found || {
    ...item,
    isActive: true,
    subCategories: []
  };
});

const travelInfo = country.travelInfo || {};
%>

<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">

  <title>Edit <%= country.name %> | VisaMaster Admin</title>

  <link rel="stylesheet" href="/css/global.css">
  <link rel="stylesheet" href="/css/navbar.css">
  <link rel="stylesheet" href="/css/admin-country.css">

  <link rel="stylesheet" href="/css/admin-country-edit.css">
  
</head>

<body>

  <main class="edit-page">

    <!-- PAGE HEADER -->

    <header class="edit-top">

      <div>
        <span class="edit-kicker">
          VISAMASTER ADMIN · COUNTRY MANAGEMENT
        </span>

        <h1>Edit <%= country.name %></h1>

        <p>
          Manage country details, visa categories and travel information.
        </p>
      </div>

      <a class="edit-back" href="/admin/countries">
        ← Back to Countries
      </a>

    </header>

    <% if (typeof updated !== 'undefined' && updated) { %>

      <div class="edit-alert">
        Country information updated successfully.
      </div>

    <% } else if (typeof query !== 'undefined' && query.updated === 'true') { %>

      <div class="edit-alert">
        Country information updated successfully.
      </div>

    <% } %>


    <form
      id="countryEditForm"
      action="/admin/countries/<%= encodeURIComponent(country.slug) %>/edit"
      method="POST"
      enctype="multipart/form-data"
    >

      <!-- =================================================
           01. BASIC INFORMATION
      ================================================== -->

      <details class="edit-section" open>

        <summary>
          <span>
            01 · Basic Information
            <span class="section-hint">
              Country identity, images and descriptions
            </span>
          </span>
        </summary>

        <div class="section-body">

          <div class="edit-grid">

            <div class="edit-field">

              <label for="name">Country Name *</label>

              <input
                id="name"
                name="name"
                value="<%= country.name || '' %>"
                required
              >

              <small class="edit-updated">
                Updated: <%= updatedAt(country.fieldUpdatedAt?.name) %>
              </small>

            </div>

            <div class="edit-field">

              <label for="slug">Slug *</label>

              <input
                id="slug"
                name="slug"
                value="<%= country.slug || '' %>"
                required
              >

              <small class="edit-help">
                Example: united-arab-emirates
              </small>

              <small class="edit-updated">
                Updated: <%= updatedAt(country.fieldUpdatedAt?.slug) %>
              </small>

            </div>

            <div class="edit-field">

              <label for="countryCode">Country Code</label>

              <input
                id="countryCode"
                name="countryCode"
                value="<%= country.countryCode || '' %>"
                placeholder="AE"
              >

            </div>

            <div class="edit-field">

              <label for="flag">Flag Image Path / Emoji</label>

              <input
                id="flag"
                name="flag"
                value="<%= country.flag || '' %>"
                placeholder="/images/flags/uae.png"
              >

              <small class="edit-help">
                Use the existing image path or a flag emoji.
              </small>

            </div>

            <div class="edit-field">

              <label for="image">Country Image Path</label>

              <input
                id="image"
                name="image"
                value="<%= country.image || '' %>"
                placeholder="/images/countries/uae.jpg"
              >

            </div>

            <div class="edit-field">

              <label for="heroBadge">Hero Badge</label>

              <input
                id="heroBadge"
                name="heroBadge"
                value="<%= country.heroBadge || '' %>"
                placeholder="Popular Destination"
              >

            </div>

            <div class="edit-field full">

              <label for="shortDescription">
                Short Description
              </label>

              <textarea
                id="shortDescription"
                name="shortDescription"
                rows="2"
              ><%= country.shortDescription || '' %></textarea>

            </div>

            <div class="edit-field full">

              <label for="description">
                Full Description
              </label>

              <textarea
                id="description"
                name="description"
                rows="5"
              ><%= country.description || '' %></textarea>

            </div>

          </div>

        </div>

      </details>


      <!-- =================================================
           02. VISA CATEGORIES AND SUBCATEGORIES
      ================================================== -->

      <details class="edit-section" open>

        <summary>
          <span>
            02 · Visa Categories & Subcategories
            <span class="section-hint">
              Three fixed main categories; manage subcategories inside each one
            </span>
          </span>
        </summary>

        <div class="section-body">

          <div id="visaCategoriesContainer">

            <% categories.forEach((category, categoryIndex) => { %>

              <section class="category-card" data-category>

                <div class="category-head">

                  <div>
                    <h3><%= category.name %></h3>

                    <small class="edit-help">
                      <%= category.slug %>
                    </small>
                  </div>

                  <div class="edit-field" style="min-width:130px">

                    <label>Category Status</label>

                    <select name="visaCategories[<%= categoryIndex %>][isActive]">

                      <option
                        value="true"
                        <%= category.isActive !== false ? 'selected' : '' %>
                      >
                        Active
                      </option>

                      <option
                        value="false"
                        <%= category.isActive === false ? 'selected' : '' %>
                      >
                        Inactive
                      </option>

                    </select>

                  </div>

                </div>

                <input
                  type="hidden"
                  name="visaCategories[<%= categoryIndex %>][name]"
                  value="<%= category.name %>"
                >

                <input
                  type="hidden"
                  name="visaCategories[<%= categoryIndex %>][slug]"
                  value="<%= category.slug %>"
                >

                <div class="category-content">

                  <div class="subcategories-container" data-subcategories>

                    <% (category.subCategories || []).forEach((sub, subIndex) => { %>

                      <article class="sub-card" data-subcategory>

                        <div class="sub-head">

                          <h4>
                            Subcategory: <%= sub.name %>
                          </h4>

                          <button
                            type="button"
                            class="edit-btn danger"
                            data-remove-subcategory
                          >
                            Delete
                          </button>

                        </div>

                        <div class="sub-content">

                          <div class="edit-grid">

                            <div class="edit-field">

                              <label>Subcategory Name *</label>

                              <input
                                data-field="name"
                                name="visaCategories[<%= categoryIndex %>][subCategories][<%= subIndex %>][name]"
                                value="<%= sub.name || '' %>"
                                required
                              >

                            </div>

                            <div class="edit-field">

                              <label>Slug *</label>

                              <input
                                data-field="slug"
                                name="visaCategories[<%= categoryIndex %>][subCategories][<%= subIndex %>][slug]"
                                value="<%= sub.slug || '' %>"
                                required
                              >

                            </div>

                            <div class="edit-field full">

                              <label>Purpose</label>

                              <input
                                data-field="purpose"
                                name="visaCategories[<%= categoryIndex %>][subCategories][<%= subIndex %>][purpose]"
                                value="<%= sub.purpose || '' %>"
                              >

                            </div>

                            <div class="edit-field full">

                              <label>Description</label>

                              <textarea
                                data-field="description"
                                name="visaCategories[<%= categoryIndex %>][subCategories][<%= subIndex %>][description]"
                                rows="2"
                              ><%= sub.description || '' %></textarea>

                            </div>

                            <div class="edit-field">

                              <label>Eligibility · One item per line</label>

                              <textarea
                                data-field="eligibility"
                                name="visaCategories[<%= categoryIndex %>][subCategories][<%= subIndex %>][eligibility]"
                                rows="4"
                              ><%= (sub.eligibility || []).join('\n') %></textarea>

                            </div>

                            <div class="edit-field">

                              <label>Requirements · One item per line</label>

                              <textarea
                                data-field="requirements"
                                name="visaCategories[<%= categoryIndex %>][subCategories][<%= subIndex %>][requirements]"
                                rows="4"
                              ><%= (sub.requirements || []).join('\n') %></textarea>

                            </div>

                            <div class="edit-field">

                              <label>Subcategory Status</label>

                              <select
                                data-field="isActive"
                                name="visaCategories[<%= categoryIndex %>][subCategories][<%= subIndex %>][isActive]"
                              >

                                <option
                                  value="true"
                                  <%= sub.isActive !== false ? 'selected' : '' %>
                                >
                                  Active
                                </option>

                                <option
                                  value="false"
                                  <%= sub.isActive === false ? 'selected' : '' %>
                                >
                                  Inactive
                                </option>

                              </select>

                            </div>


                            <!-- SUBCATEGORY PDF -->

                            <div class="edit-field full">

                              <label>Application Form PDF</label>

                              <div class="pdf-panel">

                                <% if (sub.applicationForm && sub.applicationForm.filename) { %>

                                  <strong>Current PDF:</strong>

                                  <%= sub.applicationForm.filename %>

                                  <div class="pdf-actions">

                                    <a
                                      href="/countries/<%= encodeURIComponent(country.slug) %>/application-form/<%= encodeURIComponent(category.slug) %>/<%= encodeURIComponent(sub.slug) %>"
                                      target="_blank"
                                      rel="noopener"
                                    >
                                      View PDF
                                    </a>

                                    <a
                                      href="/countries/<%= encodeURIComponent(country.slug) %>/application-form/<%= encodeURIComponent(category.slug) %>/<%= encodeURIComponent(sub.slug) %>/download"
                                    >
                                      Download PDF
                                    </a>

                                    <button
                                      type="button"
                                      class="edit-btn danger"
                                      data-delete-subcategory-pdf
                                      data-country-slug="<%= country.slug %>"
                                      data-category-slug="<%= category.slug %>"
                                      data-subcategory-slug="<%= sub.slug %>"
                                    >
                                      Delete PDF
                                    </button>

                                  </div>

                                <% } else { %>

                                  <span class="edit-help">
                                    No application form uploaded for this subcategory.
                                  </span>

                                <% } %>

                                <div class="edit-field" style="margin-top:14px">

                                  <label>
                                    <%= sub.applicationForm?.filename
                                      ? 'Replace Application Form PDF'
                                      : 'Upload Application Form PDF' %>
                                  </label>

                                  <input
                                    type="file"
                                    data-subcategory-pdf
                                    name="subcategoryPdf[<%= category.slug %>][<%= sub.slug %>]"
                                    accept="application/pdf,.pdf"
                                  >

                                  <small class="edit-help">
                                    PDF only · Maximum 5 MB.
                                    Existing PDF is retained if no new file is selected.
                                  </small>

                                </div>

                              </div>

                            </div>

                          </div>

                        </div>

                      </article>

                    <% }) %>

                  </div>

                  <button
                    type="button"
                    class="edit-btn secondary"
                    data-add-subcategory
                  >
                    ＋ Add Subcategory
                  </button>

                </div>

              </section>

            <% }) %>

          </div>

          <p class="edit-footer-note">
            The three main categories are fixed by your Country schema.
            You can activate/deactivate them and add, edit or delete their subcategories.
            Each subcategory can have its own application form PDF.
          </p>

        </div>

      </details>


      <!-- =================================================
           03. TRAVEL INFORMATION
      ================================================== -->

      <details class="edit-section">

        <summary>
          <span>
            03 · Travel Information
            <span class="section-hint">
              Destination details shown on the country page
            </span>
          </span>
        </summary>

        <div class="section-body">

          <div class="edit-grid">

            <div class="edit-field">

              <label>Best Time to Visit</label>

              <input
                name="travelInfo[bestTimeToVisit]"
                value="<%= travelInfo.bestTimeToVisit || '' %>"
              >

            </div>

            <div class="edit-field">

              <label>Currency</label>

              <input
                name="travelInfo[currency]"
                value="<%= travelInfo.currency || '' %>"
              >

            </div>

            <div class="edit-field">

              <label>Language</label>

              <input
                name="travelInfo[language]"
                value="<%= travelInfo.language || '' %>"
              >

            </div>

            <div class="edit-field">

              <label>Timezone</label>

              <input
                name="travelInfo[timezone]"
                value="<%= travelInfo.timezone || '' %>"
              >

            </div>

            <div class="edit-field">

              <label>Capital</label>

              <input
                name="travelInfo[capital]"
                value="<%= travelInfo.capital || '' %>"
              >

            </div>

            <div class="edit-field">

              <label>Flight Duration</label>

              <input
                name="travelInfo[flightDuration]"
                value="<%= travelInfo.flightDuration || '' %>"
              >

            </div>

            <div class="edit-field">

              <label>Time Difference</label>

              <input
                name="travelInfo[timeDifference]"
                value="<%= travelInfo.timeDifference || '' %>"
              >

            </div>

            <div class="edit-field">

              <label>Major Cities · One per line</label>

              <textarea
                name="travelInfo[majorCities]"
                rows="3"
              ><%= (travelInfo.majorCities || []).join('\n') %></textarea>

            </div>

            <div class="edit-field full">

              <label>Airport Information</label>

              <textarea
                name="travelInfo[airportInformation]"
                rows="3"
              ><%= travelInfo.airportInformation || '' %></textarea>

            </div>

          </div>

        </div>

      </details>


      <!-- =================================================
           04. TRAVEL TIPS AND NOTES
      ================================================== -->

      <details class="edit-section">

        <summary>
          <span>
            04 · Travel Tips & Important Notes
            <span class="section-hint">
              One item per line; each line is saved separately
            </span>
          </span>
        </summary>

        <div class="section-body">

          <div class="edit-grid">

            <div class="edit-field">

              <label>Travel Tips · One per line</label>

              <textarea
                name="travelTips"
                rows="7"
              ><%= (country.travelTips || []).join('\n') %></textarea>

            </div>

            <div class="edit-field">

              <label>Important Notes · One per line</label>

              <textarea
                name="importantNotes"
                rows="7"
              ><%= (country.importantNotes || []).join('\n') %></textarea>

            </div>

          </div>

        </div>

      </details>


      <!-- =================================================
           05. FAQS
      ================================================== -->

      <details class="edit-section">

        <summary>
          <span>
            05 · Frequently Asked Questions
            <span class="section-hint">
              Add or remove country-specific FAQs
            </span>
          </span>
        </summary>

        <div class="section-body">

          <div id="faqContainer">

            <% (country.faqs || []).forEach((faq, index) => { %>

              <article class="repeat-card" data-faq>

                <div class="repeat-head">

                  <h4>FAQ <%= index + 1 %></h4>

                  <button
                    type="button"
                    class="edit-btn danger"
                    data-remove-card
                  >
                    Remove
                  </button>

                </div>

                <div class="repeat-content edit-grid">

                  <div class="edit-field full">

                    <label>Question</label>

                    <input
                      data-faq-field="question"
                      name="faqs[<%= index %>][question]"
                      value="<%= faq.question || '' %>"
                    >

                  </div>

                  <div class="edit-field full">

                    <label>Answer</label>

                    <textarea
                      data-faq-field="answer"
                      name="faqs[<%= index %>][answer]"
                      rows="3"
                    ><%= faq.answer || '' %></textarea>

                  </div>

                </div>

              </article>

            <% }) %>

          </div>

          <button
            type="button"
            class="edit-btn secondary"
            id="addFaqBtn"
          >
            ＋ Add FAQ
          </button>

        </div>

      </details>


      <!-- =================================================
           06. COUNTRY CLASSIFICATION
      ================================================== -->

      <details class="edit-section">

        <summary>
          <span>
            06 · Country Classification
            <span class="section-hint">
              Schengen membership and country visibility
            </span>
          </span>
        </summary>

        <div class="section-body">

          <div class="status-row">

            <div class="status-box">

              <label>Schengen Country</label>

              <select name="isSchengen">

                <option
                  value="false"
                  <%= country.isSchengen ? '' : 'selected' %>
                >
                  No
                </option>

                <option
                  value="true"
                  <%= country.isSchengen ? 'selected' : '' %>
                >
                  Yes
                </option>

              </select>

            </div>

            <div class="status-box">

              <label>Country Status</label>

              <select name="isActive">

                <option
                  value="true"
                  <%= country.isActive !== false ? 'selected' : '' %>
                >
                  Active
                </option>

                <option
                  value="false"
                  <%= country.isActive === false ? 'selected' : '' %>
                >
                  Inactive
                </option>

              </select>

            </div>

          </div>

        </div>

      </details>


      <!-- SAVE BUTTONS -->

      <div class="edit-actions">

        <a
          class="edit-btn secondary"
          href="/admin/countries"
        >
          Cancel
        </a>

        <button type="submit" class="save-btn">
          Save Country Changes
        </button>

      </div>

    </form>

  </main>


  <!-- =====================================================
       JAVASCRIPT
  ====================================================== -->

  <script src="/js/admin-country-edit.js" defer></script>

</body>
</html>
