        <textarea
          name="processing[processingNotes]"
          rows="5"
          placeholder="One note per line"
        ><%= Array.isArray(country.processing?.processingNotes) ? country.processing.processingNotes.join("\n") : "" %></textarea>

        <small class="field-updated">
          Last updated:
