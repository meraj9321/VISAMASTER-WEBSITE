      <div class="form-group">

        <label>Other Charges</label>

        <input
          type="text"
          name="fees[otherCharges]"
          value="<%= country.fees?.otherCharges || '' %>"
        >

        <small class="field-updated">
          Last updated:
          <%= formatUpdatedAt(country.fieldUpdatedAt?.fees?.otherCharges) %>
        </small>

      </div>


      <div class="form-group">

        <label>Total Estimated Fee</label>

        <input
          type="text"
          name="fees[totalEstimatedFee]"
          value="<%= country.fees?.totalEstimatedFee || '' %>"
        >

        <small class="field-updated">
          Last updated:
          <%= formatUpdatedAt(country.fieldUpdatedAt?.fees?.totalEstimatedFee) %>
        </small>

      </div>


      <div class="form-group">

        <label>Currency</label>

        <input
          type="text"
          name="fees[currency]"
          value="<%= country.fees?.currency || '' %>"
          placeholder="INR"
        >

        <small class="field-updated">
          Last updated:
          <%= formatUpdatedAt(country.fieldUpdatedAt?.fees?.currency) %>
        </small>

      </div>


      <div class="form-group full-width">

        <label>Fee Notes</label>

        <textarea
          name="fees[notes]"
          rows="5"
          placeholder="One note per line"
        ><%= Array.isArray(country.fees?.notes) ? country.fees.notes.join("\n") : "" %></textarea>

        <small class="field-updated">
          Last updated:
          <%= formatUpdatedAt(country.fieldUpdatedAt?.fees?.notes) %>
        </small>

      </div>

    </div>

