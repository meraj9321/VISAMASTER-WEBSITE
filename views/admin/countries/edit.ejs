              <label>Description</label>

              <textarea
                name="eligibility[<%= index %>][description]"
                rows="3"
              ><%= item.description || '' %></textarea>

            </div>


            <div class="form-group full-width">

              <label>Items</label>

              <textarea
                name="eligibility[<%= index %>][items]"
                rows="5"
