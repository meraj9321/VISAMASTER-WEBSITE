  const fieldName = textarea.name;
  const label = fieldName.endsWith('[eligibility]') ? 'Eligibility' : 'Documents';
  const placeholder = label === 'Eligibility' ? 'Write eligibility requirements...' : 'Write documents required...';
  const wrapper = document.createElement('div');
  wrapper.className = 'vm-rich-editor';
  wrapper.dataset.field = fieldName;
  const templateEditor = document.querySelector('.vm-rich-editor');
  const toolbar = templateEditor ? templateEditor.querySelector('.vm-editor-toolbar').cloneNode(true) : document.createElement('div');
  toolbar.classList.add('vm-editor-toolbar');
  toolbar.setAttribute('role', 'toolbar');
  toolbar.setAttribute('aria-label', label + ' formatting');
  const content = document.createElement('div');
  content.className = 'vm-editor-content';
  content.contentEditable = 'true';
  content.dataset.placeholder = placeholder;
  content.innerHTML = textarea.value.split(/\\r?\\n/).filter(Boolean).map(function(line) {
    const p = document.createElement('p'); p.textContent = line; return p.outerHTML;
  }).join('');
  const hidden = document.createElement('input');
  hidden.type = 'hidden'; hidden.name = fieldName; hidden.value = '';
  wrapper.append(toolbar, content);
  textarea.replaceWith(hidden, wrapper);
  let savedRange = null;
  function saveSelection() {
    const selection = window.getSelection();
    if (selection && selection.rangeCount && content.contains(selection.anchorNode)) savedRange = selection.getRangeAt(0).cloneRange();
  }
  content.addEventListener('keyup', saveSelection);
  content.addEventListener('mouseup', saveSelection);
  content.addEventListener('input', saveSelection);
  toolbar.querySelectorAll('[data-command]').forEach(function(control) {
    function runCommand() {
      const command = control.dataset.command;
      content.focus();
      if (savedRange) { const sel = window.getSelection(); sel.removeAllRanges(); sel.addRange(savedRange); }
      let value = control.dataset.value || null;
      if (control.dataset.prompt === 'link') {
        const url = window.prompt('Enter link URL (https://...)');
        if (!url) return;
        value = /^(https?:|mailto:)/i.test(url) ? url : 'https://' + url;
        document.execCommand('createLink', false, value);
      } else {
        if (control.tagName === 'SELECT' || control.type === 'color') value = control.value;
        if (command === 'formatBlock' && value) value = '<' + value + '>';
        document.execCommand(command, false, value);
      }
      saveSelection();
    }
    if (control.tagName === 'SELECT') control.addEventListener('change', runCommand);
    else if (control.type === 'color') control.addEventListener('input', runCommand);
    else { control.addEventListener('mousedown', saveSelection); control.addEventListener('click', runCommand); }
  });
  form.addEventListener('submit', function() { hidden.value = content.innerHTML.trim(); });
});

}

