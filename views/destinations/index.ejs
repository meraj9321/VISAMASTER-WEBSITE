<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8" />

  <meta
    name="viewport"
    content="width=device-width, initial-scale=1.0"
  />

  <meta
    name="description"
    content="Explore popular travel destinations with VisaMaster and find the right visa assistance for your next journey."
  />

  <meta name="robots" content="index, follow" />

  <title>Destinations | VisaMaster</title>

  <!-- GLOBAL + SHARED CSS -->
  <link rel="stylesheet" href="/css/global.css" />
  <link rel="stylesheet" href="/css/navbar.css" />

  <!-- DESTINATIONS PAGE CSS -->
  <link rel="stylesheet" href="/css/destinations.css" />

  <!-- FOOTER CSS -->
  <link rel="stylesheet" href="/css/footer.css" />
</head>

<body>

  <!-- NAVBAR -->
  <%- include("../partials/navbar") %>

  <main>

    <!-- =========================================
         DESTINATION HERO
    ========================================== -->

    <section class="destination-hero">

      <div class="destination-container">

        <div class="destination-hero-top">

          <!-- HERO CONTENT -->

          <div class="destination-hero-copy">

            <div class="passport-label">
              🌍 PASSPORT TO THE WORLD
            </div>

            <h1>
              Want to know
              <span>requirements?</span>
            </h1>

            <p>
              From dream beaches to busy city streets,
              discover destinations and find the right
              visa for your next adventure.
            </p>

            <!-- DESTINATION SEARCH -->

            <div
              class="destination-search"
              id="destinationSearchBox"
            >

              <span class="destination-search-icon">
                🔍
              </span>

              <input
                type="text"
                id="destinationSearchInput"
                placeholder="Search your dream destination..."
                autocomplete="off"
                aria-label="Search destination"
              />

              <button
                type="button"
                id="destinationSearchButton"
              >
                See-Requirements
              </button>

              <!-- SEARCH SUGGESTIONS -->

              <div
                id="destinationSuggestions"
                class="destination-suggestions"
                role="listbox"
                aria-label="Destination suggestions"
              ></div>

            </div>

            <div class="destination-mini-info">

              <span>✈️ 50+ Destinations</span>

              <span>🛂 Visa Assistance</span>

              <span>🌎 Worldwide Travel</span>

            </div>

          </div>

          <!-- PASSPORT VISUAL -->

          <div class="passport-scene">

            <div class="passport-sun">
              ☀
            </div>

            <div class="passport-cloud cloud-one">
              ☁
            </div>

            <div class="passport-cloud cloud-two">
              ☁
            </div>

            <div class="passport-globe">
              🌍
            </div>

            <div class="passport-card">

              <div class="passport-card-top">
                <span>VISA</span>
                <span>VISAMASTER</span>
              </div>

              <div class="passport-card-middle">

                <div class="passport-chip">
                  ▦
                </div>

                <div>
                  <small>TRAVEL DOCUMENT</small>
                  <strong>EXPLORE</strong>
                </div>

              </div>

              <div class="passport-card-bottom">
                <span>✈ INDIA</span>
                <span>VM • 2026</span>
              </div>

            </div>

            <div class="passport-stamp stamp-one">
              VISA
              <br />
              READY
            </div>

            <div class="passport-stamp stamp-two">
              GO! ✈
            </div>

            <div class="passport-ticket">

              <span>BOARDING PASS</span>

              <strong>YOUR NEXT ADVENTURE</strong>

              <div class="ticket-line"></div>

              <small>DREAM → DESTINATION</small>

            </div>

            <div class="passport-plane">
              ✈
            </div>

          </div>

        </div>

      </div>

    </section>


    <!-- =========================================
         POPULAR DESTINATIONS
    ========================================== -->

    <section class="popular-destinations">

      <div class="destination-container">

        <!-- SECTION HEADING -->

        <div class="destination-section-heading">

          <div class="destination-label">
            ✦ POPULAR PICKS
          </div>

          <h2>
            Start With
            <span>Somewhere Amazing.</span>
          </h2>

          <p>
            A few places travellers love.
            Your next destination might be here.
          </p>

        </div>


        <!-- =========================================
             COUNTRY REQUIREMENTS CARDS
        ========================================== -->

        <div class="destination-grid" id="destinationGrid">

          <% countries.forEach(country => { %>

            <article
              class="destination-card"
              id="destination-<%= country.slug %>"
              data-destination-name="<%= country.name %>"
              data-destination-slug="<%= country.slug %>"
            >
              <div class="destination-content">
                <div class="country-flag-image">
                  <img
                    src="<%= country.image || '/images/countries/default.jpg' %>"
                    alt="<%= country.name %> flag"
                    loading="lazy"
                    onerror="this.onerror=null; this.src='/images/countries/default.jpg';"
                  />
                  <span class="country-flag-badge">VISA DESTINATION</span>
                </div>

                <h3 class="country-name"><%= country.name %></h3>

                <p class="destination-card-caption">
                  Explore visa information and travel requirements
                </p>

                <a
                  href="/countries/<%= country.slug %>/requirements"
                  class="see-requirements-btn"
                  aria-label="See requirements for <%= country.name %>"
                >
                  <span>See Requirements</span>
                  <span class="destination-requirements-arrow" aria-hidden="true">→</span>
                </a>
              </div>
            </article>

          <% }) %>

        </div>

      </div>

    </section>


    <!-- =========================================
         TRAVEL MAP SECTION
    ========================================== -->

    <section class="travel-map-section">

      <div class="destination-container">

        <div class="travel-map">

          <div class="map-doodles">
            ✦
          </div>

          <div class="map-plane">
            ✈
          </div>

          <div class="map-route route-one">
            • • • • • • •
          </div>

          <div class="map-route route-two">
            • • • • • • • •
          </div>

          <div class="map-route route-three">
            • • • • •
          </div>

          <div class="map-pin pin-india">
            📍
            <span>INDIA</span>
          </div>

          <div class="map-pin pin-dubai">
            📍
            <span>DUBAI</span>
          </div>

          <div class="map-pin pin-usa">
            📍
            <span>USA</span>
          </div>

          <div class="map-pin pin-canada">
            📍
            <span>CANADA</span>
          </div>

          <div class="map-pin pin-australia">
            📍
            <span>AUSTRALIA</span>
          </div>

          <div class="map-center">

            <span>YOUR</span>

            <strong>JOURNEY</strong>

            <small>STARTS HERE ✈</small>

          </div>

        </div>

      </div>

    </section>


    <!-- =========================================
         TRAVEL PACKAGES
    ========================================== -->

    <section class="travel-packages">

      <div class="destination-container">

        <div class="destination-section-heading">

          <div class="destination-label">
            🎒 TRAVEL IDEAS
          </div>

          <h2>
            Maybe Your Next Trip
            <span>Looks Like This.</span>
          </h2>

        </div>

        <div class="package-grid">

          <!-- PACKAGE 1 -->

          <div class="package-card">

            <div class="package-icon">
              🌴
            </div>

            <div>

              <small>RELAX</small>

              <h3>Beach Escape</h3>

              <p>
                Sun, beaches and a little time away.
              </p>

            </div>

            <a href="/contact">
              Plan It →
            </a>

          </div>


          <!-- PACKAGE 2 -->

          <div class="package-card package-card-yellow">

            <div class="package-icon">
              🏙️
            </div>

            <div>

              <small>EXPLORE</small>

              <h3>City Adventure</h3>

              <p>
                Discover new streets, cultures and experiences.
              </p>

            </div>

            <a href="/contact">
              Plan It →
            </a>

          </div>


          <!-- PACKAGE 3 -->

          <div class="package-card package-card-green">

            <div class="package-icon">
              🏔️
            </div>

            <div>

              <small>ADVENTURE</small>

              <h3>Wild Escape</h3>

              <p>
                Mountains, nature and something different.
              </p>

            </div>

            <a href="/contact">
              Plan It →
            </a>

          </div>

        </div>

      </div>

    </section>


    <!-- =========================================
         CTA
    ========================================== -->

    <section class="destination-cta">

      <div class="destination-container">

        <div class="destination-cta-card">

          <div class="cta-cloud">
            ☁
          </div>

          <div class="cta-plane">
            ✈️
          </div>

          <div class="destination-cta-content">

            <div class="destination-label">
              🌎 NEXT STOP?
            </div>

            <h2>
              Your Dream
              <span>Destination Is Waiting.</span>
            </h2>

            <p>
              Tell us where you want to go.
              We'll help you figure out the visa journey.
            </p>

            <div class="destination-cta-buttons">

              <a
                href="/destinations"
                class="destination-main-btn"
              >
                Find Your Visa →
              </a>

              <a
                href="/contact"
                class="destination-outline-btn"
              >
                Talk To Us 💬
              </a>

            </div>

          </div>

        </div>

      </div>

    </section>

  </main>


  <!-- FOOTER -->

  <%- include("../partials/footer") %>


  <!-- MAIN JAVASCRIPT -->

  <script src="/js/main.js"></script>

</body>

</html>