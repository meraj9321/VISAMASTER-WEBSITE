
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />

  <title>All Visa Destinations | VisaMaster</title>

  <meta
    name="description"
    content="Explore all available visa destinations with VisaMaster. Search countries and check visa requirements."
  />

  <link rel="stylesheet" href="/css/global.css" />
  <link rel="stylesheet" href="/css/navbar.css" />
  <link rel="stylesheet" href="/css/visas.css" />
  <link rel="stylesheet" href="/css/footer.css" />
</head>

<body>

  <%- include("../partials/navbar", { currentPage: "visas" }) %>

  <%
    const allCountries = Array.isArray(countries) ? countries : [];

    const getActiveCategories = (country) => {
      const categories = Array.isArray(country.visaCategories)
        ? country.visaCategories
        : [];

      return categories.filter(
        category =>
          category &&
          category.isActive !== false &&
          Array.isArray(category.subCategories) &&
          category.subCategories.some(
            sub => sub && sub.isActive !== false
          )
      );
    };

    const flagPath = (flag) => {
      const value = String(flag || "").trim();

      if (value.startsWith("public/")) {
        return value.replace(/^public/, "");
      }

      if (
        value &&
        !value.startsWith("/") &&
        !/^https?:\/\//i.test(value)
      ) {
        return "/" + value;
      }

      return value;
    };

    const isFlagImage = (flag) => {
      const value = String(flag || "").trim();

      return (
        /^(https?:\/\/|\/|images\/|public\/)/i.test(value) &&
        /\.(png|jpe?g|svg|webp)(\?.*)?$/i.test(value)
      );
    };
  %>


  <main class="vm-directory-page">

    <!-- =========================================
         ALL VISA DESTINATIONS
    ========================================== -->

    <section class="vm-directory-section" id="visa-directory">

      <div class="container">

        <!-- SECTION HEADING -->

        <div class="vm-directory-section-heading">

          <div>

            <span class="vm-directory-section-number">
              01 / VISA DIRECTORY
            </span>

            <h2>
              Explore all <span>destinations.</span>
            </h2>

          </div>

          <p>
            Browse all countries available in the VisaMaster directory.
            Select a destination to explore its available visa categories
            and requirements.
          </p>

        </div>


        <!-- COUNTRY SEARCH -->

        <div class="vm-country-search">

          <label for="vmCountrySearch">
            Search country
          </label>

          <div class="vm-country-search-input-wrap">

            <input
              type="search"
              id="vmCountrySearch"
              placeholder="Search by country name..."
              autocomplete="off"
              aria-label="Search all countries"
            />

            <button
              type="button"
              id="vmClearCountrySearch"
              aria-label="Clear country search"
              hidden
            >
              &times;
            </button>

          </div>

        </div>


        <!-- RESULTS HEADING -->

        <div class="vm-directory-results-head">

          <div>

            <span class="vm-directory-results-kicker">
              ALL VISA DESTINATIONS
            </span>

            <h3>
              Explore <span>countries</span>
            </h3>

            <p>
              Select a country to view its available visa options.
            </p>

          </div>

          <div class="vm-directory-result-count">

            <strong id="vmCountryCount">
              <%= allCountries.length %>
            </strong>

            <span id="vmCountryCountLabel">
              countries found
            </span>

          </div>

        </div>


        <!-- COUNTRY DIRECTORY -->

        <% if (loadError) { %>

          <div class="vm-directory-message" role="status">

            <strong>
              Country directory is temporarily unavailable.
            </strong>

            <span>
              Please refresh the page or contact VisaMaster for assistance.
            </span>

          </div>

        <% } else { %>

          <div
            class="vm-country-grid"
            id="vmCountryGrid"
          >

            <% allCountries.forEach((country) => { %>

              <%
                const activeCategories = getActiveCategories(country);

                const countryFlag = String(country.flag || "").trim();

                const countryFlagIsImage = isFlagImage(countryFlag);

                const countryFlagPath = flagPath(countryFlag);
              %>

              <article
                class="vm-visa-country-card"
                data-country-slug="<%= country.slug %>"
                data-country-name="<%= country.name %>"
              >

                <div class="vm-country-card-main">

                  <span
                    class="vm-country-flag"
                    aria-hidden="true"
                  >

                    <% if (countryFlagIsImage) { %>

                      <img
                        src="<%= countryFlagPath %>"
                        alt="<%= country.name %> flag"
                        loading="lazy"
                      />

                    <% } else { %>

                      <%= countryFlag || "🌍" %>

                    <% } %>

                  </span>

                  <div class="vm-country-card-name">

                    <h4>
                      <%= country.name %>
                    </h4>

                    <span>
                      <%= activeCategories.length %>
                      active visa categor<%= activeCategories.length === 1 ? "y" : "ies" %>
                    </span>

                  </div>

                  <span
                    class="vm-country-card-arrow"
                    aria-hidden="true"
                  >
                    ↗
                  </span>

                </div>

                <a
                  class="vm-country-requirements-link"
                  href="/countries/<%= country.slug %>/visa-categories"
                >

                  See Requirements

                  <span aria-hidden="true">
                    →
                  </span>

                </a>

              </article>

            <% }) %>

          </div>


          <!-- NO RESULTS MESSAGE -->

          <div
            class="vm-directory-no-results"
            id="vmVisaNoResults"
            hidden
          >

            <span
              class="vm-no-results-icon"
              aria-hidden="true"
            >
              ⌕
            </span>

            <h3>
              No countries found
            </h3>

            <p>
              We couldn't find a country matching your search.
              Try another country name or contact our team.
            </p>

            <a
              class="vm-directory-btn vm-btn-primary"
              href="/contact"
            >
              Ask VisaMaster
              <span aria-hidden="true">→</span>
            </a>

          </div>

        <% } %>


        <!-- DISCLAIMER -->

        <p class="vm-directory-disclaimer">

          <span aria-hidden="true">ⓘ</span>

          Visa rules and application methods may vary by nationality
          and can change. A country listing is an information guide,
          not a guarantee of visa eligibility or entry.

        </p>

      </div>

    </section>


    <!-- =========================================
         HOW IT WORKS
    ========================================== -->

    <section
      class="vm-directory-process"
      aria-labelledby="vmDirectoryProcessTitle"
    >

      <div class="container">

        <div class="vm-directory-section-heading">

          <div>

            <span class="vm-directory-section-number">
              02 / HOW IT WORKS
            </span>

            <h2 id="vmDirectoryProcessTitle">
              Three steps to get <span>started.</span>
            </h2>

          </div>

          <p>
            Use the directory to review the information available
            for your destination. If you need help, VisaMaster can
            guide you through the next steps.
          </p>

        </div>


        <div class="vm-process-grid">

          <article class="vm-process-card">

            <span class="vm-process-number">01</span>

            <span
              class="vm-process-icon"
              aria-hidden="true"
            >
              ⌕
            </span>

            <h3>Search a country</h3>

            <p>
              Find your preferred destination using the country search.
            </p>

          </article>


          <article class="vm-process-card">

            <span class="vm-process-number">02</span>

            <span
              class="vm-process-icon"
              aria-hidden="true"
            >
              ◎
            </span>

            <h3>Choose a visa category</h3>

            <p>
              Explore available E-Visa, Sticker Visa or Visa on Arrival
              options for your destination.
            </p>

          </article>


          <article class="vm-process-card">

            <span class="vm-process-number">03</span>

            <span
              class="vm-process-icon"
              aria-hidden="true"
            >
              ✓
            </span>

            <h3>Review your checklist</h3>

            <p>
              Check documents and eligibility information, or contact
              our team for assistance.
            </p>

          </article>

        </div>

      </div>

    </section>


    <!-- =========================================
         ADDITIONAL TRAVEL DOCUMENT SERVICES
    ========================================== -->

    <section
      class="vm-special-services"
      id="travel-document-services"
    >

      <div class="container vm-special-layout">

        <div class="vm-special-intro">

          <span class="vm-directory-section-number vm-light-number">
            03 / BEYOND VISAS
          </span>

          <h2>
            More than<br />
            <span>just visas.</span>
          </h2>

          <p>
            International travel can require additional documentation
            and destination-specific formalities. Ask our team for help
            with the services below.
          </p>

          <a
            href="/contact"
            class="vm-special-link"
          >
            Ask our team
            <span aria-hidden="true">→</span>
          </a>

        </div>


        <div class="vm-special-grid">

          <article class="vm-special-card">

            <span class="vm-special-icon" aria-hidden="true">☾</span>

            <div>
              <span class="vm-special-index">01</span>
              <h3>Umrah Visa</h3>
              <p>
                Assistance with Umrah visa-related travel requirements.
              </p>
            </div>

          </article>


          <article class="vm-special-card">

            <span class="vm-special-icon" aria-hidden="true">✈</span>

            <div>
              <span class="vm-special-index">02</span>
              <h3>OK to Board (OKTB)</h3>
              <p>
                Support with OK to Board requirements for applicable
                travel cases.
              </p>
            </div>

          </article>


          <article class="vm-special-card">

            <span class="vm-special-icon" aria-hidden="true">✚</span>

            <div>
              <span class="vm-special-index">03</span>
              <h3>Yellow Fever</h3>
              <p>
                Guidance on yellow fever certificate requirements
                where applicable.
              </p>
            </div>

          </article>


          <article class="vm-special-card vm-special-yellow">

            <span class="vm-special-icon" aria-hidden="true">▤</span>

            <div>
              <span class="vm-special-index">04</span>
              <h3>Arrival Card</h3>
              <p>
                Help with destination-specific arrival card requirements.
              </p>
            </div>

          </article>


          <article class="vm-special-card">

            <span class="vm-special-icon" aria-hidden="true">✓</span>

            <div>
              <span class="vm-special-index">05</span>
              <h3>Document Attestation</h3>
              <p>
                Assistance with document attestation for international
                purposes.
              </p>
            </div>

          </article>


          <article class="vm-special-card">

            <span class="vm-special-icon" aria-hidden="true">◎</span>

            <div>
              <span class="vm-special-index">06</span>
              <h3>Document Assistance</h3>
              <p>
                Guidance with supporting documents and travel paperwork.
              </p>
            </div>

          </article>

        </div>

      </div>

    </section>


    <!-- =========================================
         IMPORTANT INFORMATION
    ========================================== -->

    <section class="vm-directory-note-section">

      <div class="container">

        <div class="vm-directory-note-card">

          <span
            class="vm-note-icon"
            aria-hidden="true"
          >
            !
          </span>

          <div>

            <span class="vm-directory-section-number">
              PLEASE NOTE
            </span>

            <h2>
              Requirements can change.
            </h2>

            <p>
              Visa eligibility, fees, processing times, documents and
              application methods can differ according to destination,
              nationality and travel purpose. Confirm the current rules
              before submitting an application.
            </p>

          </div>

          <a
            href="/contact"
            class="vm-directory-btn vm-btn-light"
          >
            Talk to our team
            <span aria-hidden="true">→</span>
          </a>

        </div>

      </div>

    </section>


    <!-- =========================================
         FINAL CALL TO ACTION
    ========================================== -->

    <section class="vm-directory-cta">

      <div class="container">

        <div class="vm-directory-cta-box">

          <div
            class="vm-cta-decoration"
            aria-hidden="true"
          >
            ✈
          </div>

          <span class="vm-directory-section-number vm-light-number">
            04 / LET'S PLAN
          </span>

          <h2>
            Have a destination <span>in mind?</span>
          </h2>

          <p>
            Tell us where you plan to travel and what assistance you need.
            Our team will help you understand the next steps.
          </p>

          <a
            href="/contact"
            class="vm-directory-btn vm-btn-yellow"
          >
            Get Started
            <span aria-hidden="true">→</span>
          </a>

        </div>

      </div>

    </section>

  </main>


  <%- include("../partials/footer") %>

  <script src="/js/main.js"></script>
  <script src="/js/visas.js"></script>

</body>
</html>
