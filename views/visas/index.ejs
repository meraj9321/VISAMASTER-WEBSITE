<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />

  <title>Visas | VisaMaster</title>

  <meta
    name="description"
    content="Explore VisaMaster visa assistance, travel documentation and international visa services for destinations around the world."
  />

  <link rel="stylesheet" href="/css/global.css" />
  <link rel="stylesheet" href="/css/navbar.css" />
  <link rel="stylesheet" href="/css/visas.css" />
  <link rel="stylesheet" href="/css/footer.css" />
</head>

<body>

  <%- include("../partials/navbar", { currentPage: "visas" }) %>

  <main>

    <!-- =====================================================
         HERO
    ====================================================== -->

    <section class="vm-visa-hero">

      <div class="vm-hero-line"></div>
      <div class="vm-hero-dot vm-dot-one"></div>
      <div class="vm-hero-dot vm-dot-two"></div>

      <div class="container">

        <div class="vm-hero-layout">

          <div class="vm-hero-copy">

            <div class="vm-kicker">
              <span>✦</span>
              VISA SERVICES
            </div>

            <h1>
              Your journey
              <span>starts here.</span>
            </h1>

            <p>
              From tourist trips to business travel, e-visas and special
              travel documentation — VisaMaster helps make your international
              journey simpler, clearer and more organised.
            </p>

            <div class="vm-hero-actions">

              <a href="/contact" class="vm-btn vm-btn-primary">
                Start Your Visa
                <span>→</span>
              </a>

              <a href="#visa-categories" class="vm-btn vm-btn-light">
                Explore Visa Types
              </a>

            </div>

            <div class="vm-trust-row">

              <div>
                <strong>01</strong>
                <span>Visa Guidance</span>
              </div>

              <div>
                <strong>02</strong>
                <span>Document Support</span>
              </div>

              <div>
                <strong>03</strong>
                <span>Application Assistance</span>
              </div>

            </div>

          </div>


          <div class="vm-hero-visual">

            <div class="vm-route route-one">
              ─ ─ ─ ✈ ─ ─ ─
            </div>

            <div class="vm-visual-card vm-main-card">

              <div class="vm-card-top">
                <span>TRAVEL DOCUMENT</span>
                <span>✦</span>
              </div>

              <div class="vm-card-globe">
                ◎
              </div>

              <div class="vm-card-title">
                VISA
                <span>ASSISTANCE</span>
              </div>

              <div class="vm-card-bottom">
                <span>VISAMASTER</span>
                <span>READY TO GO</span>
              </div>

            </div>


            <div class="vm-float-card vm-float-top">
              <span class="vm-float-icon">✓</span>
              <div>
                <strong>Document Check</strong>
                <small>Before submission</small>
              </div>
            </div>


            <div class="vm-float-card vm-float-bottom">
              <span class="vm-float-icon yellow">✈</span>
              <div>
                <strong>Multiple Destinations</strong>
                <small>One trusted partner</small>
              </div>
            </div>


            <div class="vm-destination destination-one">
              🇦🇪 Dubai
            </div>

            <div class="vm-destination destination-two">
              🇬🇧 UK
            </div>

            <div class="vm-destination destination-three">
              🇨🇦 Canada
            </div>

            <div class="vm-destination destination-four">
              🇺🇸 USA
            </div>

          </div>

        </div>

      </div>

    </section>


    <!-- =====================================================
         INTRO STRIP
    ====================================================== -->

    <section class="vm-visa-intro">

      <div class="container">

        <div class="vm-intro-grid">

          <div>
            <span class="vm-section-number">01 / VISA MASTER</span>

            <h2>
              One place for
              <span>global travel.</span>
            </h2>
          </div>

          <div>

            <p>
              Every journey has different visa requirements. We help you
              understand the process, prepare the required documents and
              choose the right service for your travel purpose.
            </p>

            <p>
              Whether you are travelling for tourism, business, study,
              family visits, medical treatment or religious purposes,
              our team is here to assist you.
            </p>

          </div>

        </div>

      </div>

    </section>


    <!-- =====================================================
         VISA CATEGORIES
    ====================================================== -->

    <section class="vm-visa-categories" id="visa-categories">

      <div class="container">

        <div class="vm-section-head">

          <div>
            <span class="vm-section-number">02 / VISA TYPES</span>

            <h2>
              Choose your
              <span>purpose.</span>
            </h2>
          </div>

          <p>
            Different journeys require different visas. Explore the
            categories we assist with and speak with our team for
            destination-specific requirements.
          </p>

        </div>


        <div class="vm-visa-list">

          <!-- TOURIST -->

          <article class="vm-visa-card">

            <div class="vm-visa-index">01</div>

            <div class="vm-visa-icon">✈</div>

            <div class="vm-visa-content">

              <div class="vm-visa-heading">
                <h3>Tourist Visa</h3>
                <span>TRAVEL · HOLIDAY</span>
              </div>

              <p>
                For holidays, sightseeing, vacations and leisure travel.
                We assist with application guidance and required
                documentation.
              </p>

              <div class="vm-visa-tags">
                <span>Holiday</span>
                <span>Tourism</span>
                <span>Family Trip</span>
              </div>

            </div>

            <a href="/contact" class="vm-arrow">
              →
            </a>

          </article>


          <!-- BUSINESS -->

          <article class="vm-visa-card vm-card-highlight">

            <div class="vm-visa-index">02</div>

            <div class="vm-visa-icon">▣</div>

            <div class="vm-visa-content">

              <div class="vm-visa-heading">
                <h3>Business Visa</h3>
                <span>MEETINGS · BUSINESS</span>
              </div>

              <p>
                Assistance for business meetings, conferences, trade
                visits, exhibitions and other professional travel purposes.
              </p>

              <div class="vm-visa-tags">
                <span>Meetings</span>
                <span>Conference</span>
                <span>Trade Visit</span>
              </div>

            </div>

            <a href="/contact" class="vm-arrow">
              →
            </a>

          </article>


          <!-- STUDENT -->

          <article class="vm-visa-card">

            <div class="vm-visa-index">03</div>

            <div class="vm-visa-icon">✦</div>

            <div class="vm-visa-content">

              <div class="vm-visa-heading">
                <h3>Student Visa</h3>
                <span>EDUCATION · STUDY</span>
              </div>

              <p>
                Guidance for students planning to study abroad, including
                documentation preparation and application support.
              </p>

              <div class="vm-visa-tags">
                <span>Study</span>
                <span>University</span>
                <span>Education</span>
              </div>

            </div>

            <a href="/contact" class="vm-arrow">
              →
            </a>

          </article>


          <!-- TRANSIT -->

          <article class="vm-visa-card">

            <div class="vm-visa-index">04</div>

            <div class="vm-visa-icon">⇢</div>

            <div class="vm-visa-content">

              <div class="vm-visa-heading">
                <h3>Transit Visa</h3>
                <span>LAYOVER · CONNECTION</span>
              </div>

              <p>
                Support for travellers passing through another country
                while connecting to their final destination.
              </p>

              <div class="vm-visa-tags">
                <span>Transit</span>
                <span>Airport</span>
                <span>Connection</span>
              </div>

            </div>

            <a href="/contact" class="vm-arrow">
              →
            </a>

          </article>


          <!-- VISIT / FAMILY -->

          <article class="vm-visa-card">

            <div class="vm-visa-index">05</div>

            <div class="vm-visa-icon">⌂</div>

            <div class="vm-visa-content">

              <div class="vm-visa-heading">
                <h3>Visit & Family Visa</h3>
                <span>FAMILY · FRIENDS</span>
              </div>

              <p>
                Assistance for travellers visiting relatives, friends or
                other personal contacts abroad.
              </p>

              <div class="vm-visa-tags">
                <span>Family</span>
                <span>Friends</span>
                <span>Visit</span>
              </div>

            </div>

            <a href="/contact" class="vm-arrow">
              →
            </a>

          </article>


          <!-- E VISA -->

          <article class="vm-visa-card vm-card-highlight">

            <div class="vm-visa-index">06</div>

            <div class="vm-visa-icon">⌁</div>

            <div class="vm-visa-content">

              <div class="vm-visa-heading">
                <h3>E-Visa</h3>
                <span>ONLINE · DIGITAL</span>
              </div>

              <p>
                Assistance with eligible online visa applications and
                electronic travel authorisations for supported destinations.
              </p>

              <div class="vm-visa-tags">
                <span>Online</span>
                <span>Digital</span>
                <span>Fast Process</span>
              </div>

            </div>

            <a href="/contact" class="vm-arrow">
              →
            </a>

          </article>


          <!-- MEDICAL -->

          <article class="vm-visa-card">

            <div class="vm-visa-index">07</div>

            <div class="vm-visa-icon">+</div>

            <div class="vm-visa-content">

              <div class="vm-visa-heading">
                <h3>Medical Visa</h3>
                <span>TREATMENT · HEALTHCARE</span>
              </div>

              <p>
                Assistance for travellers seeking medical treatment or
                healthcare-related travel where applicable.
              </p>

              <div class="vm-visa-tags">
                <span>Treatment</span>
                <span>Hospital</span>
                <span>Medical Travel</span>
              </div>

            </div>

            <a href="/contact" class="vm-arrow">
              →
            </a>

          </article>


          <!-- RELIGIOUS -->

          <article class="vm-visa-card">

            <div class="vm-visa-index">08</div>

            <div class="vm-visa-icon">☾</div>

            <div class="vm-visa-content">

              <div class="vm-visa-heading">
                <h3>Religious Travel</h3>
                <span>UMRAH · RELIGIOUS</span>
              </div>

              <p>
                Support for religious travel requirements, including
                assistance related to Umrah travel.
              </p>

              <div class="vm-visa-tags">
                <span>Umrah</span>
                <span>Religious</span>
                <span>Travel</span>
              </div>

            </div>

            <a href="/contact" class="vm-arrow">
              →
            </a>

          </article>

        </div>

      </div>

    </section>


    <!-- =====================================================
         SPECIAL SERVICES
    ====================================================== -->

    <section class="vm-special-services">

      <div class="container">

        <div class="vm-special-layout">

          <div class="vm-special-intro">

            <span class="vm-section-number light">
              03 / BEYOND VISAS
            </span>

            <h2>
              More than
              <span>just visas.</span>
            </h2>

            <p>
              International travel often needs more than a visa.
              VisaMaster also assists with important travel documentation
              and destination-specific requirements.
            </p>

            <a href="/contact" class="vm-special-link">
              Ask our team
              <span>→</span>
            </a>

          </div>


          <div class="vm-special-grid">

            <div class="vm-special-card">

              <div class="vm-special-icon">☾</div>

              <div>
                <span>01</span>
                <h3>Umrah Visa</h3>
                <p>
                  Assistance for Umrah visa-related travel requirements.
                </p>
              </div>

            </div>


            <div class="vm-special-card">

              <div class="vm-special-icon">✈</div>

              <div>
                <span>02</span>
                <h3>OK to Board</h3>
                <p>
                  Support for OK to Board requirements, including
                  Dubai-related travel cases.
                </p>
              </div>

            </div>


            <div class="vm-special-card">

              <div class="vm-special-icon">✚</div>

              <div>
                <span>03</span>
                <h3>Yellow Fever</h3>
                <p>
                  Assistance regarding yellow fever certificate
                  requirements for applicable travel.
                </p>
              </div>

            </div>


            <div class="vm-special-card vm-special-yellow">

              <div class="vm-special-icon">▤</div>

              <div>
                <span>04</span>
                <h3>Arrival Card</h3>
                <p>
                  Support with destination-specific arrival card and
                  travel information requirements.
                </p>
              </div>

            </div>


            <div class="vm-special-card">

              <div class="vm-special-icon">✓</div>

              <div>
                <span>05</span>
                <h3>Document Attestation</h3>
                <p>
                  Assistance with document attestation requirements for
                  international purposes.
                </p>
              </div>

            </div>


            <div class="vm-special-card">

              <div class="vm-special-icon">◎</div>

              <div>
                <span>06</span>
                <h3>Travel Documentation</h3>
                <p>
                  Guidance for additional documents required for your
                  destination and travel purpose.
                </p>
              </div>

            </div>

          </div>

        </div>

      </div>

    </section>


    <!-- =====================================================
         DESTINATION COVERAGE
    ====================================================== -->

    <section class="vm-destinations">

      <div class="container">

        <div class="vm-section-head vm-destination-head">

          <div>
            <span class="vm-section-number">04 / DESTINATIONS</span>

            <h2>
              Where will you
              <span>go next?</span>
            </h2>
          </div>

          <p>
            We assist travellers with visa and travel documentation
            requirements for destinations across different regions.
          </p>

        </div>


        <div class="vm-destination-cloud">

          <a href="/destinations" class="vm-country-pill">
            🇦🇪 UAE
          </a>

          <a href="/destinations" class="vm-country-pill">
            🇺🇸 USA
          </a>

          <a href="/destinations" class="vm-country-pill">
            🇨🇦 Canada
          </a>

          <a href="/destinations" class="vm-country-pill">
            🇬🇧 United Kingdom
          </a>

          <a href="/destinations" class="vm-country-pill">
            🇦🇺 Australia
          </a>

          <% if (typeof countries !== "undefined" && countries.length) { %>

            <% countries.forEach(function(country) { %>

              <a
                href="/countries/<%= country.slug %>"
                class="vm-country-pill"
              >
                <%= country.name %>
              </a>

            <% }) %>

          <% } %>

        </div>


        <div class="vm-destination-note">

          <span>✦</span>

          <p>
            Looking for a destination not listed here?
            Our team can help you understand the current requirements.
          </p>

          <a href="/contact">
            Talk to us →
          </a>

        </div>

      </div>

    </section>


    <!-- =====================================================
         PROCESS
    ====================================================== -->

    <section class="vm-process">

      <div class="container">

        <div class="vm-section-head">

          <div>
            <span class="vm-section-number">05 / HOW IT WORKS</span>

            <h2>
              Simple steps.
              <span>Clear journey.</span>
            </h2>
          </div>

          <p>
            We keep the process straightforward so you know what happens
            at every stage of your visa journey.
          </p>

        </div>


        <div class="vm-process-grid">

          <div class="vm-process-step">

            <div class="vm-process-number">01</div>

            <div class="vm-process-icon">
              ☎
            </div>

            <h3>Tell Us Your Plan</h3>

            <p>
              Share your destination, travel purpose and basic details.
            </p>

          </div>


          <div class="vm-process-line"></div>


          <div class="vm-process-step">

            <div class="vm-process-number">02</div>

            <div class="vm-process-icon">
              ◫
            </div>

            <h3>Check Documents</h3>

            <p>
              Our team helps you understand the documents required.
            </p>

          </div>


          <div class="vm-process-line"></div>


          <div class="vm-process-step">

            <div class="vm-process-number">03</div>

            <div class="vm-process-icon">
              ✓
            </div>

            <h3>Application Support</h3>

            <p>
              Get assistance while preparing and processing your
              application.
            </p>

          </div>


          <div class="vm-process-line"></div>


          <div class="vm-process-step">

            <div class="vm-process-number">04</div>

            <div class="vm-process-icon">
              ✈
            </div>

            <h3>Travel Ready</h3>

            <p>
              Complete the required formalities and prepare for your
              journey.
            </p>

          </div>

        </div>

      </div>

    </section>


    <!-- =====================================================
         INFORMATION
    ====================================================== -->

    <section class="vm-visa-info">

      <div class="container">

        <div class="vm-info-box">

          <div class="vm-info-symbol">
            !
          </div>

          <div>

            <span>IMPORTANT</span>

            <h3>
              Visa requirements can change.
            </h3>

            <p>
              Visa eligibility, documents, processing times, fees and
              entry requirements can vary by destination, nationality
              and travel purpose. Always confirm the applicable
              requirements before submitting an application.
            </p>

          </div>

        </div>

      </div>

    </section>


    <!-- =====================================================
         CTA
    ====================================================== -->

    <section class="vm-visa-cta">

      <div class="container">

        <div class="vm-cta-box">

          <div class="vm-cta-decoration">
            ✈
          </div>

          <div class="vm-cta-content">

            <span class="vm-section-number light">
              06 / LET'S PLAN
            </span>

            <h2>
              Got a destination
              <span>in mind?</span>
            </h2>

            <p>
              Tell us where you want to go and what you need.
              Our team will guide you through the next steps.
            </p>

            <a href="/contact" class="vm-btn vm-btn-yellow">
              Get Started
              <span>→</span>
            </a>

          </div>

        </div>

      </div>

    </section>

  </main>


  <%- include("../partials/footer") %>
  <script src="/js/main.js"></script>

</body>
</html>