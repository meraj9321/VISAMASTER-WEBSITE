<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />

  <title>Sticker Visa Destinations | VisaMaster</title>

  <meta
    name="description"
    content="Explore countries offering Sticker Visa options with VisaMaster."
  />

  <link rel="stylesheet" href="/css/global.css" />
  <link rel="stylesheet" href="/css/navbar.css" />
  <link rel="stylesheet" href="/css/sticker-visa.css" />
  <link rel="stylesheet" href="/css/footer.css" />

  <script src="/js/main.js" defer></script>
  <script src="/js/sticker-visa.js" defer></script>
</head>

<body>

  <%- include("../partials/navbar", { currentPage: "sticker-visa" }) %>

  <%
    const directoryCountries = Array.isArray(countries) ? countries : [];

    const flagPath = (flag) => {
      const value = String(flag || "").trim();

      if (value.startsWith("public/")) {
        return value.replace(/^public/, "");
      }

      if (
        value &&
        !value.startsWith("/") &&
        !/^https?:\/\//i.test(value)
      ) {
        return "/" + value;
      }

      return value;
    };

    const isFlagImage = (flag) => {
      const value = String(flag || "").trim();

      return /^(https?:\/\/|\/|images\/|public\/)/i.test(value) &&
        /\.(png|jpe?g|svg|webp)(\?.*)?$/i.test(value);
    };
  %>

  <main class="sv-page">

    <!-- HERO SECTION -->
    <section class="sv-hero">

      <div class="sv-container sv-hero-inner">

        <div>
          <span class="sv-eyebrow">
            VisaMaster / Digital travel desk
          </span>

          <h1>
            Travel prepared.<br />
            <span>Go Sticker Visa.</span>
          </h1>

          <p class="sv-hero-copy">
            Explore destinations with an active Sticker Visa category.
            Find your country, review the available visa options and get
            a clearer picture of the next steps.
          </p>

          <div class="sv-hero-points">
            <span><b>✓</b> Country directory</span>
            <span><b>✓</b> Requirements access</span>
            <span><b>✓</b> Guided next steps</span>
          </div>
        </div>

        <div class="sv-passport" aria-hidden="true">
          <small>VISAMASTER • TRAVEL DOCUMENT</small>

          <div class="sv-passport-mark">✈</div>

          <strong>STICKER VISA</strong>

          <div class="sv-passport-line"></div>
          <div class="sv-passport-line"></div>
        </div>

      </div>
    </section>


    <!-- SEARCH SECTION -->
    <div class="sv-search-area">

      <div class="sv-container">

        <div class="sv-search-panel">

          <span class="sv-search-symbol" aria-hidden="true">
            ⌕
          </span>

          <div class="sv-search-content">

  <label for="vmCountrySearch">
    SEARCH YOUR DESTINATION
  </label>

  <input
    type="search"
    id="vmCountrySearch"
    placeholder="Enter a country name (e.g. Singapore)..."
    autocomplete="off"
    aria-label="Search Sticker Visa countries"
    aria-autocomplete="list"
    aria-controls="vmCountrySuggestions"
    aria-expanded="false"
  />

  <!-- AUTOCOMPLETE SUGGESTIONS -->
  <div
    class="sv-suggestions"
    id="vmCountrySuggestions"
    role="listbox"
    aria-label="Available countries"
    hidden
  ></div>

</div>

          <span class="sv-search-hint">
            STICKER VISA DIRECTORY
          </span>

          <button
            type="button"
            id="vmClearCountrySearch"
            aria-label="Clear country search"
            hidden
          >
            <span aria-hidden="true">&times;</span>
            <span class="sv-clear-text">Clear</span>
          </button>

        </div>

      </div>
    </div>


    <!-- COUNTRY DIRECTORY -->
    <section class="sv-directory" id="visa-directory">

      <div class="sv-container">

        <div class="sv-section-top">

          <div>
            <span class="sv-section-kicker">
              Your next destination
            </span>

            <h2>Where would you like to go?</h2>

            <p>
              Choose a country to view its Sticker Visa options and requirements.
            </p>
          </div>

          <div class="sv-count">

            <strong id="vmCountryCount">
              <%= directoryCountries.length %>
            </strong>

            <span id="vmCountryCountLabel">
              countries found
            </span>

          </div>

        </div>


        <% if (typeof loadError !== "undefined" && loadError) { %>

          <div class="sv-message" role="status">

            <strong>
              The Sticker Visa directory is temporarily unavailable.
            </strong>

            Please refresh the page or contact our team for assistance.

          </div>

        <% } else if (directoryCountries.length === 0) { %>

          <div class="sv-message" role="status">

            <strong>
              No Sticker Visa destinations are currently listed.
            </strong>

            Please check again later or contact our team for assistance.

          </div>

        <% } else { %>

          <div
            class="sv-country-grid vm-country-grid"
            id="vmCountryGrid"
          >

            <% directoryCountries.forEach((country, index) => {

              const countryFlag = String(country.flag || "").trim();

              const countryFlagIsImage = isFlagImage(countryFlag);

              const countryFlagPath = flagPath(countryFlag);

            %>

              <article
                class="sv-country-card vm-visa-country-card"
                data-country-slug="<%= country.slug %>"
                data-country-name="<%= country.name %>"
              >

                <span class="sv-card-index">
                  <%= String(index + 1).padStart(2, "0") %>
                </span>

                <div class="sv-card-top">

                  <span class="sv-flag" aria-hidden="true">

                    <% if (countryFlagIsImage) { %>

                      <img
                        src="<%= countryFlagPath %>"
                        alt="<%= country.name %> flag"
                        loading="lazy"
                      />

                      <span class="sv-flag-fallback" hidden>
                        🌍
                      </span>

                    <% } else { %>

                      <span class="sv-flag-fallback">
                        <%= countryFlag || "🌍" %>
                      </span>

                    <% } %>

                  </span>

                  <div class="sv-country-info">

                    <h3>
                      <%= country.name %>
                    </h3>

                    <span class="sv-available">
                      Sticker Visa category listed
                    </span>

                  </div>

                </div>


                <a
                  class="sv-card-link vm-country-requirements-link"
                  href="/countries/<%= country.slug %>/requirements/sticker-visa?returnTo=/visas/sticker-visa"
                >

                  <span class="sv-card-link-text">
                    Explore Sticker Visa requirements
                  </span>

                  <span aria-hidden="true">→</span>

                </a>

              </article>

            <% }) %>

          </div>


          <!-- NO RESULTS -->
          <div
            class="sv-no-results vm-directory-no-results"
            id="vmVisaNoResults"
            hidden
          >

            <h3>No matching destination</h3>

            <p>
              Try another country name or contact our team for assistance.
            </p>

            <a class="sv-contact-link" href="/contact">
              Ask VisaMaster →
            </a>

          </div>

        <% } %>


        <!-- DISCLAIMER -->
        <p class="sv-disclaimer">

          <b>ⓘ Important:</b>

          Sticker Visa availability, eligibility, fees and application
          methods may vary by nationality and travel purpose.
          Confirm current rules before submitting an application.

        </p>

      </div>
    </section>


    <!-- PROCESS SECTION -->
    <section class="sv-steps" aria-labelledby="evStepsTitle">

      <div class="sv-container">

        <div class="sv-steps-heading">

          <span class="sv-section-kicker">
            A simple route forward
          </span>

          <h2 id="evStepsTitle">
            Your Sticker Visa journey, made clearer.
          </h2>

          <p>
            Start with a destination, understand the visa options and
            review the information before proceeding.
          </p>

        </div>


        <div class="sv-steps-grid">

          <article class="sv-step">

            <span class="sv-step-no">STEP 01</span>

            <span class="sv-step-icon" aria-hidden="true">
              ⌕
            </span>

            <h3>Find a country</h3>

            <p>
              Search the directory and choose the destination you plan to visit.
            </p>

          </article>


          <article class="sv-step">

            <span class="sv-step-no">STEP 02</span>

            <span class="sv-step-icon" aria-hidden="true">
              ◎
            </span>

            <h3>Explore visa options</h3>

            <p>
              Review the active Sticker Visa purposes and information
              available for that country.
            </p>

          </article>


          <article class="sv-step">

            <span class="sv-step-no">STEP 03</span>

            <span class="sv-step-icon" aria-hidden="true">
              ✓
            </span>

            <h3>Check requirements</h3>

            <p>
              Read the eligibility and document details, or contact
              our team if you need help.
            </p>

          </article>

        </div>

      </div>
    </section>


    <!-- FINAL CTA -->
    <section class="sv-note">

      <div class="sv-container">

        <div class="sv-note-inner">

          <span class="sv-note-icon" aria-hidden="true">
            !
          </span>

          <div class="sv-note-copy">

            <h3>Visa rules can change.</h3>

            <p>
              Eligibility, fees, processing times and required documents
              may differ by nationality and travel purpose. Always confirm
              the latest rules before applying.
            </p>

          </div>

          <a class="sv-note-link" href="/contact">
            Talk to our team →
          </a>

        </div>

      </div>
    </section>

  </main>


  <%- include("../partials/footer") %>

</body>
</html>