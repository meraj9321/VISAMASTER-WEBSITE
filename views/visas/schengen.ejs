<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />

  <title>Schengen Countries & Visa Requirements | VisaMaster</title>

  <meta
    name="description"
    content="Explore Schengen Area countries and review the visa requirements available on VisaMaster."
  />

  <link rel="stylesheet" href="/css/global.css" />
  <link rel="stylesheet" href="/css/navbar.css" />
  <link rel="stylesheet" href="/css/visas.css" />
  <link rel="stylesheet" href="/css/schengen.css" />
  <link rel="stylesheet" href="/css/footer.css" />

  <script src="/js/main.js" defer></script>
  <script src="/js/schengen.js" defer></script>
</head>

<body>

  <%- include("../partials/navbar", { currentPage: "schengen" }) %>

  <%
    const schengenCountries = Array.isArray(countries) ? countries : [];
  %>

  <main class="vm-directory-page">

    <section class="vm-directory-section" id="schengen-directory">
      <div class="container">

        <div class="vm-directory-section-heading">
          <div>
            <span class="vm-directory-section-number">
              01 / SCHENGEN AREA
            </span>

            <h2>
              Explore <span>Schengen countries.</span>
            </h2>
          </div>

          <p>
            Browse the countries marked as part of the Schengen Area
            by the VisaMaster team. Select a country to explore
            available visa categories and requirements.
          </p>
        </div>

        <!-- SEARCH -->
        <div class="schengen-search-wrapper">
          <div class="schengen-search-box">

            <span class="schengen-search-icon" aria-hidden="true">⌕</span>

            <div class="schengen-search-field">
              <label for="schengenCountrySearch">
                SEARCH SCHENGEN COUNTRIES
              </label>

              <input
                type="search"
                id="schengenCountrySearch"
                placeholder="Search a country, e.g. France, Germany..."
                autocomplete="off"
                aria-label="Search Schengen countries"
                aria-autocomplete="list"
                aria-controls="schengenSuggestions"
                aria-expanded="false"
                role="combobox"
              />

              <div
                class="schengen-suggestions"
                id="schengenSuggestions"
                role="listbox"
                aria-label="Schengen country suggestions"
                hidden
              ></div>
            </div>

            <button
              type="button"
              id="schengenClearSearch"
              class="schengen-clear-button"
              aria-label="Clear search"
              hidden
            >
              <span aria-hidden="true">&times;</span>
              <span>Clear</span>
            </button>

          </div>
        </div>

        <!-- RESULTS HEADING -->
        <div class="vm-directory-results-head">
          <div>
            <span class="vm-directory-results-kicker">
              SCHENGEN DESTINATIONS
            </span>

            <h3>
              Schengen <span>countries</span>
            </h3>

            <p>
              Choose a country to view its available visa categories.
            </p>
          </div>

          <div class="vm-directory-result-count">
            <strong id="schengenCountryCount"><%= schengenCountries.length %></strong>

            <span id="schengenCountryCountLabel">
              <%= schengenCountries.length === 1
                ? "country listed"
                : "countries listed" %>
            </span>
          </div>
        </div>

        <% if (loadError) { %>

          <div class="vm-directory-message" role="status">
            <strong>
              Schengen country list is temporarily unavailable.
            </strong>

            <span>
              Please refresh the page or contact VisaMaster for assistance.
            </span>
          </div>

        <% } else if (!schengenCountries.length) { %>

          <div class="vm-directory-no-results">
            <span class="vm-no-results-icon" aria-hidden="true">⌕</span>

            <h3>No Schengen countries have been listed yet</h3>

            <p>
              Countries will appear here after the VisaMaster team
              marks them as part of the Schengen Area in the admin panel.
            </p>

            <a class="vm-directory-btn vm-btn-primary" href="/contact">
              Ask VisaMaster <span aria-hidden="true">→</span>
            </a>
          </div>

        <% } else { %>

          <!-- COUNTRY GRID -->
          <div class="vm-country-grid" id="vmSchengenCountryGrid">

            <% schengenCountries.forEach((country, index) => { %>

              <%
                const flagValue = String(country.flag || "").trim();

                const flagIsImage =
                  /^(https?:\/\/|\/|images\/|public\/)/i.test(flagValue) &&
                  /\.(png|jpe?g|svg|webp)(\?.*)?$/i.test(flagValue);

                let flagImagePath = flagValue;

                if (flagImagePath.startsWith("public/")) {
                  flagImagePath = flagImagePath.replace(/^public/, "");
                } else if (
                  flagImagePath &&
                  !flagImagePath.startsWith("/") &&
                  !/^https?:\/\//i.test(flagImagePath)
                ) {
                  flagImagePath = "/" + flagImagePath;
                }
              %>

              <article
                class="vm-visa-country-card schengen-country-card"
                data-country-name="<%= country.name %>"
                data-country-slug="<%= country.slug %>"
              >

                <div class="vm-country-card-main">

                  <span class="vm-country-flag" aria-hidden="true">

                    <% if (flagIsImage) { %>

                      <img
                        src="<%= flagImagePath %>"
                        alt="<%= country.name %> flag"
                        loading="lazy"
                      />

                      <span class="schengen-flag-fallback" hidden>🌍</span>

                    <% } else { %>

                      <span class="schengen-flag-fallback">
                        <%= flagValue || "🌍" %>
                      </span>

                    <% } %>

                  </span>

                  <div class="vm-country-card-name">
                    <h4><%= country.name %></h4>
                    <span>Schengen visa requirements</span>
                  </div>

                  <span class="vm-country-card-arrow" aria-hidden="true">
                    ↗
                  </span>

                </div>

                <a
                  class="vm-country-requirements-link schengen-requirements-link"
                  href="/countries/<%= encodeURIComponent(country.slug) %>/visa-categories?returnTo=%2Fvisas%2Fschengen"
                >
                  Explore Visa Categories
                  <span aria-hidden="true">→</span>
                </a>

              </article>

            <% }) %>

          </div>

          <!-- NO SEARCH RESULTS -->
          <div
            class="schengen-no-results"
            id="schengenNoResults"
            role="status"
            hidden
          >
            <span class="vm-no-results-icon" aria-hidden="true">⌕</span>

            <h3>No matching Schengen country found</h3>

            <p>
              Try another country name or check your spelling.
            </p>

            <button
              type="button"
              id="schengenResetSearch"
              class="vm-directory-btn vm-btn-primary"
            >
              Show all countries
            </button>
          </div>

        <% } %>

        <p class="vm-directory-disclaimer">
          <span aria-hidden="true">ⓘ</span>

          Visa rules and entry conditions can change and may depend
          on your nationality and travel purpose. Confirm current
          requirements before applying.
        </p>

      </div>
    </section>

    <!-- CTA -->
    <section class="vm-directory-cta">
      <div class="container">

        <div class="vm-directory-cta-box">
          <div class="vm-cta-decoration" aria-hidden="true">✈</div>

          <span class="vm-directory-section-number vm-light-number">
            NEED HELP?
          </span>

          <h2>
            Planning a trip to <span>Europe?</span>
          </h2>

          <p>
            Contact VisaMaster for assistance understanding
            the next steps for your destination.
          </p>

          <a href="/contact" class="vm-directory-btn vm-btn-yellow">
            Contact our team <span aria-hidden="true">→</span>
          </a>
        </div>

      </div>
    </section>

  </main>

  <%- include("../partials/footer") %>

</body>
</html>