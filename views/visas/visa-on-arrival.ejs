<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Visa on Arrival Destinations | VisaMaster</title>
  <meta name="description" content="Explore countries offering Visa on Arrival options with VisaMaster." />

  <link rel="stylesheet" href="/css/global.css" />
  <link rel="stylesheet" href="/css/navbar.css" />
  <link rel="stylesheet" href="/css/visa-on-arrival.css" />
  <link rel="stylesheet" href="/css/footer.css" />

  <script src="/js/main.js" defer></script>
  <script src="/js/visa-on-arrival.js" defer></script>
</head>

<body>
  <%- include("../partials/navbar", { currentPage: "visa-on-arrival" }) %>

  <%
    const directoryCountries = Array.isArray(countries) ? countries : [];

    const flagPath = (flag) => {
      const value = String(flag || "").trim();
      if (value.startsWith("public/")) return value.replace(/^public/, "");
      if (value && !value.startsWith("/") && !/^https?:\/\//i.test(value)) {
        return "/" + value;
      }
      return value;
    };

    const isFlagImage = (flag) => {
      const value = String(flag || "").trim();
      return /^(https?:\/\/|\/|images\/|public\/)/i.test(value) &&
        /\.(png|jpe?g|svg|webp)(\?.*)?$/i.test(value);
    };
  %>

  <main class="va-page">

    <!-- HERO -->
    <section class="va-hero">
      <div class="va-container va-hero-inner">
        <div>
          <span class="va-eyebrow">VisaMaster / Digital travel desk</span>

          <h1>
            Land with ease.<br />
            <span>Get Visa on Arrival.</span>
          </h1>

          <p class="va-hero-copy">
            Explore destinations with an active Visa on Arrival category.
            Find your country, review the available visa options and get
            a clearer picture of the next steps.
          </p>

          <div class="va-hero-points">
            <span><b>✓</b> Country directory</span>
            <span><b>✓</b> Requirements access</span>
            <span><b>✓</b> Guided next steps</span>
          </div>
        </div>

        <div class="va-passport" aria-hidden="true">
          <small>VISAMASTER • TRAVEL DOCUMENT</small>
          <div class="va-passport-mark">✈</div>
          <strong>VISA ON ARRIVAL</strong>
          <div class="va-passport-line"></div>
          <div class="va-passport-line"></div>
        </div>
      </div>
    </section>

    <!-- SEARCH -->
    <div class="va-search-area">
      <div class="va-container">
        <div class="va-search-panel">

          <span class="va-search-symbol" aria-hidden="true">⌕</span>

          <div class="va-search-content">
            <label for="vmCountrySearch">SEARCH YOUR DESTINATION</label>

            <input
              type="search"
              id="vmCountrySearch"
              placeholder="Enter a country name (e.g. Singapore)..."
              autocomplete="off"
              aria-label="Search Visa on Arrival countries"
              aria-autocomplete="list"
              aria-controls="vmCountrySuggestions"
              aria-expanded="false"
              role="combobox"
            />

            <!-- AUTOCOMPLETE SUGGESTIONS -->
            <div
              class="va-suggestions"
              id="vmCountrySuggestions"
              role="listbox"
              aria-label="Country suggestions"
              hidden
            ></div>
          </div>

          <span class="va-search-hint">VISA ON ARRIVAL DIRECTORY</span>

          <button
            type="button"
            id="vmClearCountrySearch"
            aria-label="Clear country search"
            hidden
          >
            <span aria-hidden="true">&times;</span>
            <span class="va-clear-text">Clear</span>
          </button>

        </div>
      </div>
    </div>

    <!-- COUNTRY DIRECTORY -->
    <section class="va-directory" id="visa-directory">
      <div class="va-container">

        <div class="va-section-top">
          <div>
            <span class="va-section-kicker">Your next destination</span>
            <h2>Where would you like to go?</h2>
            <p>
              Choose a country to view its Visa on Arrival options and requirements.
            </p>
          </div>

          <div class="va-count">
            <strong id="vmCountryCount"><%= directoryCountries.length %></strong>
            <span id="vmCountryCountLabel">countries found</span>
          </div>
        </div>

        <% if (typeof loadError !== "undefined" && loadError) { %>

          <div class="va-message" role="status">
            <strong>The Visa on Arrival directory is temporarily unavailable.</strong>
            Please refresh the page or contact our team for assistance.
          </div>

        <% } else if (directoryCountries.length === 0) { %>

          <div class="va-message" role="status">
            <strong>No Visa on Arrival destinations are currently listed.</strong>
            Please check again later or contact our team for assistance.
          </div>

        <% } else { %>

          <div class="va-country-grid vm-country-grid" id="vmCountryGrid">

            <% directoryCountries.forEach((country, index) => {
              const countryFlag = String(country.flag || "").trim();
              const countryFlagIsImage = isFlagImage(countryFlag);
              const countryFlagPath = flagPath(countryFlag);
            %>

              <article
                class="va-country-card vm-visa-country-card"
                data-country-slug="<%= country.slug %>"
                data-country-name="<%= country.name %>"
              >

                <span class="va-card-index">
                  <%= String(index + 1).padStart(2, "0") %>
                </span>

                <div class="va-card-top">

                  <span class="va-flag" aria-hidden="true">

                    <% if (countryFlagIsImage) { %>

                      <img
                        src="<%= countryFlagPath %>"
                        alt="<%= country.name %> flag"
                        loading="lazy"
                      />

                      <span class="va-flag-fallback" hidden>🌍</span>

                    <% } else { %>

                      <span class="va-flag-fallback">
                        <%= countryFlag || "🌍" %>
                      </span>

                    <% } %>

                  </span>

                  <div class="va-country-info">
                    <h3><%= country.name %></h3>

                    <span class="va-available">
                      Visa on Arrival category listed
                    </span>
                  </div>

                </div>

                <a
                  class="va-card-link vm-country-requirements-link"
                  href="/countries/<%= country.slug %>/requirements/visa-on-arrival?returnTo=/visas/visa-on-arrival"
                >
                  <span>Explore Visa on Arrival requirements</span>
                  <span aria-hidden="true">→</span>
                </a>

              </article>

            <% }) %>

          </div>

          <div
            class="va-no-results vm-directory-no-results"
            id="vmVisaNoResults"
            hidden
          >
            <h3>No matching destination</h3>
            <p>Try another country name or contact our team for assistance.</p>
            <a class="va-contact-link" href="/contact">Ask VisaMaster →</a>
          </div>

        <% } %>

        <p class="va-disclaimer">
          <b>ⓘ Important:</b>
          Visa on Arrival availability, eligibility, fees and application
          methods may vary by nationality and travel purpose. Confirm current
          rules before submitting an application.
        </p>

      </div>
    </section>

    <!-- STEPS -->
    <section class="va-steps" aria-labelledby="evStepsTitle">
      <div class="va-container">

        <div class="va-steps-heading">
          <span class="va-section-kicker">A simple route forward</span>

          <h2 id="evStepsTitle">
            Your Visa on Arrival journey, made clearer.
          </h2>

          <p>
            Start with a destination, understand the visa options and review
            the information before proceeding.
          </p>
        </div>

        <div class="va-steps-grid">

          <article class="va-step">
            <span class="va-step-no">STEP 01</span>
            <span class="va-step-icon" aria-hidden="true">⌕</span>
            <h3>Find a country</h3>
            <p>
              Search the directory and choose the destination you plan to visit.
            </p>
          </article>

          <article class="va-step">
            <span class="va-step-no">STEP 02</span>
            <span class="va-step-icon" aria-hidden="true">◎</span>
            <h3>Explore visa options</h3>
            <p>
              Review the active Visa on Arrival purposes and information
              available for that country.
            </p>
          </article>

          <article class="va-step">
            <span class="va-step-no">STEP 03</span>
            <span class="va-step-icon" aria-hidden="true">✓</span>
            <h3>Check requirements</h3>
            <p>
              Read the eligibility and document details, or contact our team
              if you need help.
            </p>
          </article>

        </div>
      </div>
    </section>

    <!-- CONTACT NOTE -->
    <section class="va-note">
      <div class="va-container">

        <div class="va-note-inner">

          <span class="va-note-icon" aria-hidden="true">!</span>

          <div class="va-note-copy">
            <h3>Visa rules can change.</h3>
            <p>
              Eligibility, fees, processing times and required documents may
              differ by nationality and travel purpose. Always confirm the
              latest rules before applying.
            </p>
          </div>

          <a class="va-note-link" href="/contact">
            Talk to our team →
          </a>

        </div>

      </div>
    </section>

  </main>

  <%- include("../partials/footer") %>

</body>
</html>