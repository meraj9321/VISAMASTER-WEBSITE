
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />

  <title><%= country.name %> Visa Requirements | VisaMaster</title>

  <meta
    name="description"
    content="Check visa eligibility and required documents for <%= country.name %>."
  />

  <link rel="stylesheet" href="/css/global.css" />
  <link rel="stylesheet" href="/css/navbar.css" />
  <link rel="stylesheet" href="/css/requirements.css" />
  <link rel="stylesheet" href="/css/footer.css" />
</head>

<body>

  <%- include("../partials/navbar") %>

  <%
    const activeSelectedCategory =
      typeof selectedCategory !== "undefined" && selectedCategory
        ? selectedCategory
        : null;

    const activeSubCategories = Array.isArray(subCategories)
      ? subCategories.filter(sub => sub && sub.isActive !== false)
      : activeSelectedCategory &&
        Array.isArray(activeSelectedCategory.subCategories)
        ? activeSelectedCategory.subCategories.filter(
            sub => sub && sub.isActive !== false
          )
        : [];

    const categorySelectionUrl =
      `/countries/${encodeURIComponent(country.slug)}/visa-categories`;

    /*
      Preserve the original page from which the user entered
      the country visa category page.

      Example:
      /countries/france/visa-categories?returnTo=%2Fvisas%2Fschengen

      Requirements Back should return to that category page,
      including its original returnTo parameter.
    */

  const categorySelectionBackUrl =
  typeof returnTo === "string" && returnTo.trim()
    ? returnTo.trim()
    : categorySelectionUrl;

    const flagValue = String(country.flag || "").trim();

    const isFlagImage =
      /^(https?:\/\/|\/|images\/|public\/)/i.test(flagValue) &&
      /\.(png|jpe?g|svg|webp)(\?.*)?$/i.test(flagValue);

    let flagImagePath = flagValue;

    if (flagImagePath.startsWith("public/")) {
      flagImagePath = flagImagePath.replace(/^public/, "");
    } else if (
      flagImagePath &&
      !flagImagePath.startsWith("/") &&
      !/^https?:\/\//i.test(flagImagePath)
    ) {
      flagImagePath = "/" + flagImagePath;
    }
  %>

  <main class="requirements-page">

    <!-- HERO SECTION -->

    <section class="requirements-hero">

      <div class="requirements-container">

        <a
          href="<%= categorySelectionBackUrl %>"
          class="requirements-back"
          id="requirementsBackButton"
          aria-label="Go back to the visa categories page"
        >
          <span>←</span>
          <span>Back</span>
        </a>

        <div class="requirements-country">

          <div class="requirements-country-flag">

            <% if (isFlagImage) { %>

              <img
                src="<%= flagImagePath %>"
                alt="<%= country.name %> flag"
                onerror="this.style.display='none'; this.nextElementSibling.style.display='grid';"
              />

              <span
                class="requirements-flag-fallback"
                style="display:none;"
              >
                🌍
              </span>

            <% } else { %>

              <span class="requirements-flag-emoji">
                <%= flagValue || "🌍" %>
              </span>

            <% } %>

          </div>

          <div class="requirements-country-info">

            <span class="requirements-eyebrow">
              VISA DOCUMENT CHECKLIST
            </span>

            <h1>
              <%= country.name %> Visa Requirements
            </h1>

            <p>
              Review the eligibility criteria and document checklist
              for your selected visa purpose.
            </p>

          </div>

        </div>

        <div class="requirements-summary">

          <div class="requirements-summary-item">
            <span class="requirements-summary-icon">📄</span>
            <span>Document Checklist</span>
          </div>

          <div class="requirements-summary-count">
            <strong><%= activeSubCategories.length %></strong>
            <span>Available Visa Purposes</span>
          </div>

        </div>

      </div>

    </section>


    <!-- REQUIREMENTS CONTENT -->

    <section class="requirements-content">

      <div class="requirements-container">

        <% if (activeSelectedCategory) { %>

          <div class="requirements-section-heading">

            <span class="requirements-eyebrow">
              PREPARE YOUR DOCUMENTS
            </span>

            <h2>
              <%= activeSelectedCategory.name %> Requirements
            </h2>

            <p>
              Select your visa purpose below to view its eligibility
              criteria and required documents.
            </p>

          </div>


          <!-- BACK TO CATEGORY SELECTION -->

          <a
            class="requirements-back-category"
            href="<%= categorySelectionBackUrl %>"
          >
            ← Choose another visa category
          </a>


          <% if (activeSubCategories.length > 0) { %>

            <!-- VISA PURPOSE TABS -->

            <div class="visa-category-tabs-wrap">

              <div
                class="visa-category-tabs"
                role="tablist"
                aria-label="<%= activeSelectedCategory.name %> visa purposes"
              >

                <% activeSubCategories.forEach((sub, index) => { %>

                  <button
                    type="button"
                    class="visa-category-tab"
                    id="visa-tab-<%= index %>"
                    role="tab"
                    aria-controls="visa-panel-<%= index %>"
                    aria-selected="<%= index === 0 ? 'true' : 'false' %>"
                    tabindex="<%= index === 0 ? '0' : '-1' %>"
                    data-visa-tab="<%= index %>"
                    data-visa-slug="<%= sub.slug %>"
                  >

                    <span class="visa-category-tab-number">
                      <%= String(index + 1).padStart(2, "0") %>
                    </span>

                    <span class="visa-category-tab-name">
                      <%= sub.name %>
                    </span>

                  </button>

                <% }) %>

              </div>

              <p
                class="visa-category-slider-status"
                aria-live="polite"
              >
                Showing purpose 1 of <%= activeSubCategories.length %>
              </p>

            </div>


            <!-- VISA REQUIREMENTS PANELS -->

            <div class="visa-requirements-list visa-tab-panels">

              <% activeSubCategories.forEach((sub, index) => { %>

                <%
                  // Preserve original pasted text and line breaks.

                  const eligibilityText = Array.isArray(sub.eligibility)
                    ? sub.eligibility
                        .map(item => typeof item === "string" ? item : "")
                        .join("\n")
                    : typeof sub.eligibility === "string"
                      ? sub.eligibility
                      : "";

                  const requirementsText = Array.isArray(sub.requirements)
                    ? sub.requirements
                        .map(item => typeof item === "string" ? item : "")
                        .join("\n")
                    : typeof sub.requirements === "string"
                      ? sub.requirements
                      : "";
                %>

                <section
                  class="visa-tab-panel <%= index === 0 ? 'is-active' : '' %>"
                  id="visa-panel-<%= index %>"
                  role="tabpanel"
                  aria-labelledby="visa-tab-<%= index %>"
                  data-visa-panel="<%= index %>"
                  data-visa-slug="<%= sub.slug %>"
                  <%= index === 0 ? "" : "hidden" %>
                >

                  <article
                    class="visa-requirement-card"
                    id="visa-<%= sub.slug %>"
                  >

                    <!-- VISA HEADER -->

                    <div class="visa-requirement-header">

                      <div class="visa-category-number">
                        <%= String(index + 1).padStart(2, "0") %>
                      </div>

                      <div class="visa-category-info">

                        <h3>
                          <%= sub.name %>
                        </h3>

                        <% if (sub.purpose) { %>

                          <p>
                            <%= sub.purpose %>
                          </p>

                        <% } %>

                      </div>

                      <span class="visa-entry-badge">
                        <%= activeSelectedCategory.name %>
                      </span>

                    </div>


                    <div class="visa-requirement-details">

                      <!-- ABOUT THIS VISA -->

                      <% if (sub.description) { %>

                        <div class="visa-document-section">

                          <h4>
                            <span>ℹ️</span>
                            About this visa
                          </h4>

                          <div class="visa-rich-content">
                            <p><%= sub.description %></p>
                          </div>

                        </div>

                      <% } %>


                      <!-- ELIGIBILITY -->

                      <div class="visa-document-section">

                        <h4>
                          <span>✓</span>
                          Eligibility Requirements
                        </h4>

                        <% if (eligibilityText.trim().length > 0) { %>

                          <div class="visa-plain-text"><%= eligibilityText %></div>

                        <% } else { %>

                          <p class="requirements-unavailable">
                            Eligibility details are not currently available.
                            Contact VisaMaster for assistance.
                          </p>

                        <% } %>

                      </div>


                      <!-- DOCUMENTS REQUIRED -->

                      <div class="visa-document-section">

                        <h4>
                          <span>📄</span>
                          Documents Required
                        </h4>

                        <% if (requirementsText.trim().length > 0) { %>

                          <div class="visa-plain-text"><%= requirementsText %></div>

                        <% } else { %>

                          <p class="requirements-unavailable">
                            Please contact VisaMaster to confirm the
                            documents required for this visa.
                          </p>

                        <% } %>

                      </div>


                      <!-- SUBCATEGORY APPLICATION FORM PDF -->

                      <% if (sub.applicationForm && sub.applicationForm.filename) { %>

                        <section class="application-form-section">

                          <div class="application-form-icon">
                            <span>PDF</span>
                          </div>

                          <div class="application-form-content">

                            <div class="application-form-label">
                              OFFICIAL DOCUMENT
                            </div>

                            <h3>
                              Application Form
                            </h3>

                            <p class="application-form-description">
                              Download the application form for
                              <strong>
                                <%= country.name %> - <%= sub.name %>
                              </strong>.
                              Complete the form before submitting your visa application.
                            </p>

                            <div class="application-form-file">

                              <div class="application-form-file-icon">
                                📄
                              </div>

                              <div class="application-form-file-info">

                                <span class="application-form-filename">
                                  <%= sub.applicationForm.filename %>
                                </span>

                                <span class="application-form-file-type">
                                  PDF Document
                                </span>

                              </div>

                            </div>

                            <div class="application-form-actions">

                              <a
                                href="/countries/<%= encodeURIComponent(country.slug) %>/application-form/<%= encodeURIComponent(activeSelectedCategory.slug) %>/<%= encodeURIComponent(sub.slug) %>"
                                target="_blank"
                                rel="noopener noreferrer"
                                class="application-form-view-btn"
                              >
                                View Application Form
                              </a>

                              <a
                                href="/countries/<%= encodeURIComponent(country.slug) %>/application-form/<%= encodeURIComponent(activeSelectedCategory.slug) %>/<%= encodeURIComponent(sub.slug) %>/download"
                                class="application-form-download-btn"
                              >
                                Download PDF
                              </a>

                            </div>

                          </div>

                          <div
                            class="application-form-decoration"
                            aria-hidden="true"
                          >
                            ✦
                          </div>

                        </section>

                      <% } %>


                      <!-- ASSISTANCE CTA -->

                      <div class="visa-requirement-footer">

                        <div>
                          <strong>
                            Need help preparing your documents?
                          </strong>

                          <p>
                            Our team is here to assist you.
                          </p>
                        </div>

                        <a
                          href="/contact"
                          class="visa-requirement-cta"
                        >
                          Get Assistance →
                        </a>

                      </div>

                    </div>

                  </article>

                </section>

              <% }) %>

            </div>

          <% } else { %>

            <div class="requirements-empty">

              <span class="requirements-empty-icon">
                📋
              </span>

              <h3>
                Requirements Coming Soon
              </h3>

              <p>
                Visa purposes and requirements for this category
                are not currently available.
              </p>

              <a href="/contact" class="visa-requirement-cta">
                Contact VisaMaster →
              </a>

            </div>

          <% } %>

        <% } else { %>

          <div class="requirements-empty">

            <span class="requirements-empty-icon">
              📋
            </span>

            <h3>
              Visa Category Not Found
            </h3>

            <p>
              Please select an available visa category for
              <%= country.name %>.
            </p>

            <a
              href="<%= categorySelectionUrl %>"
              class="visa-requirement-cta"
            >
              View Visa Categories →
            </a>

          </div>

        <% } %>


        <!-- IMPORTANT INFORMATION -->

        <div class="requirements-important-note">

          <span class="requirements-note-icon">
            ℹ️
          </span>

          <div>

            <h3>
              Important Information
            </h3>

            <p>
              Required documents may vary according to the applicant's
              circumstances, visa category and applicable immigration rules.
              Additional documents may be requested by the relevant authority.
              Confirm the latest requirements before applying.
            </p>

          </div>

        </div>

      </div>

    </section>

  </main>


  <%- include("../partials/footer") %>

  <script src="/js/main.js"></script>
  <script src="/js/requirements.js"></script>


  <!-- DYNAMIC PREVIOUS-PAGE NAVIGATION -->

  <script>
    document.addEventListener("DOMContentLoaded", function () {

      const backButton = document.getElementById(
        "requirementsBackButton"
      );

      if (!backButton) return;

      /*
        The href already contains the correct category selection URL
        and its original returnTo parameter.

        Use that URL instead of blindly using browser history.
      */

      backButton.addEventListener("click", function (event) {
        event.preventDefault();

        window.location.href = backButton.getAttribute("href");
      });

    });
  </script>

</body>
</html>
