
<%
  const activeSelectedCategory =
    typeof selectedCategory !== "undefined" && selectedCategory
      ? selectedCategory
      : null;

  const activeSubCategories = Array.isArray(subCategories)
    ? subCategories.filter(sub => sub && sub.isActive !== false)
    : activeSelectedCategory &&
      Array.isArray(activeSelectedCategory.subCategories)
      ? activeSelectedCategory.subCategories.filter(
          sub => sub && sub.isActive !== false
        )
      : [];

  const categoryName = activeSelectedCategory
    ? activeSelectedCategory.name
    : "Visa";

  const pageHeading = `${country.name} ${categoryName} Requirements`;

  const categorySelectionUrl =
    `/countries/${encodeURIComponent(country.slug)}/visa-categories`;

  const categorySelectionBackUrl =
    typeof returnTo === "string" && returnTo.trim()
      ? returnTo.trim()
      : categorySelectionUrl;

  let flagImagePath = String(country.flag || "").trim();

  if (flagImagePath.startsWith("public/")) {
    flagImagePath = flagImagePath.replace(/^public/, "");
  } else if (
    flagImagePath &&
    !flagImagePath.startsWith("/") &&
    !/^https?:\/\//i.test(flagImagePath)
  ) {
    flagImagePath = "/" + flagImagePath;
  }

  const travelInfo =
    country.travelInfo && typeof country.travelInfo === "object"
      ? country.travelInfo
      : {};

  const travelTips = Array.isArray(country.travelTips)
    ? country.travelTips
    : [];

  const importantNotes = Array.isArray(country.importantNotes)
    ? country.importantNotes
    : [];

  const faqs = Array.isArray(country.faqs)
    ? country.faqs
    : [];

  const majorCities = Array.isArray(travelInfo.majorCities)
    ? travelInfo.majorCities
    : [];

  // COMMON COUNTRY INFORMATION
  const commonCountryImage = String(country.image || "").trim();

  let commonCountryImagePath = commonCountryImage;

  if (commonCountryImagePath.startsWith("public/")) {
    commonCountryImagePath =
      commonCountryImagePath.replace(/^public/, "");
  } else if (
    commonCountryImagePath &&
    !commonCountryImagePath.startsWith("/") &&
    !/^https?:\/\//i.test(commonCountryImagePath)
  ) {
    commonCountryImagePath = "/" + commonCountryImagePath;
  }

  const commonCountryBadge =
    typeof country.heroBadge === "string" && country.heroBadge.trim()
      ? country.heroBadge.trim()
      : "DESTINATION INFORMATION";

  const commonCountryShortDescription =
    typeof country.shortDescription === "string"
      ? country.shortDescription.trim()
      : "";

  const commonCountryDescription =
    typeof country.description === "string"
      ? country.description.trim()
      : "";
%>

<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">

  <title><%= pageHeading %> | VisaMaster</title>

  <meta
    name="description"
    content="Check <%= country.name %> <%= categoryName %> requirements, eligibility criteria and travel information with VisaMaster."
  >

  <link rel="stylesheet" href="/css/global.css">
  <link rel="stylesheet" href="/css/navbar.css">
  <link rel="stylesheet" href="/css/requirements.css">
  <link rel="stylesheet" href="/css/requirements-country-info.css">
  <link rel="stylesheet" href="/css/footer.css">
</head>

<body>

  <%- include("../partials/navbar") %>

  <main class="vmr-page">
    <div class="vmr-container">

      <!-- COUNTRY HEADER -->

      <header class="vmr-country-header">

        <a
          href="<%= categorySelectionBackUrl %>"
          class="vmr-back-link"
          id="requirementsBackButton"
        >
          <span aria-hidden="true">←</span>
          Back
        </a>

        <div class="vmr-country-identity">

          <div class="vmr-flag-box">

            <% if (flagImagePath) { %>

              <img
                src="<%= flagImagePath %>"
                alt="<%= country.name %> flag"
                class="vmr-country-flag"
                id="vmrCountryFlag"
              >

              <span
                class="vmr-flag-fallback"
                id="vmrFlagFallback"
                hidden
              >🌍</span>

            <% } else { %>

              <span class="vmr-flag-fallback">🌍</span>

            <% } %>

          </div>

          <div class="vmr-country-heading">

            <span class="vmr-eyebrow">
              <%= categoryName.toUpperCase() %> VISA INFORMATION
            </span>

            <h1><%= pageHeading %></h1>

          </div>

        </div>

      </header>

      <!-- VISA PURPOSE TABS AND DYNAMIC CONTENT -->

      <section class="vmr-visa-section">

        <% if (activeSelectedCategory) { %>

          <% if (activeSubCategories.length > 0) { %>

            <div class="vmr-section-heading">

              <span class="vmr-eyebrow">
                <%= country.name %>
              </span>

              <h2>Select Your Visa Purpose</h2>

              <p>
                Choose your purpose to view the relevant requirements
                and eligibility information.
              </p>

            </div>

            <!-- PURPOSE TABS -->

            <div class="visa-category-tabs-wrap">

              <div
                class="visa-category-tabs"
                role="tablist"
                aria-label="<%= activeSelectedCategory.name %> visa purposes"
              >

                <% activeSubCategories.forEach((sub, index) => { %>

                  <button
                    type="button"
                    class="visa-category-tab"
                    id="visa-tab-<%= index %>"
                    role="tab"
                    aria-controls="visa-panel-<%= index %>"
                    aria-selected="<%= index === 0 ? 'true' : 'false' %>"
                    tabindex="<%= index === 0 ? '0' : '-1' %>"
                    data-visa-tab="<%= index %>"
                    data-visa-slug="<%= sub.slug %>"
                  >

                    <span class="visa-category-tab-number">
                      <%= String(index + 1).padStart(2, "0") %>
                    </span>

                    <span class="visa-category-tab-name">
                      <%= sub.name %>
                    </span>

                  </button>

                <% }) %>

              </div>

              <p class="visa-category-slider-status" aria-live="polite">
                Showing purpose 1 of <%= activeSubCategories.length %>
              </p>

            </div>

            <!-- DYNAMIC REQUIREMENT PANELS -->

            <div class="visa-tab-panels">

              <% activeSubCategories.forEach((sub, index) => { %>

                <%
                  const requirementsList = Array.isArray(sub.requirements)
                    ? sub.requirements.filter(
                        item => typeof item === "string" && item.trim()
                      )
                    : typeof sub.requirements === "string"
                      ? sub.requirements.split(/\r?\n/).filter(
                          item => item.trim()
                        )
                      : [];

                  const eligibilityList = Array.isArray(sub.eligibility)
                    ? sub.eligibility.filter(
                        item => typeof item === "string" && item.trim()
                      )
                    : typeof sub.eligibility === "string"
                      ? sub.eligibility.split(/\r?\n/).filter(
                          item => item.trim()
                        )
                      : [];

                  const applicationForm =
                    sub.applicationForm &&
                    typeof sub.applicationForm === "object"
                      ? sub.applicationForm
                      : null;
                %>

                <section
                  class="visa-tab-panel"
                  id="visa-panel-<%= index %>"
                  role="tabpanel"
                  aria-labelledby="visa-tab-<%= index %>"
                  data-visa-panel="<%= index %>"
                  data-visa-slug="<%= sub.slug %>"
                  <%= index === 0 ? "" : "hidden" %>
                >

                  <article class="vmr-requirement-card">

                    <!-- REQUIREMENTS HEADER -->

                    <div class="vmr-card-heading">

                      <div>

                        <span class="vmr-eyebrow">
                          DOCUMENT CHECKLIST
                        </span>

                        <h3><%= sub.name %> Requirements</h3>

                        <% if (sub.purpose) { %>
                          <p><%= sub.purpose %></p>
                        <% } %>

                      </div>

                      <span class="vmr-category-badge">
                        <%= activeSelectedCategory.name %>
                      </span>

                    </div>

                    <div class="vmr-card-body">

                      <!-- REQUIRED DOCUMENTS -->

                      <section class="vmr-document-section">

                        <div class="vmr-content-heading">

                          <span class="vmr-content-icon">📄</span>

                          <div>
                            <h4>Required Documents</h4>

                            <p>
                              Documents required for this visa purpose.
                            </p>
                          </div>

                        </div>

                        <% if (requirementsList.length > 0) { %>

                          <ol class="vmr-document-list">

                            <% requirementsList.forEach((item, itemIndex) => { %>

                              <li>

                                <span class="vmr-list-number">
                                  <%= String(itemIndex + 1).padStart(2, "0") %>
                                </span>

                                <span><%= item %></span>

                              </li>

                            <% }) %>

                          </ol>

                        <% } else { %>

                          <div class="vmr-empty-message">
                            Requirements have not been added yet.
                            Please contact VisaMaster for assistance.
                          </div>

                        <% } %>

                      </section>

                      <!-- ELIGIBILITY -->

                      <section class="vmr-document-section vmr-eligibility-section">

                        <div class="vmr-content-heading">

                          <span class="vmr-content-icon vmr-check-icon">
                            ✓
                          </span>

                          <div>
                            <h4>Eligibility Criteria</h4>
                            <p>Check these conditions before applying.</p>
                          </div>

                        </div>

                        <% if (eligibilityList.length > 0) { %>

                          <ul class="vmr-eligibility-list">

                            <% eligibilityList.forEach(item => { %>

                              <li>
                                <span class="vmr-eligibility-check">✓</span>
                                <span><%= item %></span>
                              </li>

                            <% }) %>

                          </ul>

                        <% } else { %>

                          <div class="vmr-empty-message">
                            Eligibility information is not available.
                          </div>

                        <% } %>

                      </section>

                      <!-- VISA DESCRIPTION -->

                      <% if (sub.description) { %>

                        <section class="vmr-description-section">

                          <h4>About this Visa</h4>

                          <p><%= sub.description %></p>

                        </section>

                      <% } %>

                      <!-- OPTIONAL APPLICATION FORM -->

                      <% if (applicationForm && applicationForm.filename) { %>

                        <section class="vmr-pdf-section">

                          <div class="vmr-pdf-icon">PDF</div>

                          <div class="vmr-pdf-content">

                            <span class="vmr-eyebrow">
                              OFFICIAL DOCUMENT
                            </span>

                            <h4>Application Form</h4>

                            <p>
                              <%= applicationForm.filename %>
                            </p>

                            <div class="vmr-pdf-actions">

                              <a
                                href="/countries/<%= encodeURIComponent(country.slug) %>/application-form/<%= encodeURIComponent(activeSelectedCategory.slug) %>/<%= encodeURIComponent(sub.slug) %>"
                                target="_blank"
                                rel="noopener noreferrer"
                              >
                                View PDF
                              </a>

                              <a
                                href="/countries/<%= encodeURIComponent(country.slug) %>/application-form/<%= encodeURIComponent(activeSelectedCategory.slug) %>/<%= encodeURIComponent(sub.slug) %>/download"
                              >
                                Download PDF
                              </a>

                            </div>

                          </div>

                        </section>

                      <% } %>

                      <!-- ASSISTANCE -->

                      <div class="vmr-assistance">

                        <div>
                          <strong>Need help with your application?</strong>
                          <p>Our team is here to assist you.</p>
                        </div>

                        <a href="/contact">
                          Get Assistance →
                        </a>

                      </div>

                    </div>

                  </article>

                </section>

              <% }) %>

            </div>

          <% } else { %>

            <div class="vmr-empty-state">

              <h3>Requirements Coming Soon</h3>

              <p>
                No active visa purposes are currently available
                in this category.
              </p>

              <a href="/contact">Contact VisaMaster →</a>

            </div>

          <% } %>

        <% } else { %>

          <div class="vmr-empty-state">

            <h3>Visa Category Not Found</h3>

            <p>
              Please select an available visa category for
              <%= country.name %>.
            </p>

            <a href="<%= categorySelectionUrl %>">
              View Visa Categories →
            </a>

          </div>

        <% } %>

      </section>

      <!-- =====================================
           COMMON COUNTRY INFORMATION
           DOES NOT CHANGE WITH VISA TABS
      ====================================== -->

      <section class="vmr-country-details">

        <!-- DESTINATION INTRODUCTION -->

        <section
          class="vmr-common-intro"
          aria-label="<%= country.name %> destination overview"
        >

          <% if (commonCountryImagePath) { %>

            <div class="vmr-common-image-wrap">

              <img
                src="<%= commonCountryImagePath %>"
                alt="<%= country.name %> destination"
                class="vmr-common-image"
                loading="lazy"
              >

              <span
                class="vmr-common-image-overlay"
                aria-hidden="true"
              ></span>

            </div>

          <% } %>

          <div class="vmr-common-intro-content">

            <span class="vmr-common-badge">

              <span
                class="vmr-common-badge-dot"
                aria-hidden="true"
              ></span>

              <%= commonCountryBadge %>

            </span>

            <div class="vmr-common-title-row">

              <h3><%= country.name %></h3>

              <% if (country.countryCode) { %>

                <span class="vmr-common-country-code">
                  <%= country.countryCode %>
                </span>

              <% } %>

            </div>

            <% if (commonCountryShortDescription) { %>

              <p class="vmr-common-short-description">
                <%= commonCountryShortDescription %>
              </p>

            <% } %>

            <% if (commonCountryDescription) { %>

              <p class="vmr-common-description">
                <%= commonCountryDescription %>
              </p>

            <% } %>

          </div>

        </section>

        <!-- COUNTRY INFORMATION HEADING -->

        <div class="vmr-details-heading">

          <span class="vmr-eyebrow">
            EXPLORE THE DESTINATION
          </span>

          <h2>About <%= country.name %></h2>

          <p>
            Useful information to help you plan your journey.
          </p>

        </div>

        <!-- TRAVEL INFORMATION -->

        <section class="vmr-info-card">

          <h3>Travel Information</h3>

          <div class="vmr-info-grid">

            <% if (travelInfo.currency) { %>

              <div class="vmr-info-item">
                <span>Currency</span>
                <strong><%= travelInfo.currency %></strong>
              </div>

            <% } %>

            <% if (travelInfo.language) { %>

              <div class="vmr-info-item">
                <span>Language</span>
                <strong><%= travelInfo.language %></strong>
              </div>

            <% } %>

            <% if (travelInfo.timezone) { %>

              <div class="vmr-info-item">
                <span>Timezone</span>
                <strong><%= travelInfo.timezone %></strong>
              </div>

            <% } %>

            <% if (travelInfo.capital) { %>

              <div class="vmr-info-item">
                <span>Capital</span>
                <strong><%= travelInfo.capital %></strong>
              </div>

            <% } %>

          </div>

          <!-- MAJOR CITIES -->

          <% if (majorCities.length > 0) { %>

            <div class="vmr-sub-info">

              <h4>Major Cities</h4>

              <div class="vmr-city-list">

                <% majorCities.forEach(city => { %>

                  <span><%= city %></span>

                <% }) %>

              </div>

            </div>

          <% } %>

          <!-- AIRPORT INFORMATION -->

          <% if (travelInfo.airportInformation) { %>

            <div class="vmr-sub-info">

              <h4>Airport Information</h4>

              <p><%= travelInfo.airportInformation %></p>

            </div>

          <% } %>

        </section>

        <!-- TRAVEL TIPS -->

        <% if (travelTips.length > 0) { %>

          <section class="vmr-info-card">

            <h3>Travel Tips</h3>

            <ul class="vmr-guidance-list">

              <% travelTips.forEach(tip => { %>

                <li><%= tip %></li>

              <% }) %>

            </ul>

          </section>

        <% } %>

        <!-- IMPORTANT NOTES -->

        <% if (importantNotes.length > 0) { %>

          <section class="vmr-info-card vmr-important-card">

            <h3>Important Notes</h3>

            <ul class="vmr-guidance-list">

              <% importantNotes.forEach(note => { %>

                <li><%= note %></li>

              <% }) %>

            </ul>

          </section>

        <% } %>

        <!-- FREQUENTLY ASKED QUESTIONS -->

        <% if (faqs.length > 0) { %>

          <section class="vmr-info-card">

            <h3>Frequently Asked Questions</h3>

            <div class="vmr-faq-list">

              <% faqs.forEach(faq => { %>

                <% if (faq && faq.question && faq.answer) { %>

                  <details class="vmr-faq-item">

                    <summary>

                      <span><%= faq.question %></span>

                      <span class="vmr-faq-plus">+</span>

                    </summary>

                    <div class="vmr-faq-answer">
                      <%= faq.answer %>
                    </div>

                  </details>

                <% } %>

              <% }) %>

            </div>

          </section>

        <% } %>

      </section>

      <!-- GENERAL DISCLAIMER -->

      <div class="vmr-disclaimer">

        <span>ℹ️</span>

        <p>
          Visa requirements and immigration rules may change.
          Additional documents may be requested by the relevant authority.
          Always confirm the latest requirements before applying.
        </p>

      </div>

    </div>
  </main>

  <%- include("../partials/footer") %>

  <script src="/js/main.js" defer></script>
  <script src="/js/requirements.js" defer></script>

</body>
</html>
