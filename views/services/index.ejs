<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>Our Services | VisaMaster</title>

    <!-- Global + Page CSS -->
    <link rel="stylesheet" href="/css/global.css" />
    <link rel="stylesheet" href="/css/navbar.css" />
    <link rel="stylesheet" href="/css/services.css" />
    <link rel="stylesheet" href="/css/footer.css" />
  </head>

  <body>
    <!-- =========================
       NAVBAR
  ========================== -->

    <%- include("../partials/navbar") %>

    <main>
      <!-- =========================
         SERVICES HERO
    ========================== -->

      <section class="services-hero">
        <div class="services-container">
          <div class="services-hero-new">
            <!-- LEFT CONTENT -->

            <div class="services-hero-content">
              <div class="services-badge">🧳 Your Travel, Our Support</div>

              <h1>
                Your Journey.
                <span>We Handle the Rest.</span>
              </h1>

              <p>
                From choosing the right visa to preparing your documents,
                VisaMaster is here to make your travel preparation simple and
                stress-free.
              </p>

              <div class="services-hero-buttons">
                <a href="/destinations" class="services-primary-btn">
                  Find Your Visa
                  <span>→</span>
                </a>

                <a href="/contact" class="services-secondary-btn">
                  Talk to Us
                  <span>💬</span>
                </a>
              </div>

              <div class="services-mini-points">
                <span>✓ Visa Guidance</span>
                <span>✓ Document Support</span>
                <span>✓ Travel Assistance</span>
              </div>
            </div>

            <!-- RIGHT ILLUSTRATION -->

            <div class="services-new-visual">
              <!-- Route -->

              <div class="travel-route">~ ~ ~ ~ ~ ~ ~</div>

              <!-- Main Travel Folder -->

              <div class="visa-folder">
                <div class="folder-top">
                  <span>VISAMASTER</span>
                  <span>✈️</span>
                </div>

                <div class="folder-title">
                  YOUR
                  <strong>TRAVEL PLAN</strong>
                </div>

                <div class="folder-lines">
                  <span></span>
                  <span></span>
                  <span></span>
                </div>

                <div class="folder-stamp">✓</div>
              </div>

              <!-- Floating Passport -->

              <div class="floating-passport">🛂</div>

              <!-- Floating Ticket -->

              <div class="floating-ticket">
                <div>✈️</div>

                <span> BOARDING </span>
              </div>

              <!-- Floating Suitcase -->

              <div class="floating-suitcase">🧳</div>

              <!-- Floating Document -->

              <div class="floating-document">
                <div class="document-check">✓</div>

                <div class="document-lines">
                  <span></span>
                  <span></span>
                  <span></span>
                </div>
              </div>

              <!-- Doodles -->

              <div class="service-doodle doodle-one">✦</div>

              <div class="service-doodle doodle-two">✧</div>

              <div class="service-doodle doodle-three">+</div>
            </div>
          </div>
        </div>
      </section>

      <!-- =========================
         SERVICES INTRO
    ========================== -->

      <section class="services-intro">
        <div class="services-container">
          <div class="services-heading">
            <div class="services-label">✈️ WHAT WE DO</div>

            <h2>
              Your Journey,
              <span>Our Support.</span>
            </h2>

            <p>
              We provide travel and visa assistance designed to make your
              international journey easier, clearer and more organised.
            </p>
          </div>
        </div>
      </section>

      <!-- =========================
         MAIN SERVICES
    ========================== -->

      <section class="services-list">
        <div class="services-container">
          <div class="service-cards">
            <!-- SERVICE 1 -->

            <div class="service-card service-card-orange">
              <div class="service-card-top">
                <div class="service-icon">🛂</div>

                <span class="service-number"> 01 </span>
              </div>

              <h3>Visa Processing</h3>

              <p>
                Get assistance with your visa application process, documentation
                and requirements.
              </p>

              <a href="/contact" class="service-link">
                Learn More
                <span>→</span>
              </a>
            </div>

            <!-- SERVICE 2 -->

            <div class="service-card service-card-green">
              <div class="service-card-top">
                <div class="service-icon">🌴</div>

                <span class="service-number"> 02 </span>
              </div>

              <h3>Tourist Visa</h3>

              <p>
                Planning a holiday abroad? Get guidance for your tourist visa
                application.
              </p>

              <a href="/contact" class="service-link">
                Plan Your Trip
                <span>→</span>
              </a>
            </div>

            <!-- SERVICE 3 -->

            <div class="service-card service-card-yellow">
              <div class="service-card-top">
                <div class="service-icon">💼</div>

                <span class="service-number"> 03 </span>
              </div>

              <h3>Business Visa</h3>

              <p>
                Support for business travellers attending meetings, conferences
                and professional events.
              </p>

              <a href="/contact" class="service-link">
                Get Guidance
                <span>→</span>
              </a>
            </div>

            <!-- SERVICE 4 -->

            <div class="service-card service-card-purple">
              <div class="service-card-top">
                <div class="service-icon">🎓</div>

                <span class="service-number"> 04 </span>
              </div>

              <h3>Student Visa</h3>

              <p>
                Planning to study abroad? Get help understanding the visa
                process and documents.
              </p>

              <a href="/contact" class="service-link">
                Start Planning
                <span>→</span>
              </a>
            </div>

            <!-- SERVICE 5 -->

            <div class="service-card service-card-blue">
              <div class="service-card-top">
                <div class="service-icon">👨‍👩‍👧</div>

                <span class="service-number"> 05 </span>
              </div>

              <h3>Family & Visit Visa</h3>

              <p>
                Make visiting family and loved ones easier with proper visa
                guidance and support.
              </p>

              <a href="/contact" class="service-link">
                Know More
                <span>→</span>
              </a>
            </div>

            <!-- SERVICE 6 -->

            <div class="service-card service-card-pink">
              <div class="service-card-top">
                <div class="service-icon">📑</div>

                <span class="service-number"> 06 </span>
              </div>

              <h3>Documentation Support</h3>

              <p>
                Understand the documents required for your visa application and
                prepare confidently.
              </p>

              <a href="/contact" class="service-link">
                Get Support
                <span>→</span>
              </a>
            </div>

            <!-- SERVICE 7 -->

            <div class="service-card service-card-teal">
              <div class="service-card-top">
                <div class="service-icon">✈️</div>

                <span class="service-number"> 07 </span>
              </div>

              <h3>Travel Assistance</h3>

              <p>
                Get helpful travel guidance while preparing for your
                international journey.
              </p>

              <a href="/contact" class="service-link">
                Talk to Us
                <span>→</span>
              </a>
            </div>

            <!-- SERVICE 8 -->

            <div class="service-card service-card-red">
              <div class="service-card-top">
                <div class="service-icon">💬</div>

                <span class="service-number"> 08 </span>
              </div>

              <h3>Visa Consultation</h3>

              <p>
                Not sure which visa you need? Speak with our team and understand
                your options.
              </p>

              <a href="/contact" class="service-link">
                Talk to an Expert
                <span>→</span>
              </a>
            </div>
          </div>
        </div>
      </section>

      <!-- =========================
         HOW IT WORKS
    ========================== -->

      <section class="services-process">
        <div class="services-container">
          <div class="services-heading">
            <div class="services-label">🧭 HOW IT WORKS</div>

            <h2>
              Simple Steps.
              <span>Smooth Journey.</span>
            </h2>

            <p>Getting started doesn't have to be complicated.</p>
          </div>

          <div class="process-grid">
            <!-- STEP 1 -->

            <div class="process-card">
              <div class="process-number">01</div>

              <div class="process-icon">🔍</div>

              <h3>Choose Your Visa</h3>

              <p>
                Find the destination and visa category that matches your travel
                purpose.
              </p>
            </div>

            <!-- STEP 2 -->

            <div class="process-card">
              <div class="process-number">02</div>

              <div class="process-icon">📄</div>

              <h3>Prepare Documents</h3>

              <p>
                Understand the required documents and prepare your application.
              </p>
            </div>

            <!-- STEP 3 -->

            <div class="process-card">
              <div class="process-number">03</div>

              <div class="process-icon">📨</div>

              <h3>Submit Application</h3>

              <p>
                Move forward with your application with the required
                information.
              </p>
            </div>

            <!-- STEP 4 -->

            <div class="process-card">
              <div class="process-number">04</div>

              <div class="process-icon">✈️</div>

              <h3>Get Ready To Travel</h3>

              <p>
                Once your visa journey is complete, it's time to prepare for
                your trip.
              </p>
            </div>
          </div>
        </div>
      </section>

      <!-- =========================
         CTA
    ========================== -->

      <section class="services-cta">
        <div class="services-container">
          <div class="services-cta-card">
            <div class="services-cta-plane">✈️</div>

            <div class="services-cta-globe">🌍</div>

            <div class="services-cta-content">
              <div class="services-label">🌎 YOUR JOURNEY STARTS HERE</div>

              <h2>
                Got A Destination
                <span>In Mind?</span>
              </h2>

              <p>
                Tell us where you're planning to go and let's figure out the
                next step together.
              </p>

              <div class="services-cta-buttons">
                <a href="/destinations" class="services-primary-btn">
                  Explore Destinations
                  <span>→</span>
                </a>

                <a href="/contact" class="services-secondary-btn">
                  Get Started
                  <span>💬</span>
                </a>
              </div>
            </div>
          </div>
        </div>
      </section>
    </main>

    <!-- =========================
       FOOTER
  ========================== -->

    <%- include("../partials/footer") %>

    <script src="/js/main.js"></script>
  </body>
</html>
